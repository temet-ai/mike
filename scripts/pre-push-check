#!/usr/bin/env bash
# The pre-push hook. Refuses a direct push of Rust or frontend to main, since
# those land through a pull request. Otherwise runs, for what the push changed:
# a secret scan, SAST, Rust lint with the fast and changed-area tests, the
# frontend typecheck and unit tests, and cargo-deny when the lockfile changed.
# Fleet pushes skip it: they have a 20 second limit and their own gates.
set -uo pipefail
if [ -n "${MIKE_SEAT:-}" ]; then
  cat >/dev/null
  exit 0
fi
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

none=0000000000000000000000000000000000000000
pr_only='^(crates/|frontend/|\.sqlx/|Cargo\.(toml|lock)$)'
changed=""
ranges=""
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$none" ] && continue
  if [ "$remote_sha" = "$none" ]; then
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  ranges="$ranges $range"
  paths=$(git diff --name-only --no-renames "$range" 2>/dev/null)
  changed="$changed
$paths"
  if [ "$remote_ref" = refs/heads/main ] && printf '%s\n' "$paths" | grep -qE "$pr_only"; then
    echo "pre-push: Rust and frontend changes land through a pull request; push a branch" >&2
    exit 1
  fi
done

for range in $ranges; do
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" . >/dev/null 2>&1 || {
      echo "pre-push: gitleaks found a secret in $range; run: gitleaks git --redact --log-opts=$range ." >&2
      status=1
    }
  fi
done

semgrep_bin=$(command -v semgrep || echo "$HOME/.local/bin/semgrep")
scan_files=()
while IFS= read -r file; do
  [ -f "$file" ] && scan_files+=("$file")
done <<<"$(printf '%s\n' "$changed" | grep -E '\.(rs|ts|js|mjs)$' | grep -vE '(^|/)tests/|_tests?\.rs$|(^|/)test_support/|\.test\.(ts|js|mjs)$' | sort -u)"
if [ -x "$semgrep_bin" ] && [ "${#scan_files[@]}" -gt 0 ]; then
  (
    ulimit -s unlimited 2>/dev/null
    # semgrep-core's default io_uring backend fails with ENOMEM under a busy build.
    EIO_BACKEND=posix "$semgrep_bin" scan --metrics off --error --quiet \
      --config p/rust --config p/javascript --config p/typescript "${scan_files[@]}"
  ) || {
    echo "pre-push: semgrep found a problem in the changed files" >&2
    status=1
  }
fi

if printf '%s\n' "$changed" | grep -qE '^scripts/(pre-push-check|test-area|lib/rust_change_scope.py|tests/test_rust_change_scope.py)$'; then
  python3 -m unittest discover -s "$root/scripts/tests" -p test_rust_change_scope.py || status=1
fi

if printf '%s\n' "$changed" | grep -qE '\.(rs|sql)$|(^|/)Cargo\.toml$|^Cargo\.lock$|^\.sqlx/|^\.cargo/|^rust-toolchain(\.toml)?$'; then
  # GitHub Actions has no minutes, so this hook is the only lint and test a Rust push gets:
  # a fresh checkout builds here too. The Pi (aarch64 Linux) must not build; push from omit or the Mac.
  if [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = aarch64 ]; then
    echo "pre-push: Rust changes are linted and tested by this hook; push them from omit or the Mac, not this Pi" >&2
    exit 1
  fi
  [ -d "$root/target" ] || echo "pre-push: no target/ in this checkout; building it to lint and test this push"
  "$root/scripts/cx" fmt --check >/dev/null 2>&1 || {
    echo "pre-push: cargo fmt --check failed; run make fmt" >&2
    status=1
  }
  # The push already fails; skip the long lint and tests so the fix is pushed sooner.
  if [ "$status" -ne 0 ]; then
    echo "pre-push: fix the failures above; lint-rust and the tests did not run" >&2
    exit 1
  fi
  packages=$(python3 "$root/scripts/lib/rust_change_scope.py" packages <<<"$changed") || exit 1
  # shellcheck disable=SC2086
  "$root/scripts/lint-rust" $packages || status=1
  # The tests of the areas the push changed, in every tier. A change no area owns
  # (the workspace manifest or lockfile, a crate manifest, .sqlx, a file outside
  # every crate) runs the affected crates' whole fast tier instead; the rest of the
  # fast tier runs nightly (scripts/nightly-tests).
  "$root/scripts/test-area" || status=1
fi

if printf '%s\n' "$changed" | grep -qE '^frontend/' && [ -d "$root/frontend/node_modules" ]; then
  (cd "$root/frontend" && ../scripts/sb-test --unit) || status=1
fi

if printf '%s\n' "$changed" | grep -qE '^Cargo\.lock$|^deny\.toml$' && command -v cargo-deny >/dev/null 2>&1; then
  cargo deny check || status=1
fi

exit "$status"
