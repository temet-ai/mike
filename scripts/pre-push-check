#!/usr/bin/env bash
# The pre-push hook. Compiles nothing and runs no tests, so a push takes seconds: a secret
# scan, SAST on what the push adds, the crate-split and schema-ownership ratchets, and the
# file-reading Rust lint checks. Clippy and every test tier run nightly on main
# (scripts/nightly-tests). Fleet pushes skip it.
set -uo pipefail
if [ -n "${MIKE_SEAT:-}" ]; then
  cat >/dev/null
  exit 0
fi
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

none=0000000000000000000000000000000000000000
changed=""
ranges=""
status=0
failed=""
fail() {
  status=1
  failed="$failed $1"
}
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$none" ] && continue
  if [ "$remote_sha" = "$none" ]; then
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  ranges="$ranges $range"
  changed="$changed
$(git diff --name-only --no-renames "$range" 2>/dev/null)"
done

for range in $ranges; do
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" . >/dev/null 2>&1 || {
      echo "pre-push: gitleaks found a secret in $range; run: gitleaks git --redact --log-opts=$range ." >&2
      fail gitleaks
    }
  fi
done

# semgrep-new comes from the checkout this hook file lives in, so a branch cut before a
# semgrep-new change still scans. Only findings the range adds fail it.
hook_dir=$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")
for range in $ranges; do
  python3 "$hook_dir/semgrep-new" "$range" || {
    echo "pre-push: semgrep failed for $range (see above); rerun: scripts/semgrep-new $range" >&2
    fail semgrep
  }
done

if grep -qE '\.(rs|sql)$|(^|/)Cargo\.toml$' <<<"$changed"; then
  "$root/scripts/crate-plan" --check || fail crate-plan
  "$root/scripts/schema-plan" --check || fail schema-plan
  for check in lint-rust-suppressions lint-rust-architecture lint-rust-log-fields; do
    "$root/scripts/$check" || fail "$check"
  done
fi

[ "$status" -eq 0 ] || echo "pre-push: FAILED:$failed" >&2
exit "$status"
