#!/usr/bin/env bash
# The pre-push hook. Refuses a direct push of Rust or frontend to main, since
# those land through a pull request. Otherwise runs, for what the push changed:
# a secret scan, SAST, Rust lint with the fast and changed-area tests, the
# frontend typecheck and unit tests, and cargo-deny when the lockfile changed.
# Fleet pushes skip it: they have a 20 second limit and their own gates.
set -uo pipefail
if [ -n "${MIKE_SEAT:-}" ]; then
  cat >/dev/null
  exit 0
fi
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

none=0000000000000000000000000000000000000000
pr_only='^(crates/|frontend/|\.sqlx/|Cargo\.(toml|lock)$)'
changed=""
ranges=""
status=0
failed=""
fail() {
  status=1
  failed="$failed $1"
}
summary() {
  [ "$status" -eq 0 ] || echo "pre-push: FAILED:$failed" >&2
}
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$none" ] && continue
  if [ "$remote_sha" = "$none" ]; then
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  ranges="$ranges $range"
  paths=$(git diff --name-only --no-renames "$range" 2>/dev/null)
  changed="$changed
$paths"
  if [ "$remote_ref" = refs/heads/main ] && grep -qE "$pr_only" <<<"$paths"; then
    echo "pre-push: Rust and frontend changes land through a pull request; push a branch" >&2
    exit 1
  fi
done

for range in $ranges; do
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" . >/dev/null 2>&1 || {
      echo "pre-push: gitleaks found a secret in $range; run: gitleaks git --redact --log-opts=$range ." >&2
      fail gitleaks
    }
  fi
done

# semgrep-new and its rules come from the checkout this hook file lives in, not the
# pushing worktree, so a branch cut before a semgrep-new change still scans.
hook_dir=$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")
# SAST on what each pushed range commits, with .semgrep/rules.yml; only findings
# the range adds fail it, so files a crate move touches keep their old findings.
for range in $ranges; do
  python3 "$hook_dir/semgrep-new" "$range" || {
    echo "pre-push: semgrep failed for $range (see above); rerun: scripts/semgrep-new $range" >&2
    fail semgrep
  }
done

# Wiring: code the range adds that nothing calls, registers, spawns, reads or consumes.
# A pub fn with no caller fails the push (7 of 7 findings real, 2026-11-17); the other
# kinds report only (route_unconsumed: 7 of 9 false, paths built from a BASE constant
# and consumers outside the repo). wiring-new skips with one line when no mike binary
# here has `structural wiring`.
if [ -x "$hook_dir/wiring-new" ] && grep -qE '^(crates/|frontend/src/|scripts/|mods/|services/|\.mike/)' <<<"$changed"; then
  for range in $ranges; do
    WIRING_BLOCK=pub_fn_no_caller "$hook_dir/wiring-new" "$range" >&2 || fail wiring
  done
fi

if grep -qE '^scripts/(pre-push-check|test-area|lib/rust_change_scope.py|tests/test_rust_change_scope.py)$' <<<"$changed"; then
  python3 -m unittest discover -s "$root/scripts/tests" -p test_rust_change_scope.py || fail rust_change_scope-tests
fi

if grep -qE '\.(rs|sql)$|(^|/)Cargo\.toml$|^Cargo\.lock$|^\.sqlx/|^\.cargo/|^rust-toolchain(\.toml)?$' <<<"$changed"; then
  # GitHub Actions has no minutes, so this hook is the only lint and test a Rust push gets:
  # a fresh checkout builds here too. On the Pi (aarch64 Linux, which also serves the house)
  # the build and tests run on two processors, and the test database is started for this
  # push and stopped again when the hook started it.
  if [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = aarch64 ]; then
    export MIKE_BUILD_JOBS="${MIKE_BUILD_JOBS:-2}" NEXTEST_TEST_THREADS="${NEXTEST_TEST_THREADS:-2}"
    if command -v docker >/dev/null 2>&1; then
      # Pushes can overlap (a session's and Wright's repair gate): each registers here, and the
      # last one out stops the database, and only when a hook started it.
      users="${XDG_CACHE_HOME:-$HOME/.cache}/mike-test-pg-users"
      mkdir -p "$users" && : >"$users/$$"
      release_test_db() {
        rm -f "$users/$$"
        for pidfile in "$users"/*; do
          [ -e "$pidfile" ] || continue
          kill -0 "${pidfile##*/}" 2>/dev/null && return 0
          rm -f "$pidfile"
        done
        [ -e "$users/.hook-started" ] && rm -f "$users/.hook-started" && docker stop mike-test-pg >/dev/null 2>&1
        return 0
      }
      trap release_test_db EXIT
      running=$(docker inspect -f '{{.State.Running}}' mike-test-pg 2>/dev/null)
      if [ "$running" = false ]; then
        docker start mike-test-pg >/dev/null && : >"$users/.hook-started"
      elif [ -z "$running" ]; then
        "$root/scripts/test-db/up.sh" >/dev/null && : >"$users/.hook-started"
      fi
      for _ in $(seq 1 60); do
        docker exec mike-test-pg pg_isready -U postgres -d postgres >/dev/null 2>&1 && break
        sleep 1
      done
    fi
  fi
  [ -d "$root/target" ] || echo "pre-push: no target/ in this checkout; building it to lint and test this push"
  "$root/scripts/cx" fmt --check >/dev/null 2>&1 || {
    echo "pre-push: cargo fmt --check failed; run make fmt" >&2
    fail fmt
  }
  # The crate split (ADR 0002, 0003) only moves forward: no push adds references
  # from a lower target crate to a higher one, or writes to a table another crate
  # owns. A second each; they read the source, not the build.
  "$root/scripts/crate-plan" --check || fail crate-plan
  "$root/scripts/schema-plan" --check || fail schema-plan
  # The push already fails; skip the long lint and tests so the fix is pushed sooner.
  if [ "$status" -ne 0 ]; then
    echo "pre-push: fix the failures above; lint-rust and the tests did not run" >&2
    summary
    exit 1
  fi
  # Clippy runs on the crates whose files changed. The crates that depend on them get
  # a plain build of their library and binaries: their source did not change, so it has
  # nothing new to lint, and the build still catches a lower crate's change that breaks them.
  packages=$(python3 "$root/scripts/lib/rust_change_scope.py" packages <<<"$changed") || exit 1
  dependents=$(python3 "$root/scripts/lib/rust_change_scope.py" dependents <<<"$changed") || exit 1
  # shellcheck disable=SC2086
  [ -z "$packages" ] || "$root/scripts/lint-rust" $packages || fail lint-rust
  # shellcheck disable=SC2086
  [ -z "$dependents" ] || "$root/scripts/cx" check $dependents || fail dependents-check
  # The tests of the areas the push changed, in every tier. A change no area owns
  # (the workspace manifest or lockfile, a crate manifest, .sqlx, a file outside
  # every crate) runs the affected crates' whole fast tier instead; the rest of the
  # fast tier runs nightly (scripts/nightly-tests). A lint or build failure already
  # fails the push, so the tests are skipped and the fix goes up sooner.
  if [ "$status" -ne 0 ]; then
    echo "pre-push: lint or build failed; the tests did not run" >&2
  else
    "$root/scripts/test-area" || fail test-area
  fi
fi

if grep -qE '^frontend/' <<<"$changed" && [ -d "$root/frontend/node_modules" ]; then
  (cd "$root/frontend" && ../scripts/sb-test --unit) || fail sb-test
fi

if grep -qE '^Cargo\.lock$|^deny\.toml$' <<<"$changed" && command -v cargo-deny >/dev/null 2>&1; then
  cargo deny check || fail cargo-deny
fi

summary
exit "$status"
