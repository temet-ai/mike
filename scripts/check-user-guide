#!/usr/bin/env bash
# scripts/check-user-guide [--complete] [file...]
#
# Checks the public user guide in docs/user-guide/ against the rules of the site's renderer
# (the list below). With no files it checks every page
# of the guide that exists. It prints every failure as `file:line: reason`, then exits 1.
# It changes no file. Without --complete it passes while pages are still being written.
#
#   - exactly one `# ` title, and no `## ` text repeated within a page
#   - a page is at the top of the folder or in one subfolder (fleets/); its name in the map
#     and in every message is its path from the guide folder, such as `fleets/README.md`
#   - links are relative file links, `name.md` or `name.md#anchor`, read from the linking
#     page's own folder (`../sessions.md` from fleets/, `fleets/README.md` from the top), and
#     must reach a page in the map; the anchor must be a heading of that page (slugified, no
#     de-duplication) when the page exists
#   - images resolve to `images/name.png` or `images/name.svg` (`../images/name.png` from
#     fleets/); images/ holds PNG and SVG files only
#   - no frontmatter, raw HTML, HTML comments or footnotes
#   - no private word (the list scripts/private-words-check reads: $MIKE_PRIVATE_WORDS, else
#     ~/.config/mike-dev/private-words.txt), no non-loopback IPv4 address, no /home/ or /Users/ path
#   --complete  also: every page of the map exists, nothing else is in the folder (a subfolder
#               holds its map pages only), and every embedded image exists
#
# $GUIDE_DIR overrides the folder (the test uses it).
# Exit: 0 clean, 1 failures, 2 usage.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="${GUIDE_DIR:-$ROOT/docs/user-guide}"
MAP="README.md quickstart.md install.md setup.md pages.md web-ui.md reading-sessions.md projects.md flagged-responses.md prompts-and-agents.md terminal.md memory.md steering.md judge.md filters.md compression.md mcp.md sessions.md codex.md fleets/README.md fleets/first-fleet.md fleets/definition.md fleets/how-a-fleet-runs.md fleets/working-together.md fleets/shared-checkout.md fleets/acceptance.md fleets/watch-and-recover.md fleets/after-a-run.md threads.md mods.md command-line.md settings.md privacy.md backup-and-recovery.md troubleshooting.md"

complete=0
files=()
for a in "$@"; do
    case "$a" in
        --complete) complete=1 ;;
        -h|--help) sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "usage: scripts/check-user-guide [--complete] [file...]" >&2; exit 2 ;;
        *) files+=("$a") ;;
    esac
done

[[ -d "$DIR" ]] || { echo "check-user-guide: no folder $DIR" >&2; exit 2; }

in_map() { local p; for p in $MAP; do [[ "$p" == "$1" ]] && return 0; done; return 1; }

tmp="$(mktemp -d "${TMPDIR:-/tmp}/check-user-guide.XXXXXX")" || exit 2
trap 'rm -rf "$tmp"' EXIT
fails="$tmp/fails"
: > "$fails"
fail() { printf '%s\n' "$1" >> "$fails"; }

# Slug of a heading text, as the site makes it: lower case, markup dropped, spaces to hyphens.
SLUGFN='
function slug(h,   s) {
    s = tolower(h)
    gsub(/`/, "", s); gsub(/\*/, "", s)
    while (match(s, /\[[^]]*\]\([^)]*\)/)) {
        t = substr(s, RSTART, RLENGTH); sub(/\]\(.*$/, "", t); sub(/^\[/, "", t)
        s = substr(s, 1, RSTART - 1) t substr(s, RSTART + RLENGTH)
    }
    gsub(/[^a-z0-9 _-]/, "", s)
    gsub(/ /, "-", s)
    return s
}
# Path from the guide folder of a relative link REL on the page FROM, or "" when the link is
# absolute or climbs out of the guide folder.
function resolve(from, rel,   d, n, i, k, parts, stk, out) {
    if (rel ~ /^\//) return ""
    d = from; sub(/[^\/]*$/, "", d)
    n = split(d rel, parts, "/"); k = 0; split("", stk)
    for (i = 1; i <= n; i++) {
        if (parts[i] == "" || parts[i] == ".") continue
        if (parts[i] == "..") { if (k == 0) return ""; k--; continue }
        stk[++k] = parts[i]
    }
    out = ""; for (i = 1; i <= k; i++) out = out (i > 1 ? "/" : "") stk[i]
    return out
}'

# Headings of every page that exists: "page<TAB>slug".
slugs="$tmp/slugs"
: > "$slugs"
for p in $MAP; do
    [[ -f "$DIR/$p" ]] || continue
    awk -v P="$p" "$SLUGFN"'
        /^[ \t]*(```|~~~)/ { f = !f; next }
        f { next }
        /^#+ / { h = $0; sub(/^#+ +/, "", h); sub(/[ \t#]+$/, "", h); printf "%s\t%s\n", P, slug(h) }
    ' "$DIR/$p" >> "$slugs"
done

# Which pages to check.
targets=()
if ((${#files[@]})); then
    realdir="$(cd "$DIR" && pwd -P)"
    for f in "${files[@]}"; do
        # A bare name, or a path from the guide folder such as fleets/README.md, is read there.
        if [[ "$f" != */* ]] || { [[ "$f" != /* && ! -f "$f" && -f "$DIR/$f" ]]; }; then f="$DIR/$f"; fi
        if [[ ! -f "$f" ]]; then fail "$f:1: no such file"; continue; fi
        fdir="$(cd "$(dirname "$f")" && pwd -P)"
        if [[ "$fdir" != "$realdir" && "$fdir" != "$realdir"/* ]]; then fail "$f:1: not in the guide folder"; continue; fi
        rel="${fdir#"$realdir"}"; rel="${rel#/}"; rel="${rel:+$rel/}$(basename "$f")"
        if ! in_map "$rel"; then fail "$f:1: not a page of the map"; continue; fi
        targets+=("$f")
    done
else
    for p in $MAP; do [[ -f "$DIR/$p" ]] && targets+=("$DIR/$p"); done
fi

# Private words: same list and resolution as scripts/private-words-check.
words="${MIKE_PRIVATE_WORDS:-$HOME/.config/mike-dev/private-words.txt}"
patterns="$tmp/patterns"
: > "$patterns"
[[ -s "$words" ]] && { grep -v -E '^[[:space:]]*(#|$)' "$words" > "$patterns" || true; }
if [[ ! -s "$patterns" ]]; then
    echo "check-user-guide: no private word list at $words; private words not checked" >&2
fi

realdir="$(cd "$DIR" && pwd -P)"
for f in ${targets[@]+"${targets[@]}"}; do
    # The page's path from the guide folder: README.md, fleets/README.md.
    fdir="$(cd "$(dirname "$f")" && pwd -P)"; name="${fdir#"$realdir"}"; name="${name#/}"
    name="${name:+$name/}$(basename "$f")"
    awk -v F="$name" -v SLUGS="$slugs" -v MAP="$MAP" -v COMPLETE="$complete" -v IMGDIR="$DIR" "$SLUGFN"'
    function err(msg) { printf "%s:%d: %s\n", F, FNR, msg }
    BEGIN {
        n = split(MAP, m, " "); for (i = 1; i <= n; i++) inmap[m[i]] = 1
        while ((getline l < SLUGS) > 0) { split(l, p, "\t"); have[p[1] SUBSEP p[2]] = 1; page[p[1]] = 1 }
    }
    FNR == 1 && /^---[ \t]*$/ { err("frontmatter; the site takes none") }
    /^[ \t]*(```|~~~)/ { fence = !fence; next }
    fence { next }
    /^# / { titles++; if (titles > 1) err("a second `# ` title; a page has exactly one") }
    /^## / {
        h = $0; sub(/^## +/, "", h); sub(/[ \t#]+$/, "", h)
        if (h in seen) err("repeated `## " h "` (first at line " seen[h] ")"); else seen[h] = FNR
    }
    {
        s = $0
        gsub(/`[^`]*`/, "", s)
        if (index(s, "<!--")) err("HTML comment")
        t = s
        while (match(t, "<[A-Za-z/!][^>]*>")) {
            tag = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
            if (tag !~ /^<(https?|mailto):/ && tag !~ /^<!--/) err("raw HTML " tag)
        }
        if (match(s, /\[\^[^]]+\]/)) err("footnote " substr(s, RSTART, RLENGTH))
        t = s
        while (match(t, /!?\[[^]]*\]\([^)]*\)/)) {
            mm = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
            img = (substr(mm, 1, 1) == "!")
            tg = mm; sub(/^!?\[[^]]*\]\(/, "", tg); sub(/\)$/, "", tg); sub(/[ \t].*$/, "", tg)
            if (tg ~ /^(https?:|mailto:)/) continue
            if (img) {
                ri = resolve(F, tg)
                if (ri !~ "^images/[^/]+[.](png|svg)$") {
                    err("image " tg " is not images/<name>.png or .svg" (index(F, "/") ? " (../images/<name>.png from a subfolder)" : ""))
                    continue
                }
                if (COMPLETE == 1) {
                    path = IMGDIR "/" ri
                    if ((getline junk < path) < 0) err("image " tg " does not exist")
                    close(path)
                }
                continue
            }
            file = tg; anchor = ""
            if (index(tg, "#")) { file = substr(tg, 1, index(tg, "#") - 1); anchor = substr(tg, index(tg, "#") + 1) }
            if (file == "") file = F
            else {
                file = resolve(F, file)
                if (!(file in inmap)) { err("link " tg " is not to a page of the map"); continue }
            }
            if (anchor != "" && (file in page) && !((file SUBSEP anchor) in have))
                err("anchor #" anchor " is not a heading of " file)
        }
        r = $0
        while (match(r, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) {
            ip = substr(r, RSTART, RLENGTH); r = substr(r, RSTART + RLENGTH)
            split(ip, o, "."); if (o[1] > 255 || o[2] > 255 || o[3] > 255 || o[4] > 255) continue
            if (o[1] == 127 || ip == "0.0.0.0") continue
            err("IP address " ip)
        }
        if (match($0, "/(home|Users)/[A-Za-z0-9_.-]+")) err("machine path " substr($0, RSTART, RLENGTH))
    }
    END { if (titles == 0) printf "%s:1: 0 `# ` titles; a page has exactly one\n", F }
    ' "$f" >> "$fails"
    if [[ -s "$patterns" ]]; then
        grep -n -o -i -E -f "$patterns" "$f" | while IFS=: read -r ln hit; do
            fail "$name:$ln: private word \"$hit\""
        done
        if printf '%s\n' "$name" | grep -q -i -E -f "$patterns"; then fail "$name:1: private word in the file name"; fi
    fi
done

# images/ holds PNG and SVG files only.
if [[ -d "$DIR/images" ]]; then
    for im in "$DIR"/images/* "$DIR"/images/.[!.]*; do
        [[ -e "$im" ]] || continue
        b="images/$(basename "$im")"
        if [[ -f "$im" && "$im" == *.svg ]]; then
            head -c 512 "$im" | grep -q '<svg' || fail "$b:1: not an SVG file"
        elif [[ -f "$im" && "$im" == *.png ]]; then
            sig="$(head -c 8 "$im" | od -An -tx1 | tr -d ' \n')"
            [[ "$sig" == 89504e470d0a1a0a ]] || fail "$b:1: not a PNG file"
        else
            fail "$b:1: images/ holds PNG and SVG files only"; continue
        fi
        if [[ -s "$patterns" ]] && printf '%s\n' "$b" | grep -q -i -E -f "$patterns"; then fail "$b:1: private word in the file name"; fi
    done
fi

if ((complete)); then
    for p in $MAP; do [[ -f "$DIR/$p" ]] || fail "$p:1: missing; the map requires this page"; done
    for e in "$DIR"/* "$DIR"/.[!.]*; do
        [[ -e "$e" ]] || continue
        b="$(basename "$e")"
        [[ "$b" == images ]] && continue
        if [[ -d "$e" ]] && [[ " $MAP" == *" $b/"* ]]; then
            # A subfolder of the map holds its map pages and nothing else.
            for s in "$e"/* "$e"/.[!.]*; do
                [[ -e "$s" ]] || continue
                [[ -f "$s" ]] && in_map "$b/$(basename "$s")" || fail "$b/$(basename "$s"):1: not in the page map"
            done
            continue
        fi
        [[ -f "$e" ]] && in_map "$b" || fail "$b:1: not in the page map"
    done
fi

if [[ -s "$fails" ]]; then
    sort -t: -k1,1 -k2,2n "$fails"
    echo "check-user-guide: $(wc -l < "$fails" | tr -d ' ') failure(s)" >&2
    exit 1
fi
echo "check-user-guide: ${#targets[@]} page(s) clean"
