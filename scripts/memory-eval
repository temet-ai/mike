#!/usr/bin/env bash
# Scores knowledge search against the memory-keeper evaluation sets (P9).
#
#   scripts/memory-eval [--data DIR] [--limit N] [--url URL]
#   scripts/memory-eval --export-graded --db URL [--data DIR]
#
# recall-searches.jsonl, past-pointing.jsonl and graded-searches.jsonl: is a labelled answer
# reference in the top N results of /api/knowledge/search for the row's query (or prompt)?
# past-pointing is scored twice: plain, and limited to before the prompt (until), with since
# set when the prompt names a time ("yesterday", "last week") (issue #166).
# graded-searches.jsonl is scored twice: all rows, and the rows a person checked
# (hand_checked true). --export-graded appends the searches the overnight grader graded
# (memory.search_grades: used references plus results graded relevant) that the file lacks,
# unchecked, reading the database at URL with psql; it writes nothing to the database.
# lesson-paraphrase-probes.tsv: is the probed lesson in the top 2 lesson results?
# Prints one line per set (exact answers, items from the answer's session, mean reciprocal
# rank) and the rows where neither appears.
# continue-prompts.jsonl is replayed by the resolver's own test
# (crates/mike-features/src/memory_keeper/resolve_eval_tests.rs), not here.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
data="$root/artifacts/research/session-memory-companion/data"
limit=10
url="${MIKE_INSPECT_URL:-http://127.0.0.1:9989}"
export_db=""
export_graded=0
while [ $# -gt 0 ]; do
  case "$1" in
    --data) data="$2"; shift 2 ;;
    --limit) limit="$2"; shift 2 ;;
    --url) url="$2"; shift 2 ;;
    --export-graded) export_graded=1; shift ;;
    --db) export_db="$2"; shift 2 ;;
    -h|--help) sed -n 2,19p "$0"; exit 0 ;;
    *) echo "memory-eval: unknown argument $1" >&2; exit 2 ;;
  esac
done
[ -d "$data" ] || { echo "memory-eval: no evaluation data at $data" >&2; exit 1; }

if [ "$export_graded" = 1 ]; then
  [ -n "$export_db" ] || { echo "memory-eval: --export-graded needs --db URL" >&2; exit 2; }
  graded="$data/graded-searches.jsonl"
  touch "$graded"
  known="$(python3 -I -c 'import json,sys; print(",".join(str(json.loads(l)["search_id"]) for l in open(sys.argv[1]) if l.strip()) or "0")' "$graded")"
  PGOPTIONS='-c statement_timeout=30000 -c default_transaction_read_only=on' psql "$export_db" -X -At -v ON_ERROR_STOP=1 -c "
SELECT json_build_object(
  'search_id', e.id, 'tool', e.tool, 'created_at', e.created_at, 'query', e.query,
  'kind', e.kind_filter, 'project', p.project_uuid, 'session_uuid', s.session_uuid,
  'prompt', g.turn_prompt,
  'answer_refs', (SELECT coalesce(array_agg(DISTINCT r), '{}') FROM unnest(g.used_references || g.relevant_references) AS r),
  'first_ten', (SELECT coalesce(json_agg(f->>'reference' ORDER BY o), '[]') FROM jsonb_array_elements(g.first_ten) WITH ORDINALITY AS x(f, o)),
  'label_source', CASE WHEN cardinality(g.used_references) > 0 THEN 'used' ELSE 'graded' END,
  'hand_checked', false)
  FROM memory.search_grades g
  JOIN memory.search_events e ON e.id = g.event_id
  JOIN sessions.sessions s ON s.id = e.session_id
  JOIN projects.projects p ON p.id = s.project_id
 WHERE e.query <> ''
   AND cardinality(g.used_references || g.relevant_references) > 0
   AND e.id <> ALL ('{$known}'::bigint[])
 ORDER BY e.id" >> "$graded"
  echo "memory-eval: $(grep -c . "$graded") rows in $graded"
  exit 0
fi

exec python3 -I - "$data" "$limit" "$url" <<'PY'
import json, os, sys, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timedelta

data, limit, url = sys.argv[1], int(sys.argv[2]), sys.argv[3].rstrip("/")

def get(path, **params):
    query = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    with urllib.request.urlopen(f"{url}{path}?{query}", timeout=30) as response:
        return json.load(response)

lesson_project = "ec5bcb17-7792-47c2-9f7b-c07b1f417f92"

QUERY_CHARS = 500

def refs(project, query, kind=None, n=limit, skip=None, window=None):
    since, until = window or (None, None)
    try:
        body = get("/api/knowledge/search", project=project, query=query[:QUERY_CHARS], kind=kind, limit=n + 1, since=since, until=until)
    except urllib.error.HTTPError as error:
        return None, f"{error.code} {error.read().decode(errors='replace')[:160]}"
    except Exception as error:
        return None, str(error)
    items = [item for item in body.get("items", []) if item["reference"] != skip][:n]
    return items, None

def session_of(item):
    for field in ("provenance", "author"):
        value = item.get(field)
        if isinstance(value, dict) and value.get("session_uuid"):
            return value["session_uuid"]
    return None

def canonical(ref):
    kind, _, rest = ref.partition(":")
    return f"thread_entry:{rest}" if kind == "entry" else ref

def score(name, rows):
    hits, session_hits, rr, misses = 0, 0, 0.0, []
    for label, project, query, wanted, kind, n, skip, sessions, *window in rows:
        wanted = [canonical(w) for w in wanted]
        items, error = refs(project, query, kind, n, skip, window[0] if window else None)
        if items is None:
            misses.append(f"  {label}: error {error}")
            continue
        got = [item["reference"] for item in items]
        ranks = [got.index(w) + 1 for w in wanted if w in got]
        if ranks:
            hits += 1
            rr += 1 / min(ranks)
        if ranks or any(session_of(item) in sessions for item in items):
            session_hits += 1
        else:
            misses.append(f"  {label}: wanted {', '.join(wanted)}; got {', '.join(got[:5]) or 'nothing'}")
    total = len(rows)
    mrr = rr / total if total else 0.0
    print(f"{name}: {hits}/{total} answers and {session_hits}/{total} answer sessions in top {rows[0][5] if rows else limit}, MRR {mrr:.3f}")
    for line in misses:
        print(line)

def jsonl(file):
    with open(f"{data}/{file}") as handle:
        return [json.loads(line) for line in handle if line.strip()]

recall = [
    (f"search {r['search_id']}", r["project"], r["query"], r["answer_refs"], r.get("kind"), limit, None, set(r.get("answer_sessions", [])))
    for r in jsonl("recall-searches.jsonl")
]
past = [
    (f"turn {r['turn_id']}", r.get("project_uuid") or str(r["project_id"]), r["prompt"], r["answer_refs"], None, limit, f"turn:{r['turn_id']}", set(r.get("answer_sessions", [])))
    for r in jsonl("past-pointing.jsonl")
]
PAST_WORDS = (("yesterday", 2), ("last night", 2), ("this morning", 1), ("last week", 14), ("few days", 7))

def implied_window(row):
    asked = datetime.fromisoformat(row["created_at"].replace("Z", "+00:00"))
    prompt = row["prompt"].lower()
    days = next((d for word, d in PAST_WORDS if word in prompt), None)
    since = (asked - timedelta(days=days)).isoformat() if days else None
    return since, asked.isoformat()

past_dated = [
    (*row, implied_window(r)) for row, r in zip(past, jsonl("past-pointing.jsonl"))
]
graded_rows = jsonl("graded-searches.jsonl") if os.path.exists(f"{data}/graded-searches.jsonl") else []
graded = [
    (f"graded {r['search_id']}", r["project"], r["query"], r["answer_refs"], r.get("kind"), limit, None, {r.get("session_uuid")}, r.get("hand_checked") is True)
    for r in graded_rows
]
probes = []
with open(f"{data}/lesson-paraphrase-probes.tsv") as handle:
    for line in handle:
        prefix, _, query = line.rstrip("\n").partition("\t")
        if prefix and query:
            probes.append((f"lesson {prefix}", lesson_project, query, [], "lesson", 2, None, set()))

score("recall-searches", recall)
score("past-pointing", past)
score("past-pointing (until the prompt; since when it names a time)", past_dated)
if graded:
    score("graded-searches", [row[:8] for row in graded])
    checked = [row[:8] for row in graded if row[8]]
    if checked:
        score("graded-searches (hand-checked)", checked)
    else:
        print(f"graded-searches (hand-checked): 0/{len(graded)} rows checked by a person yet")

hits, misses = 0, []
for label, project, query, _, kind, n, _skip, _sessions in probes:
    items, error = refs(project, query, kind, n)
    got = [item["reference"] for item in items or []]
    prefix = label.split()[1]
    if got and any(ref.startswith(f"lesson:{prefix}") for ref in got):
        hits += 1
    else:
        misses.append(f"  {label}: got {', '.join(got or []) or error or 'nothing'}")
print(f"lesson-probes: {hits}/{len(probes)} in top 2")
for line in misses:
    print(line)
PY
