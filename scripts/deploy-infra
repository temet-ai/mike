#!/usr/bin/env bash
# Deploy one commit to the ARM64 Linux machines (deus, infra and ha): deus builds it and
# installs it on all three, and this returns as soon as the build is queued.
#
#   scripts/deploy-infra [--sha <commit>] [--builder <ssh host>] [--repo <checkout on the builder>]
#
# The commit defaults to origin/main. Nothing compiles on this machine: deus records the
# commit in ~/.local/state/mike/arm-deploy/wanted and runs scripts/deploy-arm-local in the
# systemd user unit mike-arm-deploy, which builds natively in its one build worktree and
# installs the build on deus, infra and ha (Home Assistant's SSH add-on, via
# scripts/deploy-ha; skipped when ha does not answer). While a build runs, the newest
# commit asked for is built next. Follow it with: ssh deus tail -f .local/state/mike/arm-deploy/deploy.log
set -euo pipefail

die() { echo "deploy-infra: $*" >&2; exit 1; }

want="" builder=deus repo="projects/temet/mike"
while [ $# -gt 0 ]; do
  case "$1" in
    --sha) want="${2:?--sha needs a commit}"; shift 2 ;;
    --builder) builder="${2:?--builder needs an ssh host}"; shift 2 ;;
    --repo) repo="${2:?--repo needs the checkout on the builder}"; shift 2 ;;
    --host) echo "deploy-infra: --host is no longer needed; deus builds and deploys deus, infra and ha" >&2; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) die "unknown argument $1; see --help" ;;
  esac
done

git fetch -q origin
sha="$(git rev-parse "${want:-origin/main}^{commit}")"
git merge-base --is-ancestor "$sha" origin/main || die "${sha:0:9} is not on origin/main"

# shellcheck disable=SC2087 # $repo and $sha are passed as arguments, the rest expands on the builder
ssh "$builder" bash -s -- "$repo" "$sha" <<'REMOTE'
set -euo pipefail
repo="$1" sha="$2"
state="${XDG_STATE_HOME:-$HOME/.local/state}/mike/arm-deploy"
mkdir -p "$state"
echo "$sha" > "$state/wanted"
if systemctl --user is-active -q mike-arm-deploy; then
  echo "==> A build is running on $(hostname); ${sha:0:9} is built next"
  exit 0
fi
cd "$HOME/$repo"
git fetch -q origin
# main moves forward to the commit, so sessions in this checkout stay on a branch; only when it
# cannot fast-forward is the commit checked out detached, because the build runs from it.
{ git checkout -q main && git merge -q --ff-only "$sha"; } || git checkout -q --detach "$sha"
systemd-run --user --quiet --collect --unit mike-arm-deploy \
  --setenv=PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin" \
  --property=StandardOutput="append:$state/deploy.log" --property=StandardError="append:$state/deploy.log" \
  "$HOME/$repo/scripts/deploy-arm-local"
echo "==> $(hostname) is building ${sha:0:9}"
REMOTE
echo "==> Follow it with: ssh $builder tail -f .local/state/mike/arm-deploy/deploy.log"
