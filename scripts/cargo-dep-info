#!/usr/bin/env python3
"""cargo-dep-info — crate version/dep/MSRV info from crates.io + local cargo metadata.

Kills the report's 6-9 call dep-table hunt (§P7, 0be30667): finding a crate's
latest version, its deps, and whether it's yanked/MSRV-gated meant separate
crates.io page fetches plus a manual cargo metadata grep, joined by hand.

Usage:
  cargo-dep-info <crate>[@version]
      version defaults to the latest non-yanked version on crates.io.

Output: latest version + yanked flag, requested/resolved version's deps
(name, version req, kind, optional), MSRV (rust_version) if published, and —
if run inside a cargo workspace — whether/which workspace member(s) depend on
this crate and at what resolved version (from `cargo metadata`).

Dependencies: python3 stdlib only for the crates.io call (urllib); `cargo` for
the optional workspace cross-reference (degrades with a message if absent or
if not run inside a workspace).

Honest exit codes:
  0  success
  1  crate or version not found on crates.io
  2  usage error
  3  crates.io unreachable / network error

Read-only: GET requests to crates.io's public API only; `cargo metadata` is a
local, non-mutating read.
"""
import json
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

API = "https://crates.io/api/v1/crates"
UA = {"User-Agent": "cargo-dep-info/1.0 (local dev tool)"}


def err(msg: str) -> None:
    print(f"cargo-dep-info: {msg}", file=sys.stderr)


def usage() -> int:
    print(__doc__, file=sys.stderr)
    return 2


def fetch(url: str):
    req = urllib.request.Request(url, headers=UA)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    except urllib.error.URLError as e:
        err(f"network error contacting crates.io: {e}")
        sys.exit(3)


def workspace_usage(crate: str):
    if not shutil.which("cargo"):
        return None
    try:
        proc = subprocess.run(
            ["cargo", "metadata", "--format-version", "1"],
            capture_output=True, text=True, timeout=30,
        )
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    try:
        meta = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    users = []
    workspace_members = set(meta.get("workspace_members", []))
    for pkg in meta.get("packages", []):
        if pkg.get("id") not in workspace_members:
            continue
        for dep in pkg.get("dependencies", []):
            if dep.get("name") == crate:
                users.append((pkg.get("name"), dep.get("req")))
    return users


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if not args:
        return usage()
    if len(args) != 1:
        err("expected exactly one argument: <crate>[@version]")
        return usage()

    spec = args[0]
    if "@" in spec:
        crate, version = spec.split("@", 1)
    else:
        crate, version = spec, None

    crate_data = fetch(f"{API}/{crate}")
    if crate_data is None:
        err(f"crate '{crate}' not found on crates.io")
        return 1

    info = crate_data["crate"]
    latest = info.get("newest_version") or info.get("max_stable_version")
    print(f"crate: {crate}")
    print(f"latest version: {latest}")
    print(f"description: {info.get('description', '')}")
    print(f"repository: {info.get('repository', 'n/a')}")

    target_version = version or latest
    versions = {v["num"]: v for v in crate_data.get("versions", [])}
    vinfo = versions.get(target_version)
    if vinfo is None:
        err(f"version '{target_version}' not found for crate '{crate}'")
        return 1

    print(f"\nresolved version: {target_version}")
    print(f"yanked: {vinfo.get('yanked', False)}")
    print(f"rust_version (MSRV): {vinfo.get('rust_version') or 'not published'}")
    print(f"published: {vinfo.get('created_at', 'n/a')}")

    deps_data = fetch(f"{API}/{crate}/{target_version}/dependencies")
    deps = (deps_data or {}).get("dependencies", [])
    if deps:
        print(f"\ndependencies ({len(deps)}):")
        print(f"{'NAME':<30} {'REQ':<15} {'KIND':<10} OPTIONAL")
        for d in deps:
            print(f"{d.get('crate_id',''):<30} {d.get('req',''):<15} {d.get('kind',''):<10} {d.get('optional', False)}")
    else:
        print("\ndependencies: none listed")

    users = workspace_usage(crate)
    if users is None:
        print("\nworkspace cross-reference: not run (no cargo on PATH, not a cargo dir, or metadata failed)")
    elif not users:
        print("\nworkspace cross-reference: no workspace member depends on this crate")
    else:
        print(f"\nworkspace cross-reference ({len(users)} member(s) depend on '{crate}'):")
        for member, req in users:
            print(f"  {member} -> {req}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
