#!/usr/bin/env node
// html-doc-render — turn the HTML pages under docs/ into pictures GitHub can show.
//
// GitHub shows an .html file as source, so a reader browsing the repository never sees
// these pages drawn. This renders each one in headless Chromium and writes, next to it:
//
//   <dir>/<name>/NN-<section>.png   one picture per <section>, or one of the whole page
//   <dir>/<name>/SOURCE.sha256      hash of the page these were made from
//
// The Markdown that describes each page embeds the pictures.
//
// Usage: scripts/html-doc-render            render and write
//        scripts/html-doc-render --check    exit 1 when any pictures are older than their page

import { createRequire } from 'node:module';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync, rmSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');

const PAGES = [
	{ source: 'docs/tui/STYLE_GUIDE.html', out: 'docs/tui/style-guide', sections: 'section[id]' },
	{ source: 'docs/tui/LAYOUT.html', out: 'docs/tui/layout' },
];

const hashOf = (file) => createHash('sha256').update(readFileSync(file)).digest('hex');
const slug = (text) =>
	text
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')
		.slice(0, 48);

if (process.argv.includes('--check')) {
	const stale = PAGES.filter(({ source, out }) => {
		const stamp = path.join(repoRoot, out, 'SOURCE.sha256');
		return !existsSync(stamp) || readFileSync(stamp, 'utf8').trim() !== hashOf(path.join(repoRoot, source));
	});
	if (!stale.length) {
		console.log('CLEAN: every rendered HTML doc matches its page.');
		process.exit(0);
	}
	for (const { out } of stale) console.error(`STALE: ${out}/`);
	console.error('Run scripts/html-doc-render and commit the result.');
	process.exit(1);
}

const require = createRequire(path.join(repoRoot, 'frontend', 'package.json'));
let chromium;
try {
	({ chromium } = require('playwright'));
} catch {
	console.error('SKIP: playwright not resolvable from frontend/ — run pnpm install there first.');
	process.exit(2);
}

const browser = await chromium.launch();
try {
	for (const { source, out, sections } of PAGES) {
		const file = path.join(repoRoot, source);
		const dir = path.join(repoRoot, out);
		const page = await browser.newPage({ viewport: { width: 1280, height: 900 }, colorScheme: 'dark' });
		await page.emulateMedia({ reducedMotion: 'reduce' });
		await page.goto(pathToFileURL(file).href, { waitUntil: 'networkidle', timeout: 60000 });
		await page.waitForTimeout(1000);
		if (existsSync(dir)) rmSync(dir, { recursive: true });
		mkdirSync(dir, { recursive: true });
		const written = [];
		if (sections) {
			const found = page.locator(sections);
			const count = await found.count();
			for (let index = 0; index < count; index++) {
				const section = found.nth(index);
				const heading = (await section.locator('h2').first().textContent().catch(() => null)) ?? (await section.getAttribute('id'));
				const name = `${String(index + 1).padStart(2, '0')}-${slug(heading)}.png`;
				await section.screenshot({ path: path.join(dir, name) });
				written.push(name);
			}
		} else {
			await page.screenshot({ path: path.join(dir, 'page.png'), fullPage: true });
			written.push('page.png');
		}
		writeFileSync(path.join(dir, 'SOURCE.sha256'), `${hashOf(file)}\n`);
		await page.close();
		console.log(`${out}/: ${written.join(', ')}`);
	}
} finally {
	await browser.close();
}
