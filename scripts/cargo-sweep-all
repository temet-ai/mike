#!/usr/bin/env bash
# cargo-sweep-all — the sweep the proxy's scheduler runs every six hours (job
# cargo_sweep): every cargo target folder under the project roots, this
# checkout's and every other project's, their worktrees included, then every
# cargo build-dir under ~/.cargo/build. Exit status is non-zero when a step
# failed or a swept volume stays under the free-space floor.
#
# Target folders are found, not listed: a hand-kept list covered only the
# folders known the day it was written, and every new project's target/ grew
# unswept until the disk filled (holdfast 431GB on 2026-10-07, radar 597GB on
# 2026-10-20). The scope is the machine, not this repository: on 2026-10-20 the
# sweep was narrowed to this checkout after it had deleted fingerprints under a
# radar clippy run, and two days later radar's target/ was back at 267GB with
# nothing sweeping it (2026-10-22). What keeps a sweep from failing a build is
# cargo-target-sweep holding a profile's cargo locks while it deletes there,
# not staying out of other projects' folders.
#
# Roots: $CARGO_SWEEP_ROOTS (colon-separated), else the folder that holds this
# checkout's parent (…/projects for …/projects/temet/temet-proxy), $HOME/projects
# and $HOME/.cache. A target folder is one named target or *-target that holds
# cargo's CACHEDIR.TAG or .rustc_info.json. Its immediate subfolders that hold
# CACHEDIR.TAG are target folders too (target/fleet, target/fleet-check, any
# CARGO_TARGET_DIR=target/<name>); nothing else is searched inside one.
#
# Usage: cargo-sweep-all [--dry-run]    --dry-run reports what would go, deletes nothing.
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
sweep="${CARGO_SWEEP_SCRIPT:-${root}/scripts/cargo-target-sweep}"
status=0
dry=0
sweep_opts=()
for arg in "$@"; do
  case "${arg}" in
    --dry-run) dry=1; sweep_opts+=(--dry-run) ;;
    *) echo "cargo-sweep-all: unknown argument ${arg}" >&2; exit 2 ;;
  esac
done

roots=()
if [[ -n "${CARGO_SWEEP_ROOTS:-}" ]]; then
  IFS=: read -r -a roots <<< "${CARGO_SWEEP_ROOTS}"
else
  roots=("$(dirname "$(dirname "${root}")")" "${HOME}/projects" "${HOME}/.cache")
fi

# Never unlink whole target directories: a Cargo process may already be waiting
# on their lock inode. A finished checkout's folder is emptied instead
# (cargo-target-sweep --empty): every build goes, its Cargo lock files stay.
finished=()
empty_finished() {
  local dir="$1" why="$2"
  local verb="emptying"
  (( dry )) && verb="would empty"
  echo "cargo-sweep-all: ${dir}: ${verb}, ${why}; retaining Cargo lock files"
  finished+=("${dir}")
}

targets=()
seen=" "
searched=" "
for base in "${roots[@]}"; do
  [[ -d "${base}" ]] || continue
  base="$(cd "${base}" && pwd -P)"
  case "${searched}" in *" ${base} "*) continue ;; esac
  searched="${searched}${base} "
  while IFS= read -r dir; do
    [[ -f "${dir}/CACHEDIR.TAG" || -f "${dir}/.rustc_info.json" ]] || continue
    real="$(cd "${dir}" && pwd -P)"
    case "${seen}" in *" ${real} "*) continue ;; esac
    seen="${seen}${real} "
    targets+=("${real}")
    for sub in "${real}"/*/; do
      sub="${sub%/}"
      [[ -f "${sub}/CACHEDIR.TAG" ]] || continue
      case "${seen}" in *" ${sub} "*) continue ;; esac
      seen="${seen}${sub} "
      targets+=("${sub}")
    done
  done < <(find "${base}" \
    \( -name node_modules -o -name .git -o -name .venv -o -name venv -o -name vendor -o -name __pycache__ \) -prune -o \
    -type d \( -name target -o -name '*-target' \) -print -prune 2>/dev/null)
done

# A detached checkout (a gate, check or release build) is finished once its
# commit is on the main branch and nothing was built in it for this many days;
# so is a target folder no project owns.
detached_days="${CARGO_SWEEP_DETACHED_DAYS:-1}"

main_branch() {
  local tree="$1" base
  base="$(git -C "${tree}" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  if [[ -z "${base}" ]]; then
    for base in origin/main main origin/master master; do
      git -C "${tree}" rev-parse -q --verify "${base}^{commit}" >/dev/null && break
      base=""
    done
  fi
  printf '%s' "${base}"
}

finished_detached() {
  local tree="$1" base
  [[ -f "${tree}/.git" ]] || return 1
  git -C "${tree}" symbolic-ref -q HEAD >/dev/null 2>&1 && return 1
  [[ -z "$(git -C "${tree}" status --porcelain --untracked-files=no 2>/dev/null)" ]] || return 1
  base="$(main_branch "${tree}")"
  [[ -n "${base}" ]] && git -C "${tree}" merge-base --is-ancestor HEAD "${base}" 2>/dev/null
}

finished_branch() {
  local tree="$1" branch base
  [[ -f "${tree}/.git" ]] || return 1
  branch="$(git -C "${tree}" symbolic-ref -q --short HEAD 2>/dev/null)" || return 1
  if [[ "$(git -C "${tree}" for-each-ref --format='%(upstream:track)' "refs/heads/${branch}" 2>/dev/null)" == "[gone]" ]]; then
    return 0
  fi
  base="$(git -C "${tree}" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  if [[ -z "${base}" ]]; then
    for base in main master; do
      git -C "${tree}" show-ref -q --verify "refs/heads/${base}" && break
      base=""
    done
  fi
  [[ -n "${base}" && "${base}" != "${branch}" ]] || return 1
  git -C "${tree}" merge-base --is-ancestor "${branch}" "${base}" 2>/dev/null
}

written_within() {
  [[ -n "$(find "$1" -maxdepth 3 -mtime -"$2" -print 2>/dev/null | head -1)" ]]
}

# A new branch with no commits yet also reads as merged, so a merged or gone
# branch's folder waits this many minutes after its last build.
branch_idle_minutes="${CARGO_SWEEP_BRANCH_IDLE_MINUTES:-120}"
built_in_minutes() {
  [[ -n "$(find "$1" -maxdepth 3 -mmin -"$2" -print 2>/dev/null | head -1)" ]]
}

kept=()
for dir in "${targets[@]+"${targets[@]}"}"; do
  [[ -d "${dir}" ]] || continue
  tree="$(dirname "${dir}")"
  why=""
  if [[ -f "${tree}/CACHEDIR.TAG" ]]; then
    why=""   # a target folder inside a target folder goes with its parent
  elif [[ ! -f "${tree}/Cargo.toml" ]]; then
    written_within "${dir}" "${detached_days}" ||
      why="no project beside it owns it and nothing was built for ${detached_days}d"
  elif [[ "$(basename "${dir}")" == target ]] && finished_branch "${tree}"; then
    built_in_minutes "${dir}" "${branch_idle_minutes}" ||
      why="its worktree's branch is merged or gone and nothing was built for ${branch_idle_minutes}m"
  elif [[ "$(basename "${dir}")" == target ]] && finished_detached "${tree}" &&
    ! written_within "${dir}" "${detached_days}"; then
    why="its detached checkout is on the main branch and nothing was built for ${detached_days}d"
  fi
  if [[ -n "${why}" ]]; then
    empty_finished "${dir}" "${why}"
    continue
  fi
  kept+=("${dir}")
done
targets=("${kept[@]+"${kept[@]}"}")

if [[ ${#targets[@]} -gt 0 ]]; then
  "${sweep}" "${sweep_opts[@]+"${sweep_opts[@]}"}" "${targets[@]}" || status=1
fi

# Cargo build-dirs (build.build-dir = "{cargo-cache-home}/build/<project>/{workspace-path-hash}",
# holdfast and voxel-lab): the hash is two folders deep, and holdfast's
# scripts/worktree-warm leaves a .checkout file naming the checkout a build-dir
# was made for. Every build directory is swept with its Cargo locks retained,
# including those whose checkout is gone. An unmarked directory also receives
# the legacy idle hint for diagnostics.
owned=()
unowned=()
for dir in "${HOME}"/.cargo/build/*/*/*; do
  [[ -d "${dir}" ]] || continue
  [[ -f "${dir}/CACHEDIR.TAG" || -f "${dir}/.rustc_info.json" ]] || continue
  if [[ -f "${dir}/.checkout" ]]; then
    owner="$(head -n 1 "${dir}/.checkout")"
    if [[ -n "${owner}" && ! -e "${owner}" ]]; then
      empty_finished "${dir}" "the checkout it was built for (${owner}) no longer exists"
      continue
    fi
    owned+=("${dir}")
  else
    unowned+=("${dir}")
  fi
done
if [[ ${#owned[@]} -gt 0 ]]; then
  "${sweep}" "${sweep_opts[@]+"${sweep_opts[@]}"}" "${owned[@]}" || status=1
fi
if [[ ${#unowned[@]} -gt 0 ]]; then
  "${sweep}" "${sweep_opts[@]+"${sweep_opts[@]}"}" --remove-idle 14 "${unowned[@]}" || status=1
fi
if [[ ${#finished[@]} -gt 0 ]]; then
  "${sweep}" "${sweep_opts[@]+"${sweep_opts[@]}"}" --empty "${finished[@]}" || status=1
fi

floor_gb="${CARGO_SWEEP_FLOOR_GB:-30}"
swept=("${targets[@]+"${targets[@]}"}" "${owned[@]+"${owned[@]}"}" "${unowned[@]+"${unowned[@]}"}" "${finished[@]+"${finished[@]}"}")
checked=" "
for dir in "${swept[@]+"${swept[@]}"}"; do
  [[ -d "${dir}" ]] || continue
  volume="$(df -Pk "${dir}" 2>/dev/null | awk 'NR==2 {print $6}')"
  [[ -n "${volume}" ]] || continue
  case "${checked}" in *" ${volume} "*) continue ;; esac
  checked="${checked}${volume} "
  free_kb="$(df -Pk "${dir}" | awk 'NR==2 {print $4}')"
  if (( free_kb < floor_gb * 1024 * 1024 )); then
    echo "cargo-sweep-all: ${volume} has $((free_kb / 1024 / 1024))GB free after the sweep, under the ${floor_gb}GB floor; largest build folders on it:"
    for t in "${swept[@]}"; do
      [[ -d "${t}" ]] || continue
      [[ "$(df -Pk "${t}" | awk 'NR==2 {print $6}')" == "${volume}" ]] && du -sk "${t}" 2>/dev/null
    done | sort -rn | head -5 | awk '{printf "  %dGB %s\n", $1 / 1048576, $2}'
    status=1
  fi
done

exit "${status}"
