#!/usr/bin/env bash
# cx — cargo with the repo env preloaded (.env + a per-checkout CARGO_TARGET_DIR), runnable from any cwd.
# Usage: cx <any cargo args>
#   Inner-loop examples:
#     cx check -p mike --tests -j2
#     cx nextest run -p mike-mcp --test <stem>
set -euo pipefail

# Resolve repo root from the script's own location (works from any cwd, even outside the repo).
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$script_dir" rev-parse --show-toplevel)"
cd "$repo_root"

# A managed fleet slot (a clean checkout under .claude/worktrees) has no ignored
# `artifacts` symlink, and tests include_str! fixtures from it. Link the main checkout's
# artifacts directory in, so --tests compiles; no secrets are involved.
if [[ ! -e "$repo_root/artifacts" ]]; then
  cx_main_root="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
  if [[ "$cx_main_root" != "$repo_root" && -d "$cx_main_root/artifacts" ]]; then
    ln -s "$(cd "$cx_main_root/artifacts" && pwd -P)" "$repo_root/artifacts" 2>/dev/null || true
  fi
fi

source "$script_dir/lib/source-env.sh"
mike_source_env_preserving_exported "$repo_root/.env"

# Tests build ProxyConfig through the same loader as the binary, which reads
# every MIKE_* variable. The developer's local-fallback database from .env is
# not a test fixture: a test that inherits it dials a database that may not be
# running and times out after 30s. Tests that want a fallback set their own.
case " $* " in
  *" test "* | *" nextest "*) unset MIKE_LOCAL_DATABASE_URL ;;
esac

# macOS's default TMPDIR is a long path under /var, which is a symlink. The
# installation code refuses a symlinked ancestry and caps the control socket
# path at 103 bytes, so tests get a short canonical folder instead.
if [[ "$(uname -s)" == "Darwin" && "${TMPDIR:-}" != /private/tmp* ]]; then
  export TMPDIR=/private/tmp
fi

cx_target_named="${CARGO_TARGET_DIR:-}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$repo_root/target}"

# Ensure the build accelerators this script opts in to (sccache, lld) are
# present, installing them if missing, then inject them via `cargo --config`.
# shellcheck disable=SC1091
source "$script_dir/lib/preflight-toolchain.sh"

# check, clippy, test, nextest and build run through mbx by default when mbx is
# installed, into target/mbx-<session> (select_build_cache in preflight-toolchain.sh),
# so a new worktree restores from the shared store instead of building cold. nextest
# runs with CARGO pointing at mbx's cargo shim, so its test binaries come from the store.
# build stays on plain cargo in target/ when MIKE_BUILD_IDENTITY=git (make install, the
# release scripts), which embed the commit through build.rs. MIKE_BUILD_CACHE=mbx forces
# mbx into a named directory; MIKE_BUILD_CACHE=cargo forces plain cargo. See
# scripts/mbx-trial/README.md.
cx_sub="$(cx_cargo_subcommand "$@")"
select_build_cache "$repo_root" "$cx_target_named" "$cx_sub"
if [[ "$CX_CACHE_MODE" == mbx ]]; then
  prepare_mbx_build_cache "$repo_root" "$CX_MBX_TARGET"
  if [[ "$cx_sub" == nextest ]]; then
    cx_nextest="$(command -v cargo-nextest || true)"
    if [[ -z "$cx_nextest" ]]; then
      echo "cx: cargo-nextest is not installed (cargo install cargo-nextest --locked)" >&2
      exit 1
    fi
    # nextest reads CARGO for its builds, and mbx reads CARGO to find the real cargo,
    # so CARGO=mbx makes mbx call itself without end. The cargo shim that `mbx setup`
    # installs marks its calls, so mbx then runs the real cargo.
    cx_shim="${XDG_DATA_HOME:-$HOME/.local/share}/mbx/bin/cargo"
    if [[ ! -x "$cx_shim" ]]; then
      echo "cx: mbx's cargo shim is missing ($cx_shim); run 'mbx setup' once, then 'mbx setup --uninstall' to keep only the shim" >&2
      exit 1
    fi
    cx_cmd=(env "CARGO=$cx_shim" "$cx_nextest" "$@")
  else
    cx_cmd=("$MBX_BIN" "$@")
  fi
else
  ensure_build_toolchain
  compute_accelerator_cargo_args
  cx_cmd=(cargo "${ACCELERATOR_CARGO_ARGS[@]}" "$@")
fi

# A heavy build runs at the lowest priority, on at most half the processors, and one at a
# time on the machine (scripts/lib/heavy-build.sh). fmt, metadata and the rest are exempt.
# shellcheck source=lib/heavy-build.sh
source "$script_dir/lib/heavy-build.sh"
cx_heavy=0
if heavy_build_is_heavy "$cx_sub"; then
  cx_heavy=1
  CARGO_BUILD_JOBS="$(heavy_build_jobs)"
  export CARGO_BUILD_JOBS
  cx_priority=()
  while IFS= read -r cx_word; do cx_priority+=("$cx_word"); done < <(heavy_build_priority)
  cx_cmd=("${cx_priority[@]}" "${cx_cmd[@]}")
fi

if [[ -n "${CX_PRINT_TARGET_DIR:-}" ]]; then
  printf '%s\n' "$CARGO_TARGET_DIR"
  exit 0
fi

if [[ -n "${CX_PRINT_COMMAND:-}" ]]; then
  printf '%s\n' "${cx_cmd[@]}"
  exit 0
fi

# ── Keeping the shared build directory from filling the volume ───────────────
# Nothing removes anything from CARGO_TARGET_DIR on its own, so it grows until
# the disk is full and then builds, git and the capture database all fail at
# once. A scheduled cleaner exists, but a clock cannot answer a burst: on
# 2026-08-28 updating 154 crates and running two full checks added 32GB in
# forty minutes, faster than any interval that is cheap enough to run.
#
# So the check happens here instead, because every cargo command in this repo
# comes through this script, at the two moments that actually matter: when a
# build is about to consume space and there is little left, and when a build
# has just made a whole slice of the directory obsolete. `df` costs nothing, so
# the common case pays no measurable price.
#
# scripts/lib/target-dir-guard.sh carries the reasoning for the turn-taking.
# shellcheck disable=SC1091
source "$script_dir/lib/target-dir-guard.sh"

SWEEPER="${CARGO_SWEEP_SCRIPT:-$script_dir/cargo-target-sweep}"
# Below this many free gigabytes, reclaim before building rather than after
# failing. One full workspace slice is around 35GB, so this is roughly enough
# headroom to finish what is about to start.
DISK_FLOOR_GB="${CX_DISK_FLOOR_GB:-30}"

# Run the cleaner, but never while holding a build registration: the sweep waits
# for builds to finish and the build would be waiting for the sweep.
cx_sweep() {
  local why="$1"
  [[ -n "${CX_NO_SWEEP:-}" ]] && return 0
  if [[ ! -x "$SWEEPER" ]]; then
    echo "cx: ${why}, but the sweeper ${SWEEPER} is missing or not executable; nothing reclaimed" >&2
    return 0
  fi
  echo "cx: reclaiming space in ${CARGO_TARGET_DIR} (${why})" >&2
  "$SWEEPER" >&2 || true
}

# A clean checkout has no target folder yet, and the free-space read needs one.
mkdir -p "$CARGO_TARGET_DIR"
free_gb="$(guard_free_gb)"
if [[ -n "$free_gb" ]] && (( free_gb < DISK_FLOOR_GB )); then
  cx_sweep "${free_gb}G free, floor ${DISK_FLOOR_GB}G"
fi

# A changed lockfile means the dependency graph moved, and everything compiled
# against the old graph is now dead weight. That is what produced the 32GB
# spike, so it is the moment to reclaim rather than six hours later.
lock_before=""
source "$script_dir/lib/sha256.sh"
[[ -f Cargo.lock ]] && lock_before="$(sha256 < Cargo.lock)"

if (( cx_heavy )); then
  heavy_build_lock "cx $cx_sub" || exit 1
fi
guard_build_enter
trap 'guard_build_leave; heavy_build_unlock' EXIT

# ── A query without its .sqlx entry must not stop the crate for everyone (#533) ─
# sqlx's macros read .sqlx/ offline. A seat that saves a new query! before its entry
# exists makes crate mike fail to compile for every seat sharing the tree, until that
# seat has prepared it (14 minutes, five seats, 2026-10-08). So when a build fails with
# sqlx's "set DATABASE_URL ... or run cargo sqlx prepare" error and the tree has
# uncommitted Rust changes (a seat's work in progress, never a clean checkout of a
# commit, whose check must stay red when the entry is missing), cx runs
# scripts/sqlx-prepare once for the whole checkout (others wait on a lock, they do not
# run it again) and builds again. Opt out with CX_AUTOPREPARE=0.
cx_sqlx_missing_msg='set `DATABASE_URL` to use query macros online'
cx_autoprepare_ok=0
if [[ "${CX_AUTOPREPARE:-1}" != "0" && ! -t 2 && "${1:-}" =~ ^(check|build|clippy|test|nextest|doc)$ ]]; then
  cx_autoprepare_ok=1
fi
cx_errlog=""
if (( cx_autoprepare_ok )); then
  cx_errlog="$(mktemp "${TMPDIR:-/tmp}/cx-err.XXXXXX")"
  trap 'guard_build_leave; heavy_build_unlock; rm -f "${cx_errlog:?}"' EXIT
fi

cx_run() {
  if [[ -n "$cx_errlog" ]]; then
    { "${cx_cmd[@]}" 2>&1 1>&3 8>&- | tee "$cx_errlog" >&2; return "${PIPESTATUS[0]}"; } 3>&1
  else
    "${cx_cmd[@]}" 8>&-
  fi
}

cx_prepare_once() {
  local lock pid waited=0
  lock="$(git rev-parse --path-format=absolute --git-common-dir)/cx-sqlx-prepare.lock.d"
  while ! mkdir "$lock" 2>/dev/null; do
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "${lock:?}"; continue
    fi
    (( waited == 0 )) && echo "cx: another seat is preparing the sqlx queries; waiting for it" >&2
    sleep 3; waited=$((waited + 3))
    (( waited > 1500 )) && return 1
    if [[ ! -d "$lock" ]]; then return 0; fi
  done
  echo $$ >"$lock/pid"
  local pkgs=() prev="" a rc=0
  for a in "${cx_orig_args[@]}"; do
    [[ "$prev" == "-p" || "$prev" == "--package" ]] && pkgs+=(-p "$a")
    prev="$a"
  done
  echo "cx: a query has no .sqlx entry; running scripts/sqlx-prepare once for the checkout (#533)" >&2
  if (( ${#pkgs[@]} )); then
    CX_AUTOPREPARE=0 "$script_dir/sqlx-prepare" -- "${pkgs[@]}" --all-targets >&2 8>&- || rc=$?
  else
    CX_AUTOPREPARE=0 "$script_dir/sqlx-prepare" >&2 8>&- || rc=$?
  fi
  rm -rf "${lock:?}"
  return "$rc"
}

cx_orig_args=("$@")
set +e
cx_run
status=$?
if (( status != 0 && cx_autoprepare_ok )) && grep -qF "$cx_sqlx_missing_msg" "$cx_errlog" \
   && [[ -n "$(git status --porcelain -- '*.rs' 2>/dev/null)" ]]; then
  if cx_prepare_once; then
    echo "cx: building again with the new .sqlx entries" >&2
    cx_run
    status=$?
  else
    echo "cx: sqlx-prepare did not succeed; the original errors above stand. A query that reads a column only an undeployed migration adds needs: scripts/sqlx-prepare --db <migrated scratch db>" >&2
  fi
fi
set -e

guard_build_leave
heavy_build_unlock
trap - EXIT
[[ -n "$cx_errlog" ]] && rm -f "$cx_errlog"

swept=0
if [[ -n "$lock_before" && -f Cargo.lock ]]; then
  lock_after="$(sha256 < Cargo.lock)"
  [[ "$lock_after" != "$lock_before" ]] && cx_sweep "dependency graph changed" && swept=1
fi
# A build folder over its cap is swept after the build, not hours later by the timer.
cap_gb="${CARGO_SWEEP_MAXSIZE_GB:-40}"
size_kb="$(du -sk "$CARGO_TARGET_DIR" 2>/dev/null | cut -f1)"
if (( ! swept )) && [[ -n "$size_kb" ]] && (( size_kb > cap_gb * 1048576 )); then
  cx_sweep "$((size_kb / 1048576))G, over the ${cap_gb}G cap"
fi

exit "$status"
