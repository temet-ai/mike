#!/usr/bin/env bash
# test-cargo-target-sweep — checks scripts/cargo-target-sweep against a temporary
# build directory, never a real one.
set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SWEEP="$script_dir/cargo-target-sweep"
pass=0
fail=0
chk() { if [[ "$1" == pass ]]; then pass=$((pass + 1)); echo "  PASS  $2"; else fail=$((fail + 1)); echo "  FAIL  $2"; fi; }

new_target() {
  local t
  t="$(mktemp -d)"
  local a=0123456789abcdef b=fedcba9876543210 c=00112233aabbccdd
  # incremental directories carry rustc's base-36 crate id, not cargo's hex hash
  local ia=1cegpncsm30c6 ib=3mflii7unhj8b
  mkdir -p "$t/debug/deps" "$t/debug/incremental/mike-$ia/s-1" "$t/debug/incremental/mike-$ib/s-2" \
           "$t/debug/build/serde-$a" "$t/debug/build/serde-$b" "$t/debug/.fingerprint/serde-$b"
  head -c 2097152 /dev/zero > "$t/debug/deps/libserde-$a.rlib"
  head -c 2097152 /dev/zero > "$t/debug/deps/libserde-$b.rlib"
  head -c 2097152 /dev/zero > "$t/debug/deps/libtokio-$c.rlib"
  head -c 2097152 /dev/zero > "$t/debug/incremental/mike-$ib/s-2/blob"
  touch -t 202001010000 "$t/debug/deps/libserde-$a.rlib" "$t/debug/deps/libtokio-$c.rlib" \
        "$t/debug/incremental/mike-$ia" "$t/debug/build/serde-$a"
  printf '%s' "$t"
}

echo "cargo-target-sweep — a directory with nothing superseded is left alone"
t="$(new_target)"
rm -f "$t/debug/deps/libserde-0123456789abcdef.rlib"
rm -rf "$t/debug/incremental/mike-1cegpncsm30c6" "$t/debug/build/serde-0123456789abcdef"
CARGO_SWEEP_MAXSIZE_GB=1 "$SWEEP" "$t" | grep -q 'nothing to remove' && chk pass "reports nothing to remove" || chk fail "reports nothing to remove"
[[ -f "$t/debug/deps/libtokio-00112233aabbccdd.rlib" ]] && chk pass "a crate's only build is kept" || chk fail "a crate's only build is kept"
rm -rf "$t"

echo "cargo-target-sweep — over cap, stale items go and recent ones stay"
t="$(new_target)"
"$SWEEP" --cap 0 "$t" >/dev/null
[[ ! -e "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "an old build of a crate with a newer one is removed" || chk fail "an old build of a crate with a newer one is removed"
[[ ! -e "$t/debug/incremental/mike-1cegpncsm30c6" ]] && chk pass "superseded incremental state is removed" || chk fail "superseded incremental state is removed"
[[ ! -e "$t/debug/build/serde-0123456789abcdef" ]] && chk pass "superseded build-script output is removed" || chk fail "superseded build-script output is removed"
[[ -f "$t/debug/deps/libserde-fedcba9876543210.rlib" ]] && chk pass "the newest build of a crate stays" || chk fail "the newest build of a crate stays"
[[ -f "$t/debug/deps/libtokio-00112233aabbccdd.rlib" ]] && chk pass "an old build that is a crate's only build stays" || chk fail "an old build that is a crate's only build stays"
[[ -d "$t/debug/incremental/mike-3mflii7unhj8b" ]] && chk pass "recent incremental state stays in an unguarded directory" || chk fail "recent incremental state stays in an unguarded directory"
rm -rf "$t"

echo "cargo-target-sweep — a guarded directory loses all incremental state when still over cap"
t="$(new_target)"
mkdir -p "$t/.guard"
"$SWEEP" --cap 0 "$t" >/dev/null
[[ ! -e "$t/debug/incremental" ]] && chk pass "incremental is wiped once the sweep holds the slot" || chk fail "incremental is wiped once the sweep holds the slot"
[[ ! -d "$t/.guard/sweeping" ]] && chk pass "the sweep slot is released" || chk fail "the sweep slot is released"
rm -rf "$t"

echo "cargo-target-sweep — a live build keeps its incremental state"
t="$(new_target)"
mkdir -p "$t/.guard"
sleep 30 & live=$!
: > "$t/.guard/build.$live"
GUARD_SWEEP_WAIT_SECS=2 "$SWEEP" --cap 0 "$t" | grep -q 'builds still running' && chk pass "says a build is running" || chk fail "says a build is running"
[[ -d "$t/debug/incremental/mike-3mflii7unhj8b" ]] && chk pass "recent incremental state survives a live build" || chk fail "recent incremental state survives a live build"
kill "$live" 2>/dev/null; wait "$live" 2>/dev/null
rm -rf "$t"

echo "cargo-target-sweep — dry run deletes nothing"
t="$(new_target)"
mkdir -p "$t/.guard"
"$SWEEP" --cap 0 --dry-run "$t" | grep -q 'would sweep' && chk pass "says what it would do" || chk fail "says what it would do"
[[ -f "$t/debug/deps/libserde-0123456789abcdef.rlib" && -d "$t/debug/incremental/mike-3mflii7unhj8b" ]] && chk pass "every file is still there" || chk fail "every file is still there"
rm -rf "$t"

echo "cargo-target-sweep — superseded builds go even under the cap"
t="$(new_target)"
CARGO_SWEEP_MAXSIZE_GB=1 "$SWEEP" "$t" >/dev/null
[[ ! -e "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "a superseded build is removed under the cap" || chk fail "a superseded build is removed under the cap"
[[ -d "$t/debug/incremental/mike-3mflii7unhj8b" ]] && chk pass "incremental state is kept under the cap" || chk fail "incremental state is kept under the cap"
rm -rf "$t"

echo "cargo-target-sweep — --remove-idle retains Cargo lock paths and sweeps artifacts"
idle="$(new_target)"
find "$idle" -exec touch -t 202001010000 {} +
busy="$(new_target)"
"$SWEEP" --remove-idle 14 "$idle" "$busy" >/dev/null
[[ -d "$idle" && ! -e "$idle/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "an idle build directory retains its lock paths but loses superseded artifacts" || chk fail "an idle build directory retains its lock paths but loses superseded artifacts"
[[ -d "$busy" ]] && chk pass "a build directory written recently stays" || chk fail "a build directory written recently stays"
rm -rf "$idle" "$busy"

echo "cargo-target-sweep — --empty removes every build and keeps the Cargo lock files"
t="$(new_target)"
: > "$t/debug/.cargo-lock"
"$SWEEP" --empty "$t" >/dev/null
[[ -z "$(find "$t/debug" -mindepth 1 ! -name '.cargo-lock' ! -name '.cargo-build-lock' ! -name '.cargo-artifact-lock' -print -quit)" ]] && chk pass "an emptied profile holds nothing but lock files" || chk fail "an emptied profile holds nothing but lock files"
[[ -f "$t/debug/.cargo-lock" ]] && chk pass "the profile's lock file stays" || chk fail "the profile's lock file stays"
rm -rf "$t"

echo "cargo-target-sweep — --empty skips a profile a build holds"
t="$(new_target)"
: > "$t/debug/.cargo-lock"
ready="$(mktemp)"; rm -f "$ready"
perl -MFcntl=:flock -e 'open(my $h, "<", $ARGV[0]) or die; flock($h, LOCK_EX) or die; open(my $r, ">", $ARGV[1]); close $r; sleep 30' "$t/debug/.cargo-lock" "$ready" &
holder=$!
for _ in $(seq 50); do [[ -e "$ready" ]] && break; sleep 0.1; done
"$SWEEP" --empty "$t" >/dev/null
[[ -f "$t/debug/deps/libtokio-00112233aabbccdd.rlib" ]] && chk pass "a held profile keeps its builds" || chk fail "a held profile keeps its builds"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
rm -rf "$t" "$ready"

echo "cargo-target-sweep — over cap, recent superseded builds go too and the newest stays"
t="$(new_target)"
touch "$t/debug/deps/libserde-0123456789abcdef.rlib"
sleep 1
touch "$t/debug/deps/libserde-fedcba9876543210.rlib"
"$SWEEP" --cap 0 "$t" >/dev/null
[[ ! -e "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "a recent superseded build is removed over cap" || chk fail "a recent superseded build is removed over cap"
[[ -f "$t/debug/deps/libserde-fedcba9876543210.rlib" ]] && chk pass "the newest build of the crate stays" || chk fail "the newest build of the crate stays"
rm -rf "$t"
t="$(new_target)"
touch "$t/debug/deps/libserde-0123456789abcdef.rlib"
"$SWEEP" --cap 1000 "$t" >/dev/null
[[ -f "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "under cap a recent superseded build stays warm" || chk fail "under cap a recent superseded build stays warm"
rm -rf "$t"

echo "cargo-target-sweep — a profile a cargo build holds is not touched"
t="$(new_target)"
touch "$t/debug/.cargo-lock"
ready="$t/locked"
perl -MFcntl=:flock -e 'open(my $h, "<", $ARGV[0]) or die; flock($h, LOCK_EX) or die; open(my $r, ">", $ARGV[1]); close $r; sleep 30' "$t/debug/.cargo-lock" "$ready" &
holder=$!
for _ in $(seq 50); do [[ -e "$ready" ]] && break; sleep 0.1; done
out="$("$SWEEP" --cap 0 "$t")"
[[ -f "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "a superseded build stays while cargo holds the profile" || chk fail "a superseded build stays while cargo holds the profile"
grep -q "skipped because a cargo build holds them" <<< "$out" && chk pass "the skip is reported" || chk fail "the skip is reported ($out)"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
"$SWEEP" --cap 0 "$t" >/dev/null
[[ ! -e "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "the same build goes once the lock is free" || chk fail "the same build goes once the lock is free"
rm -rf "$t"

echo "cargo-sweep-all — every project's target folder is found, and a full disk fails the run"
roots="$(mktemp -d)"
mkdir -p "$roots/a/target/debug" "$roots/a/target/fleet" "$roots/b/c/.claude/worktrees/w/target/fleet-check" "$roots/d/target" "$roots/a/target/debug/x/target"
touch "$roots/a/target/CACHEDIR.TAG" "$roots/a/target/fleet/CACHEDIR.TAG" "$roots/b/c/.claude/worktrees/w/target/CACHEDIR.TAG" \
      "$roots/b/c/.claude/worktrees/w/target/fleet-check/CACHEDIR.TAG" "$roots/a/target/debug/x/target/CACHEDIR.TAG"
stub="$roots/stub"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" >> "%s/args"\n' "$roots" > "$stub"
chmod +x "$stub"
out="$(HOME="$roots/nohome" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT="$stub" CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all")"
code=$?
args="$(cat "$roots/args" 2>/dev/null)"
grep -qx "$(cd "$roots/a/target" && pwd -P)" <<< "$args" && chk pass "a project's target folder is swept" || chk fail "a project's target folder is swept"
grep -qx "$(cd "$roots/b/c/.claude/worktrees/w/target" && pwd -P)/fleet-check" <<< "$args" && chk pass "a worktree's target and its fleet-check are swept" || chk fail "a worktree's target and its fleet-check are swept"
grep -qx "$(cd "$roots/a/target" && pwd -P)/fleet" <<< "$args" && chk pass "a target folder nested in a target folder (target/fleet) is swept" || chk fail "a target folder nested in a target folder (target/fleet) is swept"
grep -qx "$(cd "$roots/a/target" && pwd -P)/debug" <<< "$args" && chk fail "a profile folder is not swept as a target of its own" || chk pass "a profile folder is not swept as a target of its own"
grep -q "/d/target" <<< "$args" && chk fail "a folder named target without CACHEDIR.TAG is left alone" || chk pass "a folder named target without CACHEDIR.TAG is left alone"
grep -q "debug/x/target" <<< "$args" && chk fail "nothing is searched inside a target folder" || chk pass "nothing is searched inside a target folder"
(( code == 0 )) && chk pass "a run with room passes" || chk fail "a run with room passes ($code: $out)"
out="$(HOME="$roots/nohome" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT="$stub" CARGO_SWEEP_FLOOR_GB=1000000 "$script_dir/cargo-sweep-all")"
code=$?
(( code != 0 )) && grep -q "under the 1000000GB floor" <<< "$out" && chk pass "a volume under the floor fails the run and says so" || chk fail "a volume under the floor fails the run and says so ($code: $out)"
rm -rf "$roots"

echo "cargo-sweep-all — build output whose owner is finished or gone is swept without unlinking Cargo locks"
roots="$(mktemp -d)"
g() { git -c user.name=t -c user.email=t@t -c init.defaultBranch=main "$@" >/dev/null 2>&1; }
repo="$roots/proj"
mkdir -p "$repo" && g -C "$repo" init && g -C "$repo" commit --allow-empty -m one
g -C "$repo" branch merged && g -C "$repo" branch open && g -C "$repo" checkout -q main
g -C "$repo" worktree add "$roots/proj-merged" merged
g -C "$repo" worktree add "$roots/proj-open" open && g -C "$roots/proj-open" commit --allow-empty -m wip
g -C "$repo" worktree add --detach "$roots/proj-detached"
g -C "$repo" worktree add "$roots/proj-fresh" -b fresh
for tree in proj proj-merged proj-open proj-detached proj-fresh; do
  mkdir -p "$roots/$tree/target/debug" && touch "$roots/$tree/target/.rustc_info.json" "$roots/$tree/Cargo.toml"
done
mkdir -p "$roots/cache/gate-622-target/debug" "$roots/cache/fresh-target/debug"
touch "$roots/cache/gate-622-target/.rustc_info.json" "$roots/cache/fresh-target/.rustc_info.json"
find "$roots"/proj*/target "$roots/cache/gate-622-target" -exec touch -t 202001010000 {} +
touch "$roots/proj-fresh/target/debug/new"
home="$roots/home"
mkdir -p "$home/.cargo/build/proj/aa/gone" "$home/.cargo/build/proj/bb/live" "$home/.cargo/build/proj/cc/nomarker" "$home/.cargo/build/proj/dd/empty"
touch "$home/.cargo/build/proj/aa/gone/CACHEDIR.TAG" "$home/.cargo/build/proj/bb/live/CACHEDIR.TAG" "$home/.cargo/build/proj/cc/nomarker/CACHEDIR.TAG"
printf '%s\n' "$roots/deleted-checkout" > "$home/.cargo/build/proj/aa/gone/.checkout"
printf '%s\n' "$repo" > "$home/.cargo/build/proj/bb/live/.checkout"
stub="$roots/stub"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" >> "%s/args"\n[[ "$1" == --empty ]] && printf "%%s\\n" "$@" >> "%s/emptied"\nexit 0\n' "$roots" "$roots" > "$stub" && chmod +x "$stub"
HOME="$home" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT="$stub" CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all" >/dev/null
args="$(cat "$roots/args" 2>/dev/null)"
emptied="$(cat "$roots/emptied" 2>/dev/null)"
real() { cd "$1" && pwd -P; }
grep -qx "$(real "$roots/proj-merged/target")" <<< "$emptied" && chk pass "a merged worktree's target is emptied" || chk fail "a merged worktree's target is emptied"
grep -qx "$(real "$roots/proj-detached/target")" <<< "$emptied" && chk pass "an idle detached checkout on main is emptied" || chk fail "an idle detached checkout on main is emptied"
grep -qx "$(real "$roots/cache/gate-622-target")" <<< "$emptied" && chk pass "an idle target no project owns is emptied" || chk fail "an idle target no project owns is emptied"
grep -qx "$home/.cargo/build/proj/aa/gone" <<< "$emptied" && chk pass "a build-dir whose checkout is gone is emptied" || chk fail "a build-dir whose checkout is gone is emptied"
for kept in proj proj-open proj-fresh; do
  grep -qx "$(real "$roots/$kept/target")" <<< "$emptied" && chk fail "$kept keeps its builds" || chk pass "$kept keeps its builds"
done
grep -qx "$(real "$roots/cache/fresh-target")" <<< "$emptied" && chk fail "a recently built target no project owns keeps its builds" || chk pass "a recently built target no project owns keeps its builds"
[[ -d "$roots/proj-merged/target" ]] && grep -qx "$(cd "$roots/proj-merged/target" && pwd -P)" <<< "$args" && chk pass "an idle merged worktree target is retained and swept" || chk fail "an idle merged worktree target is retained and swept"
[[ -d "$roots/proj-merged" ]] && chk pass "the worktree itself stays" || chk fail "the worktree itself stays"
[[ -d "$roots/proj-open/target" ]] && chk pass "a worktree on an unmerged branch keeps its target" || chk fail "a worktree on an unmerged branch keeps its target"
[[ -d "$roots/proj-detached/target" ]] && chk pass "a detached checkout keeps its target" || chk fail "a detached checkout keeps its target"
[[ -d "$roots/proj/target" ]] && chk pass "the main checkout keeps its target" || chk fail "the main checkout keeps its target"
[[ -d "$roots/proj-fresh/target" ]] && chk pass "a target built in the last days stays" || chk fail "a target built in the last days stays"
[[ -d "$roots/cache/gate-622-target" ]] && grep -qx "$(cd "$roots/cache/gate-622-target" && pwd -P)" <<< "$args" && chk pass "an idle unowned target is retained and swept" || chk fail "an idle unowned target is retained and swept"
[[ -d "$roots/cache/fresh-target" ]] && chk pass "a recently built target no project owns stays" || chk fail "a recently built target no project owns stays"
[[ -d "$home/.cargo/build/proj/aa/gone" ]] && grep -qx "$home/.cargo/build/proj/aa/gone" <<< "$args" && chk pass "a cargo build-dir whose checkout is gone is retained and swept" || chk fail "a cargo build-dir whose checkout is gone is retained and swept"
[[ -d "$home/.cargo/build/proj/bb/live" ]] && grep -qx "$home/.cargo/build/proj/bb/live" <<< "$args" && chk pass "a cargo build-dir whose checkout exists is kept and swept" || chk fail "a cargo build-dir whose checkout exists is kept and swept"
grep -qx "$home/.cargo/build/proj/cc/nomarker" <<< "$args" && grep -qx -- "--remove-idle" <<< "$args" && chk pass "a cargo build-dir with no .checkout is swept with idle removal" || chk fail "a cargo build-dir with no .checkout is swept with idle removal"
grep -q "dd/empty" <<< "$args" && chk fail "a hash folder with no cargo output is left alone" || chk pass "a hash folder with no cargo output is left alone"
rm -rf "$roots"

echo "cargo-sweep-all — with no roots given, every project beside this checkout is searched, and --dry-run deletes nothing"
projects="$(cd "$script_dir/../../.." && pwd -P)"
listed="$(CARGO_SWEEP_SCRIPT=/bin/echo CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all" --dry-run | tr ' ' '\n' | grep -E '(^|/)[^/]*target(/[^/]+)?$')"
outside="$(grep -v -e "^$projects/" -e "^$HOME/" -e "^$(cd "$HOME/projects" 2>/dev/null && pwd -P)/" <<< "$listed")"
[[ -z "$outside" ]] && chk pass "every swept folder is under the projects folder or home" || chk fail "every swept folder is under the projects folder or home (outside: $outside)"
grep -q "^$projects/" <<< "$listed" && chk pass "the projects folder that holds this checkout is searched" || chk fail "the projects folder that holds this checkout is searched"
roots="$(mktemp -d)"
mkdir -p "$roots/old/target/debug" && touch "$roots/old/target/.rustc_info.json" && find "$roots/old" -exec touch -t 202001010000 {} +
out="$(HOME="$roots/nohome" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT=true CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all" --dry-run)"
[[ -d "$roots/old/target" ]] && grep -q "would empty" <<< "$out" && chk pass "a dry run names an idle unowned target and keeps it" || chk fail "a dry run names an idle unowned target and keeps it ($out)"
rm -rf "$roots"

echo "cargo-target-sweep — unreferenced compiler objects are reclaimed without breaking debugging"
t="$(new_target)"
object="$t/debug/deps/mike-0123456789abcdef.codegen.session.rcgu.o"
printf 'obsolete object\n' > "$object"
"$SWEEP" --cap 1000 "$t" >/dev/null
[[ -f "$object" ]] && chk pass "recent objects remain warm under cap" || chk fail "recent objects remain warm under cap"
"$SWEEP" --cap 0 --dry-run "$t" > "$t/preview"
[[ -f "$object" ]] && grep -q '1 unreferenced compiler object' "$t/preview" && chk pass "dry run previews recent unreferenced objects without deleting them" || chk fail "dry run previews recent unreferenced objects without deleting them"
"$SWEEP" --cap 0 "$t" >/dev/null
code=$?
[[ ! -e "$object" ]] && chk pass "over cap an unreferenced object is removed" || chk fail "over cap an unreferenced object is removed"
(( code != 0 )) && chk pass "a directory still over cap returns failure" || chk fail "a directory still over cap returns failure"
mkdir -p "$t/debugging/deps"
printf 'keep explicit debugging output\n' > "$t/debugging/deps/mike-0123456789abcdef.codegen.session.rcgu.o"
"$SWEEP" --cap 0 "$t" >/dev/null
[[ -f "$t/debugging/deps/mike-0123456789abcdef.codegen.session.rcgu.o" ]] && chk pass "explicit debugging profile keeps its objects" || chk fail "explicit debugging profile keeps its objects"
rm -rf "$t"

echo "cargo-target-sweep — Cargo locks protect objects and guarded incremental cleanup"
t="$(new_target)"
mkdir -p "$t/.guard"
touch "$t/debug/.cargo-build-lock"
object="$t/debug/deps/mike-0123456789abcdef.codegen.session.rcgu.o"
printf 'object\n' > "$object"
ready="$t/locked"
perl -MFcntl=:flock -e 'open(my $h, "<", $ARGV[0]) or die; flock($h, LOCK_EX) or die; open(my $r, ">", $ARGV[1]); close $r; sleep 30' "$t/debug/.cargo-build-lock" "$ready" &
holder=$!
for _ in $(seq 50); do [[ -e "$ready" ]] && break; sleep 0.1; done
"$SWEEP" --cap 0 "$t" >/dev/null
[[ -f "$object" && -d "$t/debug/incremental/mike-3mflii7unhj8b" ]] && chk pass "held profile lock protects objects and incremental state even with sweep guard" || chk fail "held profile lock protects objects and incremental state even with sweep guard"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
"$SWEEP" --cap 0 "$t" >/dev/null
[[ ! -e "$object" && ! -d "$t/debug/incremental" ]] && chk pass "both are reclaimed after the Cargo lock is released" || chk fail "both are reclaimed after the Cargo lock is released"
rm -rf "$t"

echo "cargo-target-sweep — lock failures fail closed"
t="$(new_target)"
ln -s "$t/missing" "$t/debug/.cargo-lock"
"$SWEEP" --cap 1000 "$t" > "$t/log" 2>&1
code=$?
(( code != 0 )) && [[ -f "$t/debug/deps/libserde-0123456789abcdef.rlib" ]] && chk pass "cannot acquire a real lock fails the sweep and preserves candidates" || chk fail "cannot acquire a real lock fails the sweep and preserves candidates"
rm -rf "$t"

if [[ "$(uname -s)" == Darwin ]]; then
  echo "cargo-target-sweep — current Mach-O debug maps keep required compiler objects"
  t="$(new_target)"
  object="$t/debug/deps/mike-0123456789abcdef.codegen.session.rcgu.o"
  printf 'int kept(void); int native_kept(void); int main(void) { return kept() + native_kept(); }\n' > "$t/main.c"
  printf 'int kept(void) { return 0; }\n' > "$t/library.c"
  archive="$t/debug/deps/libcached-0123456789abcdef.rlib"
  native_dir="$t/debug/build/native-0123456789abcdef"
  mkdir -p "$native_dir" "$t/debug/build/native-fedcba9876543210"
  printf 'int native_kept(void) { return 0; }\n' > "$t/native.c"
  if cc -g -c "$t/main.c" -o "$object" && cc -g -c "$t/library.c" -o "$t/library.o" && ar rcs "$archive" "$t/library.o" && cc -g -c "$t/native.c" -o "$t/native.o" && ar rcs "$native_dir/libnative.a" "$t/native.o" && cc -g "$object" "$archive" "$native_dir/libnative.a" -o "$t/debug/current"; then
    orphan="$t/debug/deps/mike-0123456789abcdef.old.session.rcgu.o"
    cp "$object" "$orphan"
    cp "$archive" "$t/debug/deps/libcached-fedcba9876543210.rlib"
    touch -t 202001010000 "$archive" "$native_dir"
    "$SWEEP" --cap 0 "$t" >/dev/null
    [[ -f "$object" && ! -e "$orphan" ]] && chk pass "current binary keeps its referenced unpacked debug object while an orphan goes" || chk fail "current binary keeps its referenced unpacked debug object while an orphan goes"
    [[ -f "$archive" ]] && chk pass "a current binary preserves its debug archive even when its crate hash is superseded" || chk fail "a current binary preserves its debug archive even when its crate hash is superseded"
    [[ -f "$native_dir/libnative.a" ]] && chk pass "a referenced native archive protects its superseded build-script directory" || chk fail "a referenced native archive protects its superseded build-script directory"
    mkdir -p "$t/bin"
    printf '#!/bin/sh\nexit 1\n' > "$t/bin/nm"
    chmod +x "$t/bin/nm"
    cp "$object" "$orphan"
    PATH="$t/bin:$PATH" "$SWEEP" --cap 0 "$t" > "$t/nm-failure" 2>&1
    code=$?
    (( code != 0 )) && [[ -f "$orphan" ]] && chk pass "debug reference inspection failure preserves objects and fails the run" || chk fail "debug reference inspection failure preserves objects and fails the run"
  else
    chk fail "compile small native debug-map fixture"
  fi
  rm -rf "$t"
fi

echo "cargo-sweep-all — deeply nested worktrees are discovered"
roots="$(mktemp -d)"
deep="$roots/a/b/c/d/e/f/g/h/project/.claude/worktrees/active/target"
mkdir -p "$deep/debug"
touch "$deep/CACHEDIR.TAG"
out="$(HOME="$roots/nohome" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT=/bin/echo CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all" --dry-run)"
grep -q "$(cd "$deep" && pwd -P)" <<< "$out" && chk pass "active worktree beyond seven directory levels is found" || chk fail "active worktree beyond seven directory levels is found"
rm -rf "$roots"

echo "cargo-sweep-all — an idle session mbx folder is emptied, an active one is kept"
roots="$(mktemp -d)"
proj="$roots/project"
mkdir -p "$proj/target/debug" "$proj/target/mbx-old/debug/deps" "$proj/target/mbx-new/debug/deps"
touch "$proj/Cargo.toml" "$proj/target/CACHEDIR.TAG" "$proj/target/mbx-old/CACHEDIR.TAG" "$proj/target/mbx-new/CACHEDIR.TAG"
find "$proj/target/mbx-old" -exec touch -t 202001010000 {} +
out="$(HOME="$roots/nohome" CARGO_SWEEP_ROOTS="$roots" CARGO_SWEEP_SCRIPT=/bin/echo CARGO_SWEEP_FLOOR_GB=0 "$script_dir/cargo-sweep-all" --dry-run)"
grep -q "mbx-old: would empty, its session's mbx build folder" <<< "$out" \
  && chk pass "an mbx folder idle for a day is emptied" || chk fail "an mbx folder idle for a day is emptied"
grep -q "mbx-new: would empty" <<< "$out" \
  && chk fail "an mbx folder built in today is kept" || chk pass "an mbx folder built in today is kept"
rm -rf "$roots"

echo "────────────────────────────────────────"
echo "passed=$pass failed=$fail"
(( fail == 0 ))
