#!/usr/bin/env bash
# Runs the tests of the areas this branch and working tree changed, in every
# tier, by mapping each changed Rust path to a nextest filter.
#   scripts/test-area            run them
#   scripts/test-area --print    print the filter
#   scripts/test-area --print-command    print package/target commands
#   scripts/test-area --skip-default-checks    gate already ran the fast profile
#   scripts/test-area <base>     compare with <base> instead of origin/main
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1

exec python3 "$root/scripts/lib/rust_change_scope.py" area "$@"
