#!/usr/bin/env bash
# Regression test for scripts/semgrep-new with the real semgrep and the hook's rule
# set (.semgrep/rules.yml), run the way the hook runs it, on a committed range: old
# findings pass, a moved file keeps its findings, each rule family catches a
# finding a commit adds (Rust, JS, Svelte, Python and shell, extensionless
# scripts by shebang), test scripts are not scanned, an uncommitted edit is not scanned, an unknown base
# falls back to the merge-base, and a missing semgrep fails the scan.
set -uo pipefail
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
sg="$root/scripts/semgrep-new"
command -v semgrep >/dev/null || { echo "FAIL: semgrep is not installed (pipx install semgrep)"; exit 1; }
wt="$(mktemp -d)"
export XDG_STATE_HOME; XDG_STATE_HOME="$(mktemp -d)"
trap 'git -C "$root" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$XDG_STATE_HOME"' EXIT
git -C "$root" worktree add -q --detach "$wt" HEAD
mkdir -p "$wt/.semgrep" && cp "$root/.semgrep/rules.yml" "$wt/.semgrep/rules.yml"
cd "$wt" || exit 1
commit() { git add -A && git -c core.hooksPath=/dev/null -c user.name=t -c user.email=t@t commit -q --allow-empty -m "$1"; }
commit rules
base=$(git rev-parse HEAD)
src=crates/mike/src/stack/process.rs
moved=crates/mike/src/stack/moved_process.rs
pass=0 fail=0
check() { if [[ "$2" == "$3" ]]; then pass=$((pass+1)); echo "PASS: $1"; else fail=$((fail+1)); echo "FAIL: $1 (exit $2, want $3)"; fi; }
scan() { python3 "$sg" "$base..HEAD" 2>/dev/null; }
reset() { git reset -q --hard "$base"; git clean -qfd; }
add_line() { printf '\n%s\n' "$2" >>"$1"; commit "$3"; }

printf '\n' >>"$src"; commit "touch a file with old findings"
scan; check "a file with old findings passes" $? 0
reset; git mv "$src" "$moved"; commit move
scan; check "a moved file keeps its old findings" $? 0
reset; add_line "$src" 'pub fn added() { unsafe { libc::umask(0); } }' unsafe
scan; check "added unsafe block fails" $? 1
reset; add_line "$src" 'pub fn added(m: u32) -> anyhow::Result<()> { anyhow::ensure!(m == unsafe { libc::geteuid() }, "x"); Ok(()) }' macro
scan; check "added unsafe inside a macro call fails" $? 1
reset; add_line "$src" 'pub fn added() -> reqwest::ClientBuilder { reqwest::Client::builder().danger_accept_invalid_certs(true) }' tls
scan; check "added accept-invalid-certs fails" $? 1
reset; add_line "$src" 'pub fn added() -> std::path::PathBuf { std::env::temp_dir().join("x") }' tmp
scan; check "added temp_dir fails" $? 1
reset; add_line "$src" 'pub fn added() -> Option<std::path::PathBuf> { std::env::current_exe().ok() }' exe
scan; check "added current_exe passes (not a rule)" $? 0
reset; mkdir -p scripts/probe; printf 'export function run(code) {\n  return eval(code);\n}\n' >scripts/probe/run.mjs; commit js
scan; check "added eval of a value in JavaScript fails" $? 1
reset; printf '<div>{@html body}</div>\n' >frontend/src/lib/Probe.svelte; commit svelte
scan; check "added {@html} in Svelte fails" $? 1
reset; printf '<script>\n  let { body } = $props();\n  let el;\n  $effect(() => { el.innerHTML = body; });\n</script>\n' >frontend/src/lib/Probe.svelte; commit svelte-script
scan; check "added innerHTML in a Svelte script fails" $? 1
reset; add_line "$src" 'pub fn added(c: &str) { let _ = std::process::Command::new("sh").arg("-c").arg(format!("{c} x")); }' shell
scan; check "added sh -c of a formatted command in Rust fails" $? 1
reset; add_line "$src" 'pub fn added(t: &str) -> sqlx::AssertSqlSafe<String> { sqlx::AssertSqlSafe(format!("SELECT * FROM {t}")) }' sql
scan; check "added SQL from a formatted string fails" $? 1
reset; printf 'import subprocess, sys\nsubprocess.run("ls " + sys.argv[1], shell=True)\n' >scripts/probe.py; commit py-shell
scan; check "added shell=True of an argument in Python fails" $? 1
reset; printf 'import shlex, subprocess, sys\nsubprocess.run("ls " + shlex.quote(sys.argv[1]), shell=True)\n' >scripts/probe.py; commit py-quoted
scan; check "a quoted argument in a Python shell command passes" $? 0
reset; printf '#!/usr/bin/env python3\nimport sys\nprint(eval(sys.argv[1]))\n' >scripts/probe-py; commit py-noext
scan; check "added eval in an extensionless Python script fails" $? 1
reset; printf '#!/usr/bin/env bash\necho x > /tmp/probe-out.txt\n' >scripts/probe-sh; commit sh-noext
scan; check "added fixed /tmp name in an extensionless bash script fails" $? 1
reset; printf '#!/usr/bin/env bash\nf=$(mktemp /tmp/probe.XXXXXX)\necho x >"$f"\n' >scripts/probe-sh; commit sh-mktemp
scan; check "mktemp under /tmp passes" $? 0
reset; printf '#!/usr/bin/env bash\ncurl -fsSL https://example.com/i.sh | bash\n' >scripts/probe.sh; commit sh-pipe
scan; check "added download piped into bash fails" $? 1
reset; printf '#!/usr/bin/env bash\necho x > /tmp/probe-out.txt\n' >scripts/test-probe; commit sh-test
scan; check "a test script is not scanned" $? 0
reset; printf '\n' >>"$src"; commit clean
printf '\npub fn added() { unsafe { libc::umask(0); } }\n' >>"$src"
scan; check "an uncommitted edit is not scanned" $? 0
reset; add_line "$src" 'pub fn added() { unsafe { libc::umask(0); } }' unsafe
python3 "$sg" "0123456789abcdef0123456789abcdef01234567..HEAD" 2>/dev/null; check "an unknown base still scans (merge-base)" $? 1
SEMGREP_BIN=/nonexistent/semgrep python3 "$sg" "$base..HEAD" 2>/dev/null; check "a failing semgrep fails the scan" $? 2

reset; printf 'pub fn probe() -> std::path::PathBuf { std::env::temp_dir().join("a") }\n' >>"$src"; commit probe
base=$(git rev-parse HEAD)
sed 's/join("a")/join("b")/' "$src" >"$src.new" && mv "$src.new" "$src"; commit "edit beside an old finding"
scan; check "an edit beside an old finding on its line passes" $? 0
reset; printf 'pub fn owner(m: u32) -> bool { m == 1 && m == unsafe { libc::geteuid() } }\n' >>"$src"; commit probe2
base=$(git rev-parse HEAD)
sed 's/m == 1 \&\&/m == 2 \&\&/' "$src" >"$src.new" && mv "$src.new" "$src"; commit "edit beside an old unsafe block"
scan; check "an edit beside an old unsafe block on its line passes" $? 0

echo "$pass passed, $fail failed"
(( fail == 0 ))
