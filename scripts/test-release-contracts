#!/usr/bin/env bash
# Synthetic local release, recovery, publication and review regression suites.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONDONTWRITEBYTECODE=1
# The release tools refuse paths through a symlink, and macOS's temporary
# folders (/tmp, /var/folders) sit behind one, so the fixtures get the real path.
TMPDIR="$(cd -- "${TMPDIR:-/tmp}" && pwd -P)"
export TMPDIR
python3 -m unittest discover -s "${SCRIPT_DIR}/release" -p 'test*.py' -v
exec python3 -m unittest discover -s "${SCRIPT_DIR}/release" -p 'security_test*.py' -v
