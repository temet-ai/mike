#!/usr/bin/env bash
# sb-test — frontend test runner: typecheck + logic tests + Storybook browser tests.
#
# WHY THIS EXISTS
#   Single command for the full frontend test suite: svelte-check (typecheck),
#   vitest unit + integration projects, and the Storybook browser project
#   (*.stories.svelte, headless chromium, axe gate). Storybook is the source of
#   truth for components, so all tiers live here.
#
#   The machine thrash a prior session hit (load 100+, 42 chromium) came from N
#   concurrent browser pools (parallel agents). The rule is one vitest process
#   at a time. Unit + integration run first with normal Node parallelism, then
#   Storybook runs separately and serially. This keeps browser stability without
#   needlessly serializing logic tests or rerunning them for every theme.
#
#   Compare scripts/storybook-test-all-themes.mjs: that runs the FULL
#   Storybook suite across all themes (the per-theme matrix). This script
#   is the inner-loop runner: filtered, capped-parallel, cleanup-wrapped. Use this
#   while iterating.
#
# USAGE
#   scripts/sb-test [options] [filter ...]
#
#   filter ...        vitest file-path substrings (story or test stems), e.g.
#                       scripts/sb-test tabs-list popover-portal
#                     ⚠ QUOTE any filter containing [brackets] — an unquoted
#                       routes/steering/[id]/page is glob-expanded by zsh/bash
#                       (nomatch → the command aborts silently before vitest runs):
#                       scripts/sb-test 'routes/steering/[id]/page.stories'
#                     With no filter, runs typecheck + unit + integration +
#                     the whole Storybook suite.
#
#   --theme NAME      Run Storybook once under a single theme (STORYBOOK_THEME=NAME).
#   --themes[=a,b,c]  Run Storybook once per theme, SEQUENTIALLY. With no list, all
#                     themes discovered in frontend/src/app.css ([data-theme="x"]).
#   --unit            Run only the unit project (repeatable with other tier flags).
#   --integration     Run only the integration project.
#   --storybook       Run only the Storybook browser project.
#   --skip-typecheck  Skip svelte-check for a faster inner loop. This is not a gate.
#   --serial          Run Storybook one file at a time; the default.
#   --workers N       Enable Storybook browser parallelism (disables --serial;
#                     caution: causes 30s timeouts on visual snapshot-heavy files).
#   --batch NAME      Run one Storybook batch. A whole-suite Storybook pass is split
#                     into batches by area, each its own vitest run with a kept log.
#   --list-batches    Print each batch's name, file count and paths, then exit.
#   --update          Refresh visual baselines (VITEST_UPDATE_SNAPSHOTS=1).
#   --raw, --verbose  Stream full vitest stdio instead of the compact summary.
#   --junit DIR       Also write a JUnit XML per vitest pass into DIR
#                     (vitest-<label>.xml, per-test wall time). Used by
#                     scripts/test-timing; the console output is unchanged.
#   --json            Emit a structured verdict as the LAST line of stdout:
#                     {verdict, exit_code, failed_files[], failed_stories[],
#                      unhandled_errors[], counts:{passed,failed,skipped}, raw_log}.
#                     The human summary (same as default mode) still prints above
#                     it — nothing is suppressed, the JSON line is additive. Forces
#                     captured mode (--raw is ignored under --json: JSON needs the
#                     log to parse). raw_log points at the FULL combined log for
#                     this run (typecheck + every vitest pass) — the JSON summarizes,
#                     it never truncates; go to raw_log for full fidelity.
#   -h, --help        This help.
#
# OUTPUT (default)
#   Built for an agent caller: one line per pass — `[phase] ✓ …` on success, or
#   `[phase] ✗ FAIL (exit N)` + failing details on failure. A final
#   `sb-test: PASS|FAIL` verdict. Use --raw for the live stream, --json for a
#   structured verdict (see above) instead of hand-parsing this text.
#
# EXIT CODE
#   Non-zero if typecheck, any unit/integration test, or any Storybook run fails.
#   Nothing stops early: every tier, theme and batch runs, and the run ends with one
#   list of every failed test, every typecheck problem and every stalled file.
#
# STORYBOOK LOGS AND STALLS
#   Storybook streams test by test to frontend/test-results/sb-test/<time>/ and
#   prints its duration when it ends. Follow a running pass with tail -f. A pass
#   silent for SB_STALL_SECONDS (default 180) is killed. The tests it finished
#   still count, and the batch's unfinished files then run one at a time, so the
#   stuck file is named and the rest of the batch still reports.
#
# EXAMPLES
#   scripts/sb-test                                     # typecheck + logic + storybook
#   scripts/sb-test tabs-list tabs-content              # two stories, default theme
#   scripts/sb-test --themes dialog-content             # one story, all themes
#   scripts/sb-test --theme glacier popover-portal      # one story, one theme
#   scripts/sb-test --unit --skip-typecheck format      # fastest focused unit loop
#   scripts/sb-test --integration cacheIdb              # integration tier only
#   scripts/sb-test --storybook tabs-list               # browser tier only
#   scripts/sb-test --raw popover-portal                # full vitest output
#   scripts/sb-test --update SteererFleet               # refresh that story's baselines
#   scripts/sb-test --json timelineTurnView              # structured verdict, one filter
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SCRIPT_DIR")"
FRONTEND="${SB_FRONTEND_ROOT:-$REPO/frontend}"
APP_CSS="$FRONTEND/src/app.css"

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; /^set -euo/d'; }

# One kernel-held lock serializes complete runs; a private process group owns
# every browser/tool child. The supervisor never searches or kills by name.
if [[ "${1:-}" != "--owned-test-child" ]]; then
  exec python3 "$SCRIPT_DIR/lib/owned-test-runner.py" "$0" "$@"
fi
shift

# One line per batch: name, file count, then the path filters that select it.
# Every story file belongs to exactly one area and every area to one batch.
storybook_batches() {
  ( cd "$FRONTEND" && find src -type f -name '*.stories.*' ) | LC_ALL=C sort | awk -F/ -v size="$BATCH_SIZE" '
    {
      if ($2 == "lib" && $3 == "components") depth = 4
      else depth = 3
      area = $1
      for (i = 2; i <= depth && i <= NF; i++) area = area "/" $i
      if (NF > depth) area = area "/"
      if (!(area in count)) order[++areas] = area
      count[area]++
    }
    function emit() {
      if (!files) return
      printf "b%02d-%s\t%d\t%s\n", ++batch, label, files, paths
      files = 0; paths = ""
    }
    END {
      for (i = 1; i <= areas; i++) {
        area = order[i]
        if (files && files + count[area] > size) emit()
        if (!files) {
          label = area
          sub(/\/$/, "", label); sub(/.*\//, "", label); sub(/\..*/, "", label)
          gsub(/[^A-Za-z0-9_-]/, "", label)
        }
        files += count[area]
        paths = paths (paths == "" ? "" : " ") area
      }
      emit()
    }'
}

# The supervisor owns the whole group; this ends one batch and leaves the run alive.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do kill_tree "$child"; done
  kill -KILL "$pid" 2>/dev/null || true
}

# Runs vitest with its output going to $1, ending it if the file stops growing.
run_watched() {
  local log="$1" size=-1 now last pid status=0
  shift
  "$@" >"$log" 2>&1 </dev/null &
  pid=$!
  last=$SECONDS
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    now=$(wc -c <"$log")
    if (( now != size )); then
      size=$now
      last=$SECONDS
    elif (( SECONDS - last >= STALL_SECONDS )); then
      kill_tree "$pid"
      wait "$pid" 2>/dev/null || true
      return 124
    fi
  done
  wait "$pid" || status=$?
  return "$status"
}

# Every story file in a batch, from its space-separated path filters.
batch_files() {
  local path
  for path in $1; do
    ( cd "$FRONTEND" && find src -type f -name '*.stories.*' ) | grep -aF "$path" || true
  done | LC_ALL=C sort -u
}

# Adds a pass's failed tests and passed count to the end-of-run list.
record_results() { # $1 = clean log
  local count
  grep -aE '^ *(×|FAIL) ' "$1" | sed -E 's/^ *(×|FAIL) +//; s/ +[0-9]+ms$//' >>"$FAILED_LIST" || true
  count="$(grep -aE '^ +Tests +[0-9]' "$1" | tail -1 | sed -nE 's/.* ([0-9]+) passed.*/\1/p' || true)"
  TOTAL_PASSED=$(( TOTAL_PASSED + ${count:-0} ))
}

# After a stall: counts what the pass finished, then runs what it did not, file by
# file. The file it stopped in runs again, since it may have tests left.
retry_unfinished() { # $1 = suffix, $2 = theme, $3 = batch name, $4 = paths
  local suffix="$1" theme="$2" name="$3" paths="$4" file last="" n=0 finished
  local log="$LOG_DIR/storybook-$suffix-$name.log"
  local clean reached
  clean="$(mktemp "${TMPDIR:-/tmp}/sb-test-stall.XXXXXX")"
  reached="$(mktemp "${TMPDIR:-/tmp}/sb-test-reached.XXXXXX")"
  perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' "$log" >"$clean"
  grep -aE '^ *(✓|×) ' "$clean" | sed -E 's/^ *(✓|×) \|[^|]*\| ([^ ]+) > .*/\2/' >"$reached" || true
  last="$(tail -1 "$reached")"
  if [[ -n "$last" ]]; then
    finished="$(grep -aE '^ *✓ ' "$clean" | grep -avcF " $last > " || true)"
  else
    finished="$(grep -acE '^ *✓ ' "$clean" || true)"
  fi
  TOTAL_PASSED=$(( TOTAL_PASSED + ${finished:-0} ))
  FIRST_ATTEMPT=0
  while IFS= read -r file; do
    [[ "$file" != "$last" ]] && grep -qxF "$file" "$reached" && continue
    n=$(( n + 1 ))
    BATCH_FILTERS=("$file")
    run_vitest "storybook:$suffix:$name:retry-$n" "$theme" "${browser_args[@]}" || true
  done < <(batch_files "$paths")
  FIRST_ATTEMPT=1
  rm -f "$clean" "$reached"
}

print_summary() {
  local failed stalled
  failed="$(LC_ALL=C sort -u "$FAILED_LIST" | wc -l | tr -d ' ')"
  stalled="$(LC_ALL=C sort -u "$STALLED_LIST" | wc -l | tr -d ' ')"
  echo "sb-test: summary: $TOTAL_PASSED tests passed, $failed failed, $stalled stalled"
  if (( failed )); then
    echo "sb-test: every failure:"
    LC_ALL=C sort -u "$FAILED_LIST" | sed 's/^/  × /'
  fi
  if (( stalled )); then
    echo "sb-test: every stall:"
    LC_ALL=C sort -u "$STALLED_LIST" | sed 's/^/  ⏱ /'
  fi
}

vitest_in_frontend() { # Remaining args: env assignments, then --, then vitest args.
  local -a assignments=()
  while [[ "$1" != "--" ]]; do assignments+=("$1"); shift; done
  shift
  cd "$FRONTEND" && exec env ${assignments[@]+"${assignments[@]}"} pnpm exec vitest "$@"
}

discover_themes() {
  # Mirror scripts/storybook-test-all-themes.mjs / lint-tokens.mjs: parse
  # [data-theme="x"] selectors, after stripping block comments.
  perl -0777 -ne 's{/\*.*?\*/}{}gs; print "$1\n" while /\[data-theme\s*[~|^\$*]?=\s*["'"'"']([a-z0-9-]+)["'"'"']\s*\]/gi' "$APP_CSS" \
    | awk '!seen[$0]++'
}

# --- arg parsing ---------------------------------------------------------------
THEMES=()           # empty = default theme (no STORYBOOK_THEME)
declare -a FILTERS=()
UPDATE=0
RAW=0
JSON=0              # --json: structured verdict as the final stdout line; forces captured mode
JUNIT_DIR=""        # --junit DIR: additionally emit vitest-<label>.xml per pass
SERIAL=1            # default: --no-file-parallelism. Use --workers N to enable parallel mode.
WORKERS=6           # used only when --workers is passed explicitly (disables serial)
RUN_UNIT=0
RUN_INTEGRATION=0
RUN_STORYBOOK=0
EXPLICIT_TIERS=0
SKIP_TYPECHECK=0
BATCH_SIZE="${SB_BATCH_SIZE:-45}"
STALL_SECONDS="${SB_STALL_SECONDS:-180}"
ONLY_BATCH=""
LIST_BATCHES=0
LOG_DIR=""          # set for Storybook batches: their logs are kept here
declare -a BATCH_FILTERS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --raw|--verbose) RAW=1; shift ;;
    --json) JSON=1; shift ;;
    --junit) JUNIT_DIR="${2:?--junit needs a DIR}"; shift 2 ;;
    --update) UPDATE=1; shift ;;
    --serial) SERIAL=1; shift ;;
    --workers) WORKERS="${2:?--workers needs a COUNT}"; SERIAL=0; shift 2 ;;
    --unit) RUN_UNIT=1; EXPLICIT_TIERS=1; shift ;;
    --integration) RUN_INTEGRATION=1; EXPLICIT_TIERS=1; shift ;;
    --storybook) RUN_STORYBOOK=1; EXPLICIT_TIERS=1; shift ;;
    --skip-typecheck) SKIP_TYPECHECK=1; shift ;;
    --batch) ONLY_BATCH="${2:?--batch needs a NAME}"; RUN_STORYBOOK=1; EXPLICIT_TIERS=1; shift 2 ;;
    --list-batches) LIST_BATCHES=1; shift ;;
    --theme) THEMES=("${2:?--theme needs a NAME}"); shift 2 ;;
    --themes) mapfile -t THEMES < <(discover_themes); shift ;;
    --themes=*) IFS=',' read -r -a THEMES <<< "${1#*=}"; shift ;;
    --) shift; while [[ $# -gt 0 ]]; do FILTERS+=("$1"); shift; done ;;
    -*) echo "sb-test: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) FILTERS+=("$1"); shift ;;
  esac
done

if (( LIST_BATCHES )); then
  storybook_batches
  exit 0
fi

if [[ -n "$ONLY_BATCH" ]] && (( ${#FILTERS[@]} )); then
  echo "sb-test: --batch selects its own files; drop the filter" >&2
  exit 2
fi

if (( ! EXPLICIT_TIERS )); then
  RUN_UNIT=1
  RUN_INTEGRATION=1
  RUN_STORYBOOK=1
fi

if (( ${#THEMES[@]} > 0 && ! RUN_STORYBOOK )); then
  echo "sb-test: --theme/--themes requires the Storybook tier" >&2
  exit 2
fi

if (( UPDATE && ! RUN_STORYBOOK )); then
  echo "sb-test: --update requires the Storybook tier" >&2
  exit 2
fi

# --json needs a captured log to parse — --raw streams straight to the terminal
# with nothing captured, so the two are incompatible. --json wins.
JSON_LOG=""
if (( JSON )); then
  if (( RAW )); then echo "sb-test: --json forces captured mode; ignoring --raw" >&2; fi
  RAW=0
  JSON_LOG="$(mktemp "${TMPDIR:-/tmp}/sb-test-json.XXXXXX")"
fi

TOTAL_PASSED=0
TC_RC=0
FIRST_ATTEMPT=1
FAILED_LIST="$(mktemp "${TMPDIR:-/tmp}/sb-test-failed.XXXXXX")"
STALLED_LIST="$(mktemp "${TMPDIR:-/tmp}/sb-test-stalled.XXXXXX")"
trap 'rm -f "$FAILED_LIST" "$STALLED_LIST"' EXIT

# Appends a labelled copy of $1 (a phase log file) into the combined JSON_LOG,
# used only when --json is set (JSON_LOG is empty/unset otherwise).
append_json_log() {
  [[ -z "$JSON_LOG" ]] && return 0
  { printf '\n=== %s (rc=%s) ===\n' "$2" "$3"; cat "$1"; } >>"$JSON_LOG"
}

MATCHED_PHASES=0

run_vitest() { # $1 = label, $2 = theme, remaining args = vitest args.
  local label="$1" theme="$2"
  shift 2
  local -a env=()
  local -a args=(run "$@")
  [[ -n "$theme" ]] && env+=("STORYBOOK_THEME=$theme")
  (( UPDATE )) && env+=("VITEST_UPDATE_SNAPSHOTS=1")
  local reporter=default
  [[ -n "$LOG_DIR" ]] && reporter=verbose
  if [[ -n "$JUNIT_DIR" ]]; then
    mkdir -p "$JUNIT_DIR"
    args+=("--reporter=$reporter" --reporter=junit "--outputFile.junit=$JUNIT_DIR/vitest-${label//:/-}.xml")
  elif [[ -n "$LOG_DIR" ]]; then
    args+=("--reporter=$reporter")
  fi
  if (( ${#BATCH_FILTERS[@]} )); then
    args+=("${BATCH_FILTERS[@]}")
  elif (( ${#FILTERS[@]} )); then
    args+=(--passWithNoTests "${FILTERS[@]}")
  fi

  local log clean_log rc=0 started=$SECONDS
  if [[ -n "$LOG_DIR" ]]; then
    log="$LOG_DIR/${label//:/-}.log"
  else
    log="$(mktemp "${TMPDIR:-/tmp}/sb-test.XXXXXX")"
  fi
  if (( RAW )); then
    ( cd "$FRONTEND" && env ${env[@]+"${env[@]}"} pnpm exec vitest "${args[@]}" ) > >(tee "$log") 2>&1 || rc=$?
  elif [[ -n "$LOG_DIR" ]]; then
    run_watched "$log" vitest_in_frontend ${env[@]+"${env[@]}"} -- "${args[@]}" || rc=$?
  else
    ( cd "$FRONTEND" && env ${env[@]+"${env[@]}"} pnpm exec vitest "${args[@]}" ) >"$log" 2>&1 || rc=$?
  fi

  clean_log="$(mktemp "${TMPDIR:-/tmp}/sb-test-clean.XXXXXX")"
  perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' "$log" >"$clean_log"
  record_results "$clean_log"

  local files tests
  files="$(grep -aE '^ Test Files +' "$clean_log" | tail -1 | sed 's/^ *//' || true)"
  tests="$(grep -aE '^ +Tests +[0-9]' "$clean_log" | tail -1 | sed 's/^ *//' || true)"

  if (( rc == 0 )) && [[ -n "$tests" ]]; then
    (( MATCHED_PHASES += 1 ))
    (( RAW )) || printf '  [%s] ✓ %s | %s | %ds\n' "$label" "${files:-Test Files ?}" "$tests" "$(( SECONDS - started ))"
    append_json_log "$clean_log" "vitest:$label" "$rc"
    [[ -n "$LOG_DIR" ]] || rm -f "$log"
    rm -f "$clean_log"
    return 0
  fi

  if (( rc == 124 && ! RAW )); then
    printf '  [%s] ✗ STALLED: no output for %ds, stopped after %ds\n' "$label" "$STALL_SECONDS" "$(( SECONDS - started ))"
    tail -n 3 "$clean_log" | sed 's/^/    last: /'
    echo "    (full log: $log)"
    if (( ! FIRST_ATTEMPT )) || [[ ${#BATCH_FILTERS[@]} -eq 0 ]]; then
      printf '%s: %s\n' "$label" "${BATCH_FILTERS[*]:-${FILTERS[*]}}" >>"$STALLED_LIST"
    fi
    append_json_log "$clean_log" "vitest:$label" "$rc"
    rm -f "$clean_log"
    return "$rc"
  fi

  if (( rc == 0 && ${#FILTERS[@]} > 0 )); then
    (( RAW )) || printf '  [%s] - no matching tests\n' "$label"
    append_json_log "$clean_log" "vitest:$label" "$rc"
    rm -f "$log" "$clean_log"
    return 0
  fi

  local note=""
  if [[ -z "$tests" ]]; then note=' — no tests collected (check filter)'; fi
  (( RAW )) || printf '  [%s] ✗ FAIL (exit %d)%s\n' "$label" "$rc" "$note"
  # The lines an agent needs to act: failing files, failed-test names, assertions.
  if (( ! RAW )); then
    grep -aE '❯|×| FAIL |✗|AssertionError|Error:|Expected|Received|No test files found' "$clean_log" \
      | grep -avE '✓|passed' | sed 's/^/    /' || true
    echo "    (full log: $log — re-run with --raw for live output)"
  fi
  append_json_log "$clean_log" "vitest:$label" "$rc"
  rm -f "$clean_log"
  return "$(( rc == 0 ? 1 : rc ))"
}

# --fail-on-warnings is deliberate. Without it svelte-check exits 0 on any number
# of warnings, so unused CSS, a11y violations and Svelte-5 reactivity mistakes
# accumulate silently: this gate passed with 99 of them on 2026-08-28, and the
# only place they were visible was scrollback from `pnpm build`. A warning is
# either worth fixing or worth an explicit `<!-- svelte-ignore RULE -- reason -->`
# next to the code; neither of those is "leave it in the log".
SVELTE_CHECK_ARGS=(--tsconfig ./tsconfig.json --fail-on-warnings)

run_typecheck() {
  if (( RAW )); then
    ( cd "$FRONTEND" && pnpm exec svelte-kit sync && pnpm exec svelte-check "${SVELTE_CHECK_ARGS[@]}" )
    return $?
  fi
  local log rc=0
  log="$(mktemp "${TMPDIR:-/tmp}/sb-typecheck.XXXXXX")"
  (
    cd "$FRONTEND" &&
      pnpm exec svelte-kit sync &&
      pnpm exec svelte-check "${SVELTE_CHECK_ARGS[@]}"
  ) >"$log" 2>&1 || rc=$?
  if (( rc == 0 )); then
    printf '  [typecheck] ✓ svelte-kit sync + svelte-check clean\n'
    append_json_log "$log" "typecheck" "$rc"
    rm -f "$log"
  else
    printf '  [typecheck] ✗ FAIL (exit %d)\n' "$rc"
    # Warnings fail this step too, so the summary has to show Warn: lines as well
    # as errors, or a --fail-on-warnings failure prints an empty reason.
    grep -aE 'Error:|error TS|^Warn:' "$log" | sed 's/^/typecheck: /' >>"$FAILED_LIST" || true
    echo "    (full log: $log — re-run with: cd frontend && pnpm exec svelte-kit sync && pnpm exec svelte-check --fail-on-warnings)"
    append_json_log "$log" "typecheck" "$rc"
  fi
  return "$rc"
}

# Prints the structured verdict (last stdout line(s)) by parsing the combined
# JSON_LOG built by append_json_log. Only called when JSON=1. $1 = overall exit
# code. Parsing lives in Python (not awk/grep) because the shape — dedup'd file
# lists, summed counts across N runs, nested JSON — needs real data structures,
# not just line filters.
emit_json() {
  local exit_code="$1" verdict="pass"
  (( exit_code != 0 )) && verdict="fail"
  python3 - "$JSON_LOG" "$verdict" "$exit_code" "$FAILED_LIST" "$STALLED_LIST" <<'PYEOF'
import json, re, sys

log_path, verdict, exit_code = sys.argv[1], sys.argv[2], int(sys.argv[3])


def listed(path):
    with open(path, encoding="utf-8", errors="replace") as lines:
        return sorted({line.rstrip("\n") for line in lines if line.strip()})


try:
    text = open(log_path, encoding="utf-8", errors="replace").read()
except OSError:
    text = ""

passed = failed = skipped = 0
for line in re.findall(r"^\s*Tests\s+.*$", text, re.MULTILINE):
    for count, kind in re.findall(r"(\d+)\s+(failed|passed|skipped)", line):
        if kind == "failed":
            failed += int(count)
        elif kind == "passed":
            passed += int(count)
        elif kind == "skipped":
            skipped += int(count)

failed_files = []
for m in re.findall(r"^\s*FAIL\s+(?:\|[^|]*\|\s+)?(\S+)", text, re.MULTILINE):
    path = m.split(" > ")[0]
    if path not in failed_files:
        failed_files.append(path)
failed_stories = [f for f in failed_files if f.endswith((".stories.svelte", ".stories.ts"))]

# vitest brackets an "Unhandled Errors" / "Unhandled Rejection" section with a
# banner line of ⎯ characters; the first non-blank, non-banner line after it is
# the error summary we want (full detail stays in raw_log regardless).
unhandled_errors = []
lines = text.splitlines()
for i, line in enumerate(lines):
    if re.search(r"Unhandled (Rejection|Error)", line):
        for follow in lines[i + 1 : i + 6]:
            stripped = follow.strip().strip("⎯")
            if stripped and not re.fullmatch(r"[⎯\s]*", follow):
                if stripped not in unhandled_errors:
                    unhandled_errors.append(stripped)
                break

print(json.dumps({
    "verdict": verdict,
    "exit_code": exit_code,
    "failed_files": failed_files,
    "failed_stories": failed_stories,
    "failures": listed(sys.argv[4]),
    "stalled": listed(sys.argv[5]),
    "unhandled_errors": unhandled_errors,
    "counts": {"passed": passed, "failed": failed, "skipped": skipped},
    "raw_log": log_path,
}))
PYEOF
}

if (( ${#FILTERS[@]} == 0 && ! EXPLICIT_TIERS )); then
  browser_mode=$( (( SERIAL )) && echo "serial browser" || echo "browser x$WORKERS" )
  echo "sb-test: no filter — running full suite: typecheck + unit + integration + storybook ($browser_mode). Ctrl-C to abort." >&2
fi

# Typecheck runs once, before any vitest pass (independent of theme).
if (( SKIP_TYPECHECK )); then
  echo "sb-test: typecheck skipped (--skip-typecheck; not a gate)"
else
  echo "sb-test: typecheck"
  run_typecheck || TC_RC=$?
fi

# A filtered pass is one vitest run. A whole-suite pass or --batch runs by batch.
run_storybook_pass() { # $1 = label suffix, $2 = theme
  local suffix="$1" theme="$2" line name count paths matched=0 status=0 failed=0
  LOG_DIR="$FRONTEND/test-results/sb-test/$(date +%Y%m%d-%H%M%S)-$suffix"
  mkdir -p "$LOG_DIR"
  echo "sb-test: logs in $LOG_DIR"
  if (( ${#FILTERS[@]} )); then
    run_vitest "storybook:$suffix" "$theme" "${browser_args[@]}" || failed=$?
    LOG_DIR=""
    return "$failed"
  fi
  local -a batches=()
  while IFS= read -r line; do batches+=("$line"); done < <(storybook_batches)
  for line in "${batches[@]}"; do
    IFS=$'\t' read -r name count paths <<<"$line"
    [[ -n "$ONLY_BATCH" && "$name" != "$ONLY_BATCH" ]] && continue
    matched=1
    read -r -a BATCH_FILTERS <<<"$paths"
    status=0
    run_vitest "storybook:$suffix:$name" "$theme" "${browser_args[@]}" || status=$?
    (( status == 124 )) && retry_unfinished "$suffix" "$theme" "$name" "$paths"
    (( status == 0 )) || failed=$status
  done
  BATCH_FILTERS=()
  LOG_DIR=""
  if (( ! matched )); then
    echo "sb-test: no batch named $ONLY_BATCH (see --list-batches)" >&2
    return 2
  fi
  return "$failed"
}

rc=$TC_RC
declare -a node_projects=()
(( RUN_UNIT )) && node_projects+=(--project unit)
(( RUN_INTEGRATION )) && node_projects+=(--project integration)
if (( ${#node_projects[@]} )); then
  echo "sb-test: unit/integration | filters: ${FILTERS[*]:-<all>}"
  run_vitest "logic" "" "${node_projects[@]}" || rc=$?
fi

if (( RUN_STORYBOOK )); then
  declare -a browser_args=(--project storybook)
  if (( SERIAL )); then
    browser_args+=(--no-file-parallelism)
  else
    browser_args+=("--maxWorkers=$WORKERS" "--minWorkers=1")
  fi

  if (( ${#THEMES[@]} == 0 )); then
    echo "sb-test: storybook | default theme | filters: ${FILTERS[*]:-<all>}"
    run_storybook_pass "default" "" || rc=$?
  else
    echo "sb-test: storybook | themes: ${THEMES[*]} | filters: ${FILTERS[*]:-<all>}"
    for theme in "${THEMES[@]}"; do
      run_storybook_pass "$theme" "$theme" || rc=1
    done
  fi
fi

if (( rc == 0 && ${#FILTERS[@]} > 0 && MATCHED_PHASES == 0 )); then
  rc=1
  echo "sb-test: FAIL — no selected tier collected tests for filters: ${FILTERS[*]}"
fi

print_summary
(( rc == 0 )) && echo "sb-test: PASS" || echo "sb-test: FAIL (exit $rc)"
(( JSON )) && emit_json "$rc"
exit "$rc"
