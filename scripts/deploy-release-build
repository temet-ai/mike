#!/usr/bin/env bash
# Deploy the release build of a commit to this machine: the archive the
# release-alpha workflow builds on this target's own runner, installed with
# scripts/install-release, then the running mike restarted on it. The same
# bytes a release would ship, so a deploy and a release never differ.
#
#   scripts/deploy-release-build            # origin/main
#   scripts/deploy-release-build <sha>      # a commit with a finished build
#   scripts/deploy-release-build --no-restart
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO="${DEPLOY_RELEASE_BUILD_REPO:-$(dirname "$SCRIPT_DIR")}"
WORKFLOW=release-alpha.yml

# A checkout on an older branch would run an older copy of this script, which
# can refuse or misplace an install. Run main's copy instead.
if [ -z "${DEPLOY_RELEASE_BUILD_REPO:-}" ]; then
  git -C "$REPO" fetch -q origin main
  latest="$(mktemp)"
  git -C "$REPO" show origin/main:scripts/deploy-release-build > "$latest"
  if ! cmp -s "$latest" "${BASH_SOURCE[0]}"; then
    echo "==> Running origin/main's deploy-release-build"
    DEPLOY_RELEASE_BUILD_REPO="$REPO" exec bash "$latest" "$@"
  fi
  rm -f "$latest"
fi
restart=1
want=""
for arg in "$@"; do
  case "$arg" in
    --no-restart) restart=0 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) want="$arg" ;;
  esac
done

case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) target=x86_64-unknown-linux-gnu ;;
  Linux/aarch64) target=aarch64-unknown-linux-gnu ;;
  Darwin/arm64) target=aarch64-apple-darwin ;;
  *) echo "deploy-release-build: no release archive is built for $(uname -s)/$(uname -m)" >&2; exit 1 ;;
esac

git -C "$REPO" fetch -q origin main
main_sha="$(git -C "$REPO" rev-parse origin/main)"
sha="$(git -C "$REPO" rev-parse "${want:-$main_sha}^{commit}")"
short="$(git -C "$REPO" rev-parse --short=7 "$sha")"

# A run serves this machine when its build job for this target succeeded, or is still
# queued or running. Several machines deploying one commit share runs this way instead
# of each dispatching a full build; a dispatch builds only this machine's target.
run_for_target() {
  local wanted="$1" id
  for id in $(gh run list --workflow "$WORKFLOW" --commit "$sha" --event workflow_dispatch \
      --limit 10 --json databaseId --jq '.[].databaseId'); do
    if gh run view "$id" --json jobs --jq ".jobs[] | select(.name | contains(\"$target\")) | .conclusion" \
        | grep -qx "$wanted"; then
      echo "$id"
      return 0
    fi
  done
  return 1
}

run_id="$(run_for_target success || true)"
if [ -z "$run_id" ]; then
  run_id="$(run_for_target "" || true)"
  if [ -n "$run_id" ]; then
    echo "==> Joining run $run_id, already building $short for $target"
  else
    if [ "$sha" != "$main_sha" ]; then
      echo "deploy-release-build: $short has no build for $target and is not origin/main; the workflow builds a branch head only" >&2
      exit 1
    fi
    echo "==> Starting the release build of $short for $target"
    gh workflow run "$WORKFLOW" --ref main -f targets="$target"
    for _ in $(seq 36); do
      sleep 5
      run_id="$(run_for_target "" || true)"
      [ -n "$run_id" ] && break
    done
    [ -n "$run_id" ] || { echo "deploy-release-build: the dispatched run did not show a $target build" >&2; exit 1; }
  fi
  echo "==> Waiting for run $run_id"
  gh run watch "$run_id" --interval 120 >/dev/null || true
  run_for_target success >/dev/null || {
    echo "deploy-release-build: run $run_id did not build $target; see gh run view $run_id" >&2
    exit 1
  }
fi
echo "==> Using run $run_id for $short ($target)"

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
gh run download "$run_id" --name "mike-$target" --dir "$work/download"
mkdir "$work/candidate"
mv "$work/download/manifest-$target.json" "$work/candidate/manifest.json"
mv "$work/download/"*.tar.gz "$work/download/"*.tar.gz.sha256 "$work/candidate/"

# The installer must verify the archive with the evidence format of the commit
# that built it, not whatever branch this checkout happens to be on.
mkdir "$work/tools"
git -C "$REPO" archive "$sha" scripts | tar -x -C "$work/tools"
installer="$work/tools/scripts/install-release"
install_args=(--candidate "$work/candidate")
# Successive commits of main share a version; a deploy installs the next one
# over the last. Installers older than the flag still refuse a changed build.
if grep -q -- '--rebuild-same-version' "$work/tools/scripts/release/install.py"; then
  install_args+=(--rebuild-same-version)
fi
"$installer" "${install_args[@]}"

mike_bin="$HOME/.local/bin/mike"
"$mike_bin" --version | grep -q "($short," || {
  echo "deploy-release-build: installed mike reports $("$mike_bin" --version), not $short" >&2
  exit 1
}

usable_unit() {
  command -v systemctl >/dev/null 2>&1 || return 1
  local state
  state="$(systemctl --user is-enabled "$1" 2>/dev/null)" || [ -n "$state" ] || return 1
  case "$state" in masked|masked-runtime|not-found|"") return 1 ;; esac
  systemctl --user cat "$1" >/dev/null 2>&1
}

restart_unit() {
  echo "==> Restarting $1"
  systemctl --user restart "$1"
  systemctl --user is-active --quiet "$1" || { echo "deploy-release-build: $1 did not start" >&2; exit 1; }
}

# A machine runs mike either as mike.service on the installed binary, or as
# the dev stack's mike-stack-proxy, which runs .deploy/mike.deployed in its
# WorkingDirectory — the unit's checkout, which may not be this one. The binary
# goes there, the previous one kept beside it, so both run the same bytes.
deploy_stack_binary() {
  local unit_dir
  unit_dir="$(systemctl --user show -p WorkingDirectory --value mike-stack-proxy.service)"
  [ -n "$unit_dir" ] || unit_dir="$REPO"
  local deployed="$unit_dir/.deploy/mike.deployed"
  mkdir -p "$unit_dir/.deploy"
  [ -f "$deployed" ] && cp -p "$deployed" "$deployed.previous"
  cp -L "$(dirname "$mike_bin")/../lib/mike-archive/current/mike" "$deployed.new"
  mv "$deployed.new" "$deployed"
  printf '%s\n' "$sha" > "$deployed.commit"
  "$deployed" --version | grep -q "($short," || {
    echo "deploy-release-build: $deployed reports $("$deployed" --version), not $short" >&2
    exit 1
  }
}

if [ "$restart" = 1 ]; then
  if usable_unit mike.service; then
    restart_unit mike.service
  elif usable_unit mike-stack-proxy.service; then
    deploy_stack_binary
    restart_unit mike-stack-proxy.service
  else
    echo "==> No mike.service or mike-stack-proxy here; restart mike yourself to run $short"
  fi
fi
echo "deploy-release-build: $("$mike_bin" --version)"
