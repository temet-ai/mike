#!/usr/bin/env bash
# wiring-new: report code that ships unwired, with `mike structural wiring`.
#
#   wiring-new <base>..<head>      the findings the range adds (pre-push hook)
#   wiring-new --whole [<dir>] [<label>]
#                                  the findings of a whole tree, one count per kind,
#                                  recorded in $XDG_STATE_HOME/mike/wiring-counts.log
#
# Report only: the exit status is 0 whether or not a finding is reported, and also
# when no mike binary can run the scan (one line says so). The binary is
# $MIKE_WIRING_BIN, else the newest target/ build of this checkout, else the
# installed mike; the first that has `structural wiring` is used. The rules are
# .mike/structural/wiring.yml of this checkout (of <dir> for --whole when it has one).
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

find_binary() {
  local candidate
  local -a candidates=()
  if [[ -n "${MIKE_WIRING_BIN:-}" ]]; then
    candidates+=("$MIKE_WIRING_BIN")
  else
    while IFS= read -r candidate; do candidates+=("$candidate"); done < <(
      ls -t "$here"/target/debug/mike "$here"/target/release/mike "$here"/target/mbx-*/debug/mike 2>/dev/null)
    candidate="$(command -v mike 2>/dev/null || true)"
    [[ -n "$candidate" ]] && candidates+=("$candidate")
    candidates+=("$HOME/.local/bin/mike")
  fi
  for candidate in "${candidates[@]}"; do
    if [[ -x "$candidate" ]] && "$candidate" structural wiring --help >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

record() {
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/mike"
  mkdir -p "$state" 2>/dev/null || return 0
  printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >>"$state/$2" 2>/dev/null || true
}

if [[ $# -lt 1 ]]; then
  echo "usage: wiring-new <base>..<head> | --whole [<dir>] [<label>]" >&2
  exit 2
fi
if ! bin="$(find_binary)"; then
  echo "wiring-new: skipped; no mike binary here has 'structural wiring' (build one or set MIKE_WIRING_BIN)" >&2
  exit 0
fi

if [[ "$1" == "--whole" ]]; then
  dir="${2:-$PWD}"
  label="${3:-$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo -)}"
  rules="$dir/.mike/structural/wiring.yml"
  [[ -f "$rules" ]] || rules="$here/.mike/structural/wiring.yml"
  if ! json="$(cd "$dir" && "$bin" structural wiring --json --rules "$rules")"; then
    echo "wiring-new: the whole-tree scan could not run" >&2
    exit 0
  fi
  counts="$(python3 -c 'import json,sys; print(" ".join(f"{k}={v}" for k, v in json.load(sys.stdin)["counts"].items()))' <<<"$json")" || counts=""
  echo "wiring-counts: $label $counts"
  record "$label	$counts" wiring-counts.log
  exit 0
fi

range="$1"
rules="$here/.mike/structural/wiring.yml"
if ! out="$("$bin" structural wiring --range "$range" --rules "$rules" 2>&1)"; then
  echo "wiring-new: the scan of $range could not run:" >&2
  printf '%s\n' "$out" | tail -5 >&2
  exit 0
fi
printf '%s\n' "$out"
added="$(sed -n 's/^wiring: .*: \([0-9][0-9]*\) new$/\1/p' <<<"$out" | head -1)"
record "$PWD	$range	${added:-?} new" wiring-scans.log
exit 0
