#!/usr/bin/env python3
"""Register a checkout and keep its documents available through Mike MCP."""
import sys
sys.dont_write_bytecode = True  # an installed package is verified file by file
try:
    from knowledge.cli import main
except ModuleNotFoundError as error:
    if error.name == 'yaml':
        raise SystemExit('PyYAML is required: run uv run --with pyyaml scripts/mike-knowledge ...') from error
    raise

if __name__ == '__main__':
    main()
