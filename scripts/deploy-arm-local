#!/usr/bin/env bash
# Build the wanted commit for ARM64 Linux on this machine (deus) and install it here and on
# the other ARM64 hosts.
#
#   scripts/deploy-arm-local [--hosts "<host>:<checkout> ..."] [--ha <ssh host>]
#
# scripts/deploy-infra on omit writes the commit to $state/wanted and starts this in the
# systemd user unit mike-arm-deploy, then returns; nobody waits on it. It builds with
# `scripts/build-local-release aarch64-unknown-linux-gnu --deploy` in this checkout's one
# build worktree (.claude/worktrees/deploy-aarch64-unknown-linux-gnu, which keeps its
# target directory, so a commit rebuilds only what it changed) on every processor at the
# lowest priority, installs it here with scripts/deploy-release-build --local, then copies
# it to each host (default infra:projects/mike) and installs it there. Last it installs it
# on ha, Home Assistant's SSH add-on, with scripts/deploy-ha (--ha <ssh host>, or --ha ""
# to leave ha out); ha is optional, so an unreachable or failed ha never stops the deploy.
# A commit asked for while a build runs is built next, even when that build fails; the
# commits asked for in between are skipped.
#
# Its output goes to $state/deploy.log; follow it with: tail -f ~/.local/state/mike/arm-deploy/deploy.log
set -euo pipefail

die() { echo "deploy-arm-local: $*" >&2; exit 1; }

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
target=aarch64-unknown-linux-gnu
hosts="infra:projects/mike"
ha=ha
while [ $# -gt 0 ]; do
  case "$1" in
    --hosts) hosts="${2:?--hosts needs host:checkout pairs}"; shift 2 ;;
    --ha) ha="${2?--ha needs an ssh host, or \"\" to leave ha out}"; shift 2 ;;
    -h|--help) sed -n '2,19p' "$0"; exit 0 ;;
    *) die "unknown argument $1; see --help" ;;
  esac
done
[ "$(uname -s)/$(uname -m)" = Linux/aarch64 ] || die "this builds natively on ARM64 Linux; run scripts/deploy-infra instead"
for tool in mbx cargo-zigbuild python-zig mise; do
  command -v "$tool" >/dev/null || die "$tool is not on PATH; the deploy build needs mbx, cargo-zigbuild, zig (uv tool install ziglang) and mise"
done

state="${XDG_STATE_HOME:-$HOME/.local/state}/mike/arm-deploy"
mkdir -p "$state"
export MIKE_BUILD_JOBS="${MIKE_BUILD_JOBS:-$(nproc)}"

deploy_one() {
  local sha="$1" short="${1:0:9}" started=$SECONDS built pair host repo
  echo "==> Building $short for $target with $MIKE_BUILD_JOBS jobs"
  built="$("$script_dir/build-local-release" "$target" --deploy --sha "$sha" | sed -n 's/^Release build: //p' | tail -1)"
  built="${built% (already built)}"
  [ -f "$built/manifest-$target.json" ] || die "build-local-release printed no build directory"
  echo "==> Built $short in $((SECONDS - started))s; installing here"
  "$script_dir/deploy-release-build" --local "$built"
  for pair in $hosts; do
    host="${pair%%:*}" repo="${pair#*:}"
    # shellcheck disable=SC2029 # the paths are meant to expand on the host
    ssh "$host" "mkdir -p ~/mike-deploy/$short"
    scp -q "$built"/* "$host:mike-deploy/$short/"
    # shellcheck disable=SC2029 # the paths are meant to expand on the host
    ssh "$host" "cd ~/$repo && git fetch -q origin && git checkout -q --detach $sha && scripts/deploy-release-build --local ~/mike-deploy/$short"
    echo "==> Deployed $short to $host"
  done
  echo "$sha" > "$state/deployed"
  if [ -n "$ha" ]; then
    "$script_dir/deploy-ha" "$built" "$sha" --host "$ha" || echo "==> ha was not updated to $short; deus and infra run it"
  fi
  echo "==> Deployed $short to $(hostname) and $hosts in $((SECONDS - started))s"
}

# Build the newest main rather than the commit asked for when that commit is an ancestor of
# it: omit applies migrations as soon as it deploys, so a 35-minute build of an older commit
# would be refused for a migration it lacks.
newest_main() {
  local asked="$1" latest
  git -C "$script_dir/.." fetch -q origin 2>/dev/null || { echo "$asked"; return; }
  latest="$(git -C "$script_dir/.." rev-parse origin/main 2>/dev/null)" || { echo "$asked"; return; }
  if [ "$latest" != "$asked" ] && git -C "$script_dir/.." merge-base --is-ancestor "$asked" "$latest"; then
    echo "==> ${asked:0:9} is behind main; building ${latest:0:9}" >&2
    echo "$latest" > "$state/wanted"
    echo "$latest"
  else
    echo "$asked"
  fi
}

# A build that fails is not retried, but a commit asked for while it ran still is: the loop
# ends only when the wanted commit is deployed or is the one that just failed.
failed=""
while :; do
  wanted="$(cat "$state/wanted" 2>/dev/null || true)"
  [ -n "$wanted" ] || die "no commit in $state/wanted"
  wanted="$(newest_main "$wanted")"
  [ "$wanted" != "$(cat "$state/deployed" 2>/dev/null || true)" ] || break
  [ "$wanted" != "$failed" ] || die "${wanted:0:9} failed; nothing newer was asked for"
  if ! (deploy_one "$wanted"); then
    echo "==> ${wanted:0:9} failed; building the newest commit asked for, if any"
    failed="$wanted"
  fi
done
