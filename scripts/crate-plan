#!/usr/bin/env python3
"""crate-plan — grade crate mike against the target crate map of ADR 0002.

Every source file under crates/mike/src is placed in a target crate by the
longest matching path prefix in docs/adr/0002-crate-map.json. A reference is a
`crate::` path (brace imports expanded one level) or a call of a PersistHandle
method, attributed to the crate of the file that defines the method. A
reference from a lower crate to a higher one is a seam: it must be cut before
the lower crate can be extracted. The scan is textual, not a compiler query.

  scripts/crate-plan                 crates and sizes, seams, recompile replay
  scripts/crate-plan --seams N       list the N largest seams (default 30)
  scripts/crate-plan --detail A B    every symbol behind the seam A -> B
  scripts/crate-plan --matrix        downward dependencies between crates
  scripts/crate-plan --blame         which crates' changes cost the most
  scripts/crate-plan --stages        the staged plan, graded stage by stage
  scripts/crate-plan --map FILE      grade another map
  scripts/crate-plan --stage NAME    grade a stage's grouping (a key of `stages`)
  scripts/crate-plan --check         fail when production seams exceed the ratchet
                                     recorded in the map (ratchet.crate_seams)

Replay: for each commit on origin/main that touched crates/mike/src, the
crates it touched plus every crate depending on them (production references
only; a test-only reference rebuilds just that crate's tests) are summed in
lines, against the whole crate today. Lines are a proxy for compile time.
"""

import collections
import json
import os
import re
import subprocess
import sys

REPO = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
SRC = os.path.join(REPO, "crates", "mike", "src")
# Crate mike's sources across the crates it has been split into so far. A file is
# keyed by its path under its crate's src/, which is its module path; facade files
# (generated re-exports, docs/adr/0002) carry no code of their own and are skipped.
SRCS = [SRC] + [os.path.join(REPO, "crates", c, "src") for c in ("mike-base", "mike-features")]
SRC_PREFIXES = ("crates/mike/src/", "crates/mike-base/src/", "crates/mike-features/src/")
DEFAULT_MAP = os.path.join(REPO, "docs", "adr", "0002-crate-map.json")
PATH = re.compile(r"crate::(\w+(?:::\w+)*)(?!::|\w)")
BRACE = re.compile(r"crate::((?:\w+::)+)\{([^{}]*)\}")
CALL = re.compile(r"\.(\w+)\s*\(")
IMPL = re.compile(r"\nimpl (?:PersistHandle|crate::store::persistence::\w+_repo::\w+Db<'_>) \{(.*?)\n\}", re.S)
# An inherent impl on the handle outside the crate that defines it cannot compile
# once db is its own crate: those methods go on the crate's repo (persist.<crate>()).
HANDLE_IMPL = re.compile(r"^impl PersistHandle\s*\{", re.M)
METHOD = re.compile(r"\n    pub(?:\([^)]*\))? (?:async )?fn (\w+)")


ITEM = re.compile(r"^\s*pub(?:\([^)]*\))?\s+(?:async\s+)?(?:const\s+fn|fn|struct|enum|trait|type|const|static|mod)\s+(\w+)", re.M)
GLOB = re.compile(r"^\s*pub(?:\([^)]*\))?\s+use\s+(?:self::)?(\w+)::\*;", re.M)
NAMED = re.compile(r"^\s*pub(?:\([^)]*\))?\s+use\s+(?:self::)?(\w+)::(?:(\w+)|\{([^{}]*)\});", re.M)


def glob_index(files):
    """(module path, item) -> defining file, for items a module re-exports with
    `pub use child::*`, so `api::handlers::x` resolves to the child that defines x."""
    by_module = {}
    for rel in files:
        by_module.setdefault(tuple(module_of(rel)), rel)
    index = {}
    for rel, text in files.items():
        module = module_of(rel)
        for child in GLOB.findall(text):
            child_rel = by_module.get(tuple(module + [child]))
            if child_rel is None:
                continue
            for item in ITEM.findall(files[child_rel]):
                index.setdefault((tuple(module), item), child_rel)
        for child, one, many in NAMED.findall(text):
            child_rel = by_module.get(tuple(module + [child]))
            if child_rel is None:
                continue
            for item in [one] if one else many.split(","):
                item = item.strip().split(" as ")[-1].strip()
                if re.fullmatch(r"\w+", item or ""):
                    index.setdefault((tuple(module), item), child_rel)
    return index


class Map:
    def __init__(self, cfg):
        self.order = cfg["order"]
        self.rank = {c: i for i, c in enumerate(self.order)}
        self.rules = sorted(cfg["rules"].items(), key=lambda kv: -len(kv[0]))
        self.stages = cfg.get("stages", {})

    def crate_of_path(self, rel):
        key = re.sub(r"/mod$", "", re.sub(r"\.rs$", "", rel))
        for prefix, crate in self.rules:
            if key == prefix or key.startswith(prefix + "/"):
                return crate
            rest = key[len(prefix):]
            if key.startswith(prefix + "_") and "/" not in rest:
                return crate
        return None

    globs = {}

    def crate_of_modpath(self, parts):
        for n in range(len(parts) - 1, 0, -1):
            defined = self.globs.get((tuple(parts[:n]), parts[n]))
            if defined:
                return self.crate_of_path(defined)
        for n in range(len(parts), 0, -1):
            crate = self.crate_of_path("/".join(parts[:n]))
            if crate:
                return crate
        return None


def is_test(rel, text):
    base = os.path.basename(rel)
    return (re.search(r"(^|_)tests?(_\d+)?\.rs$", base) is not None
            or "/tests/" in rel or "#![cfg(test)]" in text[:200])


def read_sources():
    files = {}
    facades = {}
    for root in SRCS:
        for directory, _, names in os.walk(root):
            for name in names:
                if name.endswith(".rs"):
                    path = os.path.join(directory, name)
                    with open(path, encoding="utf-8") as handle:
                        text = handle.read()
                    rel = os.path.relpath(path, root)
                    if text.startswith("//! Facade:"):
                        facades.setdefault(rel, []).append(text)
                    else:
                        files[rel] = text
    # a facade's `pub use child::*` lines still tell the glob index where items live
    for rel, texts in facades.items():
        files[rel] = files.get(rel, "") + "\n" + "\n".join(texts)
    return files


def method_crates(cmap, files):
    owner, clash = {}, set()
    for rel, text in files.items():
        crate = cmap.crate_of_path(rel)
        for block in IMPL.finditer(text):
            for match in METHOD.finditer(block.group(1)):
                name = match.group(1)
                if owner.get(name, crate) != crate:
                    clash.add(name)
                owner[name] = crate
    return {k: v for k, v in owner.items() if k not in clash}


INLINE_TEST = re.compile(r"#\[cfg\(test\)\]\s*(?:#\[[^\]]*\]\s*)*mod\s+\w+\s*\{")
RELATIVE = re.compile(r"(?<![\w:])((?:super::)+|self::)((?:\w+::)*)(\{[^{}]*\}|\w+)")


def module_of(rel):
    """The module path of a file: a/b/mod.rs and a/b.rs are a::b; a sibling test
    file a/b_tests.rs, declared as `mod tests` inside b, is a::b::tests."""
    parts = re.sub(r"\.rs$", "", rel).split("/")
    if parts[-1] in ("mod", "lib", "main"):
        parts = parts[:-1]
    elif parts[-1].endswith("_tests"):
        parts = parts[:-1] + [parts[-1][: -len("_tests")], "tests"]
    return parts


def relative_refs(cmap, rel, text, inline=False):
    # inside an inline `mod tests { .. }`, super:: is the file's own module
    base_module = module_of(rel) + (["tests"] if inline else [])
    for match in RELATIVE.finditer(text):
        prefix, middle, tail = match.groups()
        ups = prefix.count("super::")
        if ups > len(base_module):
            continue
        base = base_module[: len(base_module) - ups] if ups else base_module
        head = base + [p for p in middle.split("::") if p]
        items = tail[1:-1].split(",") if tail.startswith("{") else [tail]
        for item in items:
            item = item.strip().split(" as ")[0].split("::")[0].strip()
            if item and item not in ("self", "*") and head:
                parts = head + [item]
                yield cmap.crate_of_modpath(parts), "::".join(parts)


CHILD_MOD = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+(\w+)\s*;", re.M)


def child_refs(cmap, rel, text):
    """Bare paths to a module's own children (`change_record::X` in a mod.rs that
    declares `mod change_record;`), which cross crates when a child maps elsewhere."""
    children = set(CHILD_MOD.findall(text))
    if not children:
        return
    base = module_of(rel)
    pattern = re.compile(r"(?<![\w:])(" + "|".join(map(re.escape, children)) + r")::(\w+(?:::\w+)*)")
    for match in pattern.finditer(text):
        parts = base + [match.group(1)] + match.group(2).split("::")
        yield cmap.crate_of_modpath(parts), "::".join(parts)


def file_refs(cmap, methods, text, rel=None, inline=False):
    if rel is not None:
        yield from relative_refs(cmap, rel, text, inline)
        yield from child_refs(cmap, rel, text)
    for match in BRACE.finditer(text):
        for item in match.group(2).split(","):
            item = item.strip().split(" as ")[0].strip()
            if item and item != "self":
                parts = [p for p in (match.group(1) + item).split("::") if p]
                yield cmap.crate_of_modpath(parts), "::".join(parts)
    for match in PATH.finditer(text):
        yield cmap.crate_of_modpath(match.group(1).split("::")), match.group(1)
    for match in CALL.finditer(text):
        crate = methods.get(match.group(1))
        if crate:
            yield crate, "." + match.group(1) + "()"


# the files behind each seam, filled by scan() for --detail
SITES = collections.defaultdict(collections.Counter)


def scan(cmap, files):
    cmap.globs = glob_index(files)
    methods = method_crates(cmap, files)
    lines = collections.Counter()
    edges = collections.defaultdict(collections.Counter)
    SITES.clear()
    for rel, raw in files.items():
        src = cmap.crate_of_path(rel)
        lines[src] += raw.count("\n")
        text = re.sub(r"//[^\n]*", "", raw)
        whole_test = is_test(rel, text)
        # An inline `#[cfg(test)] mod tests { .. }` at the end of a production file
        # is test code: everything from the first such block on counts as test.
        cut = INLINE_TEST.search(text)
        parts = [(text, True, False)] if whole_test else (
            [(text[: cut.start()], False, False), (text[cut.start():], True, True)] if cut
            else [(text, False, False)])
        handle_crate = cmap.crate_of_path("store/persistence/mod.rs")
        if src != handle_crate:
            for _ in HANDLE_IMPL.finditer(text):
                edges[(handle_crate, src, "prod")]["impl PersistHandle"] += 1
                SITES[(handle_crate, src, "prod")][rel] += 1
        for part, test, inline in parts:
            kind = "test" if test else "prod"
            for dst, symbol in file_refs(cmap, methods, part, rel, inline):
                if dst and dst != src:
                    edges[(src, dst, kind)][symbol] += 1
                    SITES[(src, dst, kind)][rel] += 1
    return lines, edges


def history(cmap):
    out = subprocess.run(["git", "-C", REPO, "log", "origin/main", "--name-only",
                          "--format=%x40%x40", "--", *(p.rstrip("/") for p in SRC_PREFIXES)],
                         capture_output=True, text=True, check=False).stdout
    commits, current = [], set()
    for line in out.splitlines():
        if line == "@@":
            if current:
                commits.append(current)
            current = set()
        elif line.startswith(SRC_PREFIXES):
            prefix = next(p for p in SRC_PREFIXES if line.startswith(p))
            crate = cmap.crate_of_path(line[len(prefix):])
            if crate:
                current.add(crate)
    if current:
        commits.append(current)
    return commits


class Graph:
    def __init__(self, cmap, edges):
        self.prod = collections.defaultdict(set)
        self.test = collections.defaultdict(set)
        for (src, dst, kind) in edges:
            if cmap.rank[src] > cmap.rank[dst]:
                (self.prod if kind == "prod" else self.test)[dst].add(src)
        self.memo = {}

    def dependents(self, crate):
        if crate not in self.memo:
            seen, todo = {crate}, [crate]
            while todo:
                for user in self.prod[todo.pop()]:
                    if user not in seen:
                        seen.add(user)
                        todo.append(user)
            self.memo[crate] = seen
        return self.memo[crate]

    def rebuilt(self, touched):
        hit = set()
        for crate in touched:
            hit |= self.dependents(crate)
        for crate in list(hit):
            hit |= self.test[crate]
        return hit


def seams(cmap, edges):
    found = [(sum(v.values()), a, b, k) for (a, b, k), v in edges.items()
             if a in cmap.rank and b in cmap.rank and cmap.rank[a] < cmap.rank[b]]
    return sorted(found, reverse=True)


def replay(lines, graph, commits):
    costs = sorted(sum(lines[c] for c in graph.rebuilt(t)) for t in commits)
    return costs


def summary(cmap, lines, edges, commits):
    total = sum(lines.values())
    found = seams(cmap, edges)
    prod = [s for s in found if s[3] == "prod"]
    test = [s for s in found if s[3] == "test"]
    costs = replay(lines, Graph(cmap, edges), commits)
    mean = sum(costs) / max(len(costs), 1)
    return {
        "crates": len(cmap.order), "total": total,
        "prod": (sum(s[0] for s in prod), len(prod)),
        "test": (sum(s[0] for s in test), len(test)),
        "mean": mean, "pct": 100 * mean / total if total else 0,
        "median": costs[len(costs) // 2] if costs else 0, "commits": len(costs),
    }


def print_summary(cmap, lines, edges, commits, nseams):
    for crate in cmap.order:
        print(f"  {cmap.rank[crate]:2} {crate:12} {lines[crate]:8,}")
    s = summary(cmap, lines, edges, commits)
    print(f"\nseams: production {s['prod'][0]} references in {s['prod'][1]} edges, "
          f"test {s['test'][0]} in {s['test'][1]}")
    for n, a, b, k in seams(cmap, edges)[:nseams]:
        top = ", ".join(sym for sym, _ in edges[(a, b, k)].most_common(3))
        print(f"  {n:4} {k:4} {a} -> {b}: {top}")
    print(f"\nreplay of {s['commits']} commits: mean {s['mean']:,.0f} lines recompiled "
          f"({s['pct']:.0f}% of today's {s['total']:,}), median {s['median']:,}")


def print_matrix(cmap, edges):
    print("downward dependencies (production + test references):")
    for a in cmap.order:
        row = []
        for b in cmap.order:
            if cmap.rank[a] > cmap.rank[b]:
                p = sum(edges[(a, b, "prod")].values())
                t = sum(edges[(a, b, "test")].values())
                if p or t:
                    row.append(f"{b}:{p}" + (f"+{t}t" if t else ""))
        print(f"  {a:12} -> {' '.join(row)}")


def print_blame(cmap, lines, edges, commits):
    graph = Graph(cmap, edges)
    touches = collections.Counter(c for t in commits for c in t)
    total = sum(sum(lines[c] for c in graph.rebuilt(t)) for t in commits) or 1
    print("crate: commits touching x lines rebuilt when it changes = share of the replay cost")
    rows = []
    for crate in cmap.order:
        cost = sum(lines[c] for c in graph.dependents(crate))
        rows.append((touches[crate] * cost, crate, touches[crate], cost))
    for share, crate, n, cost in sorted(rows, reverse=True):
        print(f"  {crate:12} {n:4} x {cost:9,} = {100 * share / total:5.1f}%")


def staged_map(cfg, groups):
    names, of = [], {}
    for group in groups:
        name = "+".join(group)
        names.append(name)
        for crate in group:
            of[crate] = name
    order = sorted(names, key=lambda n: min(cfg["order"].index(c) for c in n.split("+")))
    return Map({"order": order, "rules": {k: of[v] for k, v in cfg["rules"].items()}})


def print_stages(cfg, files, commits):
    print("stage                           crates  production seams   mean recompile")
    stages = dict(cfg.get("stages", {}))
    stages["full target"] = [[c] for c in cfg["order"]]
    for name, groups in stages.items():
        cmap = staged_map(cfg, groups)
        lines, edges = scan(cmap, files)
        s = summary(cmap, lines, edges, history(cmap))
        print(f"  {name:30} {s['crates']:4}   {s['prod'][0]:5} in {s['prod'][1]:3} edges   "
              f"{s['pct']:3.0f}% of today")


def ratchet_check(cfg, cmap, files):
    limit = cfg.get("ratchet", {}).get("crate_seams")
    _, edges = scan(cmap, files)
    now = sum(s[0] for s in seams(cmap, edges) if s[3] == "prod")
    if limit is None:
        print(f"crate-plan: no ratchet recorded; production seams {now}")
        return 0
    if now > limit:
        print(f"crate-plan: FAIL production seams {now} > ratchet {limit}: a change added "
              f"references from a lower target crate to a higher one (scripts/crate-plan --seams 20)")
        return 1
    note = f"; lower ratchet.crate_seams in {os.path.relpath(DEFAULT_MAP, REPO)} to {now}" if now < limit else ""
    print(f"crate-plan: PASS production seams {now} <= ratchet {limit}{note}")
    return 0


def main(argv):
    args = list(argv)
    path = DEFAULT_MAP
    if "--map" in args:
        path = args[args.index("--map") + 1]
    with open(path, encoding="utf-8") as handle:
        cfg = json.load(handle)
    cmap = Map(cfg)
    if "--stage" in args:
        name = args[args.index("--stage") + 1]
        cmap = staged_map(cfg, cfg["stages"][name])
    files = read_sources()
    missing = sorted({r.split("/")[0] for r in files if not cmap.crate_of_path(r)})
    if missing:
        print("not in the map (add a rule):", " ".join(missing))
    if "--check" in args:
        return ratchet_check(cfg, cmap, files)
    if "--stages" in args:
        print_stages(cfg, files, None)
        return 0
    lines, edges = scan(cmap, files)
    commits = history(cmap)
    if "--detail" in args:
        i = args.index("--detail")
        a, b = args[i + 1], args[i + 2]
        for kind in ("prod", "test"):
            for symbol, n in edges[(a, b, kind)].most_common():
                print(f"  {kind} {n:4} {symbol}")
            for rel, n in SITES[(a, b, kind)].most_common():
                print(f"  {kind} {n:4} in {rel}")
        return 0
    if "--matrix" in args:
        print_matrix(cmap, edges)
        return 0
    if "--blame" in args:
        print_blame(cmap, lines, edges, commits)
        return 0
    nseams = int(args[args.index("--seams") + 1]) if "--seams" in args else 30
    print_summary(cmap, lines, edges, commits, nseams)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
