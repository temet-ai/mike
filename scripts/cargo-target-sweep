#!/usr/bin/env bash
# cargo-target-sweep — keep Rust build directories under a size cap.
#
# Cargo never deletes anything from a build directory. Every dependency version
# ever built and every incremental session stays, so a checkout's target/ grows
# past 150GB and a machine with a few projects and fleet clones fills its disk
# (2026-10-07: 925 of 930GB used on omit, the test Postgres crashed mid-write).
#
# Usage: cargo-target-sweep [--cap GB] [--age DAYS] [--remove-idle DAYS] [--dry-run] [DIR ...]
#
#   DIR        Build directories to sweep. Default: $CARGO_TARGET_DIR, else this
#              checkout's target/. A DIR may be a target dir or a cargo build-dir.
#   --cap GB   Size each DIR should end under (default $CARGO_SWEEP_MAXSIZE_GB or 40:
#              this machine has about ten build folders, and at 80 each they may
#              hold more than either of its disks; 2026-10-22).
#   --age DAYS Superseded builds older than this are removed (default 3).
#   --remove-idle DAYS
#              Legacy idle hint: sweep an idle DIR, retaining its Cargo lock
#              files. Whole-directory deletion can race a build waiting on the
#              old lock inode, so idle directories are no longer removed whole.
#   --empty    The DIRs belong to finished checkouts: remove every build in each
#              profile, keeping only its Cargo lock files (taken without waiting,
#              so a profile a build holds is skipped).
#   --dry-run  Report sizes and what would go, delete nothing.
#
# Otherwise, for each DIR:
#   1. always, unreferenced rcgu.o objects and superseded builds: in deps/, .fingerprint/, build/ and incremental/, an
#      entry named <crate>-<hash> (cargo's 16 hex characters; in incremental/,
#      rustc's base-36 crate id) that is older than --age days while a newer
#      entry for the same crate sits beside it. The newest build of every crate
#      is always kept, so dependencies still in use stay warm; old dependency
#      versions and feature sets go. Modification time, not access time: data
#      disks here are mounted noatime.
#   2. when still over --cap, superseded builds of any age: the same rule as 1
#      without the age limit, so a project that rebuilds many times a day (radar:
#      4,610 test binaries in three days, 2026-10-20) still comes under its cap.
#   macOS objects referenced by linked Mach-O binaries are retained for unpacked
#   debug info; failure to inspect references fails closed. The debugging profile
#   always retains its rcgu.o files.
#   Rules 1 and 2 delete in a profile (debug/, release/, …) only while holding
#   that profile's cargo locks (.cargo-lock, .cargo-build-lock), taken without
#   waiting: a profile a build holds is skipped, and no build starts in it until
#   the deletion is done. "Newest per crate" is not enough on its own: a crate
#   built several ways at once (tests, clippy, release, feature mixes) has an
#   entry per way, and an in-flight clippy run lost its fingerprints to a sweep
#   that kept only the newest (radar, 2026-10-20 11:37).
#   3. when still over --cap, every incremental directory. Only in a directory whose builds take turns
#      with sweeps through scripts/lib/target-dir-guard.sh (scripts/cx does),
#      and while holding that profile's Cargo locks, because deleting state a
#      build is using fails that build.
# Anything still over cap is reported, never forced. The only cost of a sweep
# is a slower next build.
#
# Exit 0 when within the cap (including busy skips), 1 on failure or over cap,
# and 2 for usage errors. Dry runs report candidates without enforcing the cap.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
# shellcheck disable=SC1091
source "$script_dir/lib/target-dir-guard.sh"

cap_gb="${CARGO_SWEEP_MAXSIZE_GB:-40}"
age_days="${CARGO_SWEEP_AGE_DAYS:-3}"
dry_run=0
empty=0
idle_days=""
dirs=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cap)     cap_gb="${2:?--cap needs a value}"; shift 2 ;;
    --age)     age_days="${2:?--age needs a value}"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    --empty)   empty=1; shift ;;
    --remove-idle) idle_days="${2:?--remove-idle needs a number of days}"; shift 2 ;;
    -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        echo "cargo-target-sweep: unknown option $1" >&2; exit 2 ;;
    *)         dirs+=("$1"); shift ;;
  esac
done
for numeric in "$cap_gb" "$age_days" "${idle_days:-0}"; do
  if [[ ! "$numeric" =~ ^[0-9]+$ ]]; then
    echo "cargo-target-sweep: cap and ages must be non-negative integers" >&2
    exit 2
  fi
done
[[ ${#dirs[@]} -gt 0 ]] || dirs=("${CARGO_TARGET_DIR:-$repo_root/target}")

count_file="$(mktemp)"
trap 'rm -f "$count_file"' EXIT

ts() { date '+%Y-%m-%d %H:%M:%S'; }
size_kb() { du -sk "$1" 2>/dev/null | awk '{print $1}'; }
human() { awk -v k="${1:-0}" 'BEGIN{ if (k>=1048576) printf "%.1fG", k/1048576; else if (k>=1024) printf "%.1fM", k/1024; else printf "%dK", k }'; }

profiles_of() {
  find "$1" -mindepth 1 -maxdepth 3 -type d \( -name deps -o -name .fingerprint \) -print 2>/dev/null | sed 's#/[^/]*$##' | sort -u
}

busy_profiles=0
remove_profiles() {
  local dir="$1" mode="$2" profile result code total=0 objects=0 incremental=0 n o i
  busy_profiles=0
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    result="$(python3 "$script_dir/lib/cargo-profile-sweep.py" "$profile" "$mode" "$age_days" "$dry_run")"
    code=$?
    if (( code == 75 )); then
      busy_profiles=$((busy_profiles + 1))
    elif (( code != 0 )); then
      sweep_failed=1
    fi
    read -r n o i <<< "${result:-0 0 0}"
    total=$((total + ${n:-0})); objects=$((objects + ${o:-0})); incremental=$((incremental + ${i:-0}))
  done <<< "$(profiles_of "$dir")"
  printf '%d %d %d' "$total" "$objects" "$incremental"
}

empty_dir() {
  local dir="$1" before after removed unused
  sweep_failed=0
  before="$(size_kb "$dir")"
  remove_profiles "$dir" all > "$count_file"
  read -r removed unused unused < "$count_file"
  after="$(size_kb "$dir")"
  local verb="emptied" detail
  (( dry_run )) && verb="would empty"
  detail="$(human "$before") -> $(human "$after"), ${removed} item(s), its checkout is finished"
  (( busy_profiles > 0 )) && detail="${detail}; ${busy_profiles} profile(s) skipped because a cargo build holds them"
  if (( sweep_failed )); then
    echo "$(ts) [cargo-sweep] $dir: FAILED: $detail"
    return 1
  fi
  echo "$(ts) [cargo-sweep] $dir: $verb: $detail"
}

sweep_dir() {
  local dir="$1" guarded="$2"
  local cap_kb=$((cap_gb * 1048576))
  local before after removed objects wiped recent=0 more_objects unused busy=0
  sweep_failed=0
  before="$(size_kb "$dir")" || { echo "cargo-sweep: cannot measure $dir" >&2; return 1; }
  if (( dry_run && before > cap_kb )); then
    age_days=0 remove_profiles "$dir" stale > "$count_file"
  else
    remove_profiles "$dir" stale > "$count_file"
  fi
  read -r removed objects wiped < "$count_file"
  busy=$busy_profiles
  after="$(size_kb "$dir")" || { echo "cargo-sweep: cannot measure $dir" >&2; return 1; }
  if (( ${after:-0} > cap_kb )); then
    # The dry run already previewed the pressure pass; do not count it twice.
    if (( ! dry_run )); then
      age_days=0 remove_profiles "$dir" stale > "$count_file"
      read -r recent more_objects unused < "$count_file"
      (( busy_profiles > busy )) && busy=$busy_profiles
      removed=$((removed + recent)); objects=$((objects + more_objects))
      after="$(size_kb "$dir")" || { echo "cargo-sweep: cannot measure $dir" >&2; return 1; }
    fi
    if (( ${after:-0} > cap_kb && guarded )); then
      remove_profiles "$dir" incremental > "$count_file"
      read -r unused unused wiped < "$count_file"
      (( busy_profiles > busy )) && busy=$busy_profiles
      after="$(size_kb "$dir")" || { echo "cargo-sweep: cannot measure $dir" >&2; return 1; }
    fi
  fi
  if [[ -z "$after" ]]; then echo "cargo-sweep: cannot measure $dir" >&2; return 1; fi
  local verb="swept"
  (( dry_run )) && verb="would sweep"
  local detail="$(human "$before") -> $(human "$after"), ${removed} superseded build(s), ${objects} unreferenced compiler object(s), ${wiped} incremental dir(s)"
  (( busy > 0 )) && detail="${detail}; ${busy} profile(s) skipped because a cargo build holds them"
  if (( sweep_failed )); then
    echo "$(ts) [cargo-sweep] $dir: FAILED: $detail"
    return 1
  elif (( after > cap_kb && ! dry_run )); then
    echo "$(ts) [cargo-sweep] $dir: OVER CAP ${cap_gb}G after sweep; retained current artifacts or busy profiles: $detail"
    return 1
  elif (( removed + objects + wiped == 0 )); then
    echo "$(ts) [cargo-sweep] $dir: nothing to remove, $(human "$after") of ${cap_gb}G; $detail"
  else
    echo "$(ts) [cargo-sweep] $dir: $verb: $detail"
  fi
  return 0
}

status=0
for dir in "${dirs[@]}"; do
  if [[ ! -d "$dir" ]]; then
    echo "$(ts) [cargo-sweep] $dir: not a directory, skipped"
    continue
  fi
  if (( empty )); then
    empty_dir "$dir" || status=1
    continue
  fi
  if [[ -n "$idle_days" ]] && [[ -z "$(find "$dir" -mtime -"$idle_days" -print 2>/dev/null | head -1)" ]]; then
    echo "$(ts) [cargo-sweep] $dir: idle for ${idle_days}d; retaining Cargo lock files and sweeping artifacts"
  fi
  guarded=0
  if [[ -d "$dir/.guard" ]] && (( ! dry_run )); then
    if CARGO_TARGET_DIR="$dir" guard_sweep_enter; then
      guarded=1
    else
      echo "$(ts) [cargo-sweep] $dir: builds still running or another sweep holds the slot; removing only stale items"
    fi
  fi
  sweep_dir "$dir" "$guarded" || status=1
  (( guarded )) && CARGO_TARGET_DIR="$dir" guard_sweep_leave
done
exit "$status"
