[Unit]
Description=mike web UI (vite dev, :9990)
Documentation=file://@PROJECT_ROOT@/docs/ARCHITECTURE.md
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/frontend
Environment=PATH=@PATH@
Environment=CI=true
ExecStart=/usr/bin/env pnpm run start
UnsetEnvironment=CLAUDE_CODE_SESSION_ID
Restart=always
RestartSec=3
StandardOutput=append:@PROJECT_ROOT@/.deploy/spa.log
StandardError=append:@PROJECT_ROOT@/.deploy/spa.log

[Install]
WantedBy=default.target
