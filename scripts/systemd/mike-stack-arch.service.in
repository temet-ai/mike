[Unit]
Description=mike architecture diagrams (LikeC4 preview, :9986)
Documentation=file://@PROJECT_ROOT@/docs/architecture/README.md
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
Environment=PATH=@PATH@
Environment=ARCH_PORT=9986
ExecStart=@PROJECT_ROOT@/scripts/arch serve
UnsetEnvironment=CLAUDE_CODE_SESSION_ID OPENAI_API_KEY OPENROUTER_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY OLLAMA_HOST MINIMAX_API_KEY
Restart=always
RestartSec=3
StandardOutput=append:@PROJECT_ROOT@/.deploy/arch.log
StandardError=append:@PROJECT_ROOT@/.deploy/arch.log

[Install]
WantedBy=default.target
