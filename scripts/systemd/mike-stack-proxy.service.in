[Unit]
Description=mike proxy + inspect API (:9988, :9989)
Documentation=file://@PROJECT_ROOT@/docs/ARCHITECTURE.md
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
Environment=PATH=@PATH@
Environment=MIKE_SPA_ENABLED=0
ExecStart=/usr/bin/env bash -c 'set -a; [ -f .env ] && . ./.env; set +a; exec .deploy/mike.deployed'
UnsetEnvironment=CLAUDE_CODE_SESSION_ID CLAUDE_EFFORT CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN MAX_THINKING_TOKENS
Restart=always
RestartSec=5
StandardOutput=append:@PROJECT_ROOT@/.deploy/mike.log
StandardError=append:@PROJECT_ROOT@/.deploy/mike.log

[Install]
WantedBy=default.target
