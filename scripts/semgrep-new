#!/usr/bin/env python3
"""Fail only on semgrep findings a change adds.

Usage:
  semgrep-new <base>..<head>          the files the range changes, as committed at <head>
  semgrep-new <base> <file>...        those files as they are in the working tree
  Either form may end with "-- <semgrep args>" to replace the rule set.

Each file is compared with its version at <base> (following renames, so a file
moved between crates keeps its old findings). A finding is its rule id plus the
exact source text the rule matched, whitespace removed, so neither a line that
moves nor an edit elsewhere on the same line makes an old finding new. Both sides are copied out of git into temporary directories and scanned the
same way, so a peer's uncommitted edit in a shared checkout never enters a range
scan.

The rules are the .semgrep/rules.yml beside this script's checkout, read from
disk: a scan needs no network, and a pushing branch that predates the rules
file is still scanned with them. A file without an extension is scanned as
shell or Python when its shebang names one (copied under a .sh or .py name,
since semgrep picks a language by extension only). Test files and test scripts
are not scanned. Exit 0 when nothing is new, 1 when a finding is new, 2
when the scan could not run (semgrep missing or failing, base unknown); the
hook fails on 1 and 2 alike.
"""

import collections
import json
import os
import pathlib
import re
import resource
import shutil
import subprocess
import sys
import tempfile

SCANNED = re.compile(r"\.(rs|ts|js|mjs|cjs|svelte|sh|bash|py)$")
NO_EXTENSION = re.compile(r"(^|/)[^/.]+$")
SHEBANG_SUFFIX = ((re.compile(rb"^#!.*\b(ba|z)?sh\b"), ".sh"), (re.compile(rb"^#!.*\bpython[0-9.]*\b"), ".py"))
NOT_SCANNED = re.compile(
    r"(^|/)tests?/|_tests?\.rs$|(^|/)test_support/|\.test\.(ts|js|mjs)$|\.stories\.svelte$|(^|/)node_modules/|(^|/)fixtures/"
    r"|(^|/)scripts/test-[^/]*$|(^|/)test_[^/]*\.py$|_test\.py$|(^|/)conftest\.py$"
)
SCAN_TIMEOUT_SECONDS = 900


class ScanError(Exception):
    pass


def git(*args, check=True):
    proc = subprocess.run(["git", *args], capture_output=True)
    if check and proc.returncode != 0:
        raise ScanError(f"git {' '.join(args)}: {proc.stderr.decode(errors='replace').strip()}")
    return proc


def git_text(*args):
    return git(*args).stdout.decode()


def is_commit(ref):
    return git("cat-file", "-e", f"{ref}^{{commit}}", check=False).returncode == 0


def resolve_base(base, head):
    if is_commit(base):
        return base
    for main in ("origin/main", "main"):
        if is_commit(main):
            fork = git("merge-base", main, head, check=False)
            if fork.returncode == 0:
                sys.stderr.write(f"semgrep-new: {base} is not here; comparing with merge-base of {main}\n")
                return fork.stdout.decode().strip()
    raise ScanError(f"base {base} is not a commit here; run git fetch")


def wanted(path):
    if NOT_SCANNED.search(path):
        return False
    return bool(SCANNED.search(path) or NO_EXTENSION.search(path))


def scan_name(path, data):
    if not NO_EXTENSION.search(path):
        return path
    first = data.split(b"\n", 1)[0]
    for shebang, suffix in SHEBANG_SUFFIX:
        if shebang.search(first):
            return path + suffix
    return None


def place(path, copied):
    for original, name in copied.items():
        if name == path:
            return original
    return path


def renames(base, head):
    args = ["diff", "-M", "--name-status", base] + ([head] if head else [])
    found = {}
    for line in git_text(*args).splitlines():
        parts = line.split("\t")
        if parts[0].startswith(("R", "C")) and len(parts) == 3:
            found[parts[2]] = parts[1]
    return found


def changed_files(base, head):
    out = git_text("diff", "--name-only", "--diff-filter=d", "--no-renames", base, head)
    return sorted(p for p in out.splitlines() if wanted(p))


def write_copy(root, path, data, copied):
    name = scan_name(path, data)
    if name is None:
        return
    dest = pathlib.Path(root) / name
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(data)
    copied[path] = name


def copy_from_git(ref, paths, root):
    copied = {}
    for path in paths:
        show = git("show", f"{ref}:{path}", check=False)
        if show.returncode == 0:
            write_copy(root, path, show.stdout, copied)
    return copied


def copy_from_tree(paths, root):
    copied = {}
    for path in paths:
        if os.path.isfile(path):
            write_copy(root, path, pathlib.Path(path).read_bytes(), copied)
    return copied


def raise_stack_limit():
    _, hard = resource.getrlimit(resource.RLIMIT_STACK)
    try:
        resource.setrlimit(resource.RLIMIT_STACK, (hard, hard))
    except (ValueError, OSError):
        pass


def scan(semgrep, root, files, rules):
    if not files:
        return []
    env = dict(os.environ, EIO_BACKEND="posix", SEMGREP_SEND_METRICS="off")
    cmd = [semgrep, "scan", "--metrics", "off", "--disable-version-check", "--quiet", "--json", *rules, *files]
    try:
        proc = subprocess.run(
            cmd, cwd=root, capture_output=True, text=True, env=env,
            preexec_fn=raise_stack_limit, timeout=SCAN_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as exc:
        raise ScanError(f"semgrep took longer than {SCAN_TIMEOUT_SECONDS}s") from exc
    except OSError as exc:
        raise ScanError(f"cannot run {semgrep}: {exc}") from exc
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr[-4000:])
        raise ScanError(f"semgrep exited {proc.returncode}")
    try:
        return json.loads(proc.stdout).get("results", [])
    except json.JSONDecodeError as exc:
        raise ScanError("semgrep printed no JSON") from exc


def keyed(results, root):
    out = collections.Counter()
    where = {}
    cache = {}
    for r in results:
        path = r["path"]
        if path not in cache:
            cache[path] = (pathlib.Path(root) / path).read_bytes()
        matched = cache[path][r["start"]["offset"] : r["end"]["offset"]].decode(errors="replace")
        rule = re.sub(r"^.*?\bmike\.", "mike.", r["check_id"])
        key = (rule, re.sub(r"\s+", "", matched))
        out[key] += 1
        where.setdefault(key, (f'{path}:{r["start"]["line"]}', r["extra"].get("message", "").strip()))
    return out, where


def find_semgrep():
    found = os.environ.get("SEMGREP_BIN") or shutil.which("semgrep")
    fallback = pathlib.Path.home() / ".local/bin/semgrep"
    if not found and fallback.is_file():
        found = str(fallback)
    if not found:
        raise ScanError("semgrep is not installed; install it with `pipx install semgrep` (or `brew install semgrep`)")
    return found


def run(argv):
    extra = None
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1 :]
    if not argv:
        raise SystemExit(__doc__)
    top = git_text("rev-parse", "--show-toplevel").strip()
    os.chdir(top)
    own_rules = pathlib.Path(__file__).resolve().parent.parent / ".semgrep" / "rules.yml"
    rules = extra if extra is not None else ["--config", str(own_rules)]
    if ".." in argv[0] and len(argv) == 1:
        base, head = argv[0].split("..", 1)
        head = head or "HEAD"
        base = resolve_base(base, head)
        files = changed_files(base, head)
    else:
        base, head = resolve_base(argv[0], "HEAD"), None
        files = [f for f in argv[1:] if wanted(f) or extra is not None]
    if not files:
        return 0
    semgrep = find_semgrep()
    moved = renames(base, head)
    with tempfile.TemporaryDirectory() as new_root, tempfile.TemporaryDirectory() as old_root:
        new_files = copy_from_git(head, files, new_root) if head else copy_from_tree(files, new_root)
        new, where = keyed(scan(semgrep, new_root, sorted(new_files.values()), rules), new_root)
        old_files = copy_from_git(base, sorted({moved.get(f, f) for f in new_files}), old_root)
        old, _ = keyed(scan(semgrep, old_root, sorted(old_files.values()), rules), old_root)
    added = new - old
    for key, count in sorted(added.items(), key=lambda kv: where[kv[0]][0]):
        at, message = where[key]
        name, _, line = at.rpartition(":")
        print(f"semgrep-new: {place(name, new_files)}:{line} {key[0]} (+{count}): {message}", file=sys.stderr)
    return 1 if added else 0


def main(argv):
    try:
        return run(argv)
    except ScanError as exc:
        print(f"semgrep-new: the scan could not run: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
