#!/usr/bin/env bash
# Link ~/.claude/mods/<name> to the repository copy under mods/<name> for every
# mod, so a pull keeps the installed mods current.
#
#   scripts/install-mods [--with-wiretap] [--backup] [--dry-run]
#
# The target root is $HOME/.claude/mods (set HOME to test it). wiretap records
# every prompt and tool call to a file, so it is linked only with --with-wiretap.
# A directory or file already at a target is never changed or deleted: without
# --backup it is left as it is with a message; with --backup it is moved to
# <name>.bak-<timestamp> first. A link already pointing at the repository copy
# is left alone (the script is idempotent); a link pointing elsewhere is
# replaced. The script finishes by printing the CLAUDE_CODE_PLUGIN_DIRS value
# for the linked mods and writes that value to env.CLAUDE_CODE_PLUGIN_DIRS in
# $HOME/.claude/settings.json, changing no other key (entries outside the mods
# root are kept; an unreadable settings.json is left alone and exits 4).
set -u

with_wiretap=0
backup=0
dry=0
for arg in "$@"; do
  case "$arg" in
    --with-wiretap) with_wiretap=1 ;;
    --backup) backup=1 ;;
    --dry-run) dry=1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install-mods: unknown argument: $arg" >&2; exit 64 ;;
  esac
done

script_dir=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$script_dir/.." && pwd)
src_root="$repo/mods"
dest_root="${HOME:?install-mods: HOME is not set}/.claude/mods"

if [ ! -d "$src_root" ]; then
  echo "install-mods: no $src_root" >&2
  exit 1
fi

run() {
  if [ "$dry" = 1 ]; then echo "  would: $*"; else "$@"; fi
}

[ "$dry" = 1 ] || mkdir -p "$dest_root" || exit 1

stamp=$(date +%Y%m%d%H%M%S)
linked=""
skipped=0
for dir in "$src_root"/*/; do
  [ -f "${dir}.claude-plugin/plugin.json" ] || continue
  name=$(basename "$dir")
  src="$src_root/$name"
  dest="$dest_root/$name"
  if [ "$name" = wiretap ] && [ "$with_wiretap" = 0 ]; then
    echo "install-mods: $name skipped (records every prompt and tool call; pass --with-wiretap)"
    continue
  fi
  if [ -L "$dest" ]; then
    if [ "$(readlink "$dest")" = "$src" ]; then
      echo "install-mods: $name already linked"
    else
      echo "install-mods: $name relinked (was $(readlink "$dest"))"
      run rm "$dest" && run ln -s "$src" "$dest"
    fi
  elif [ -e "$dest" ]; then
    if [ "$backup" = 1 ]; then
      echo "install-mods: $name moved to $dest.bak-$stamp, then linked"
      run mv "$dest" "$dest.bak-$stamp" && run ln -s "$src" "$dest"
    else
      echo "install-mods: $name NOT linked: $dest exists and is not a link; left untouched (--backup moves it aside)"
      skipped=$((skipped + 1))
      continue
    fi
  else
    echo "install-mods: $name linked"
    run ln -s "$src" "$dest"
  fi
  linked="${linked:+$linked:}$dest"
done

echo
echo "CLAUDE_CODE_PLUGIN_DIRS=$linked"

settings_rc=0
if [ -n "$linked" ]; then
  if [ "$dry" = 1 ]; then
    echo "install-mods: would write env.CLAUDE_CODE_PLUGIN_DIRS in $HOME/.claude/settings.json"
  else
    settings="$HOME/.claude/settings.json"
    staged="$settings.install-mods.$$"
    python3 -I - "$settings" "$staged" "$dest_root" "$linked" <<'PY'
import json, os, sys

settings, staged, root, linked = sys.argv[1:5]
data = {}
if os.path.exists(settings):
    try:
        with open(settings) as f:
            data = json.load(f)
    except ValueError as err:
        print(f"install-mods: {settings} is not valid JSON ({err}); left untouched", file=sys.stderr)
        sys.exit(4)
    if not isinstance(data, dict) or not isinstance(data.get("env", {}), dict):
        print(f"install-mods: {settings} has an unexpected shape; left untouched", file=sys.stderr)
        sys.exit(4)
env = data.setdefault("env", {})
ours = [d for d in linked.split(":") if d]
kept = [
    d for d in str(env.get("CLAUDE_CODE_PLUGIN_DIRS", "")).split(":")
    if d and not d.startswith(root + "/") and d not in ours
]
value = ":".join(ours + kept)
if env.get("CLAUDE_CODE_PLUGIN_DIRS") == value:
    print("install-mods: settings.json already lists these mods")
    sys.exit(2)
env["CLAUDE_CODE_PLUGIN_DIRS"] = value
with open(staged, "w") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
print("install-mods: wrote env.CLAUDE_CODE_PLUGIN_DIRS to " + settings)
PY
    rc=$?
    if [ "$rc" = 0 ]; then
      mv "$staged" "$settings" || settings_rc=4
    else
      rm -f "$staged"
      [ "$rc" = 2 ] || settings_rc=$rc
    fi
  fi
fi

[ "$skipped" = 0 ] || exit 3
exit "$settings_rc"
