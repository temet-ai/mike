#!/usr/bin/env python3
"""Turn accepted lessons into project memories and discoverable skills."""
import argparse
import fcntl
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True  # an installed package is verified file by file
from learning_audit.promote import promote

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--no-sync', action='store_true')
args = parser.parse_args()
lock_path = Path.home() / '.local/state/mike-learning-promotion.lock'
lock_path.parent.mkdir(parents=True, exist_ok=True)
with lock_path.open('w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    result = promote(sync=not args.no_sync)
    print(json.dumps(result, indent=2))
    raise SystemExit(1 if result['conflicts'] else 0)
