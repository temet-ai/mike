#!/usr/bin/env bash
# Checks how the deploy finds and reads an installed mike service (scripts/lib/managed-service.sh)
# without a build, a server, a database, launchctl or systemctl. Every case runs against a
# temporary HOME; MANAGED_SERVICE_PLATFORM picks the launchd or the systemd branch on any machine.
#
# Usage: scripts/test-managed-service-deploy     Exit: 0 = no FAIL. A case missing a prerequisite
# prints NOT RUN and is never counted as a pass (MANAGED_SERVICE_TEST_REQUIRES overrides "awk grep").
# The subshells below set HOME and the platform on purpose; nothing is meant to leak out.
# shellcheck disable=SC2030,SC2031
set -uo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pass=0 fail=0 notrun=0
ok() { pass=$((pass+1)); echo "PASS: $1"; }
bad() { fail=$((fail+1)); echo "FAIL: $1"; [[ -n "${2:-}" ]] && echo "  $2"; }
eq() { if [[ "$3" == "$2" ]]; then ok "$1"; else bad "$1" "wanted [$2] got [$3]"; fi; }

for need in ${MANAGED_SERVICE_TEST_REQUIRES:-awk grep}; do
    if ! command -v "$need" >/dev/null 2>&1; then
        echo "NOT RUN: every case ($need is missing)"
        echo "managed service deploy: 0 passed, 0 failed, 1 not run"
        exit 0
    fi
done

lib="$root/scripts/lib/managed-service.sh"
scratch="$(mktemp -d /tmp/ms.XXXXXX)"
trap 'rm -rf "$scratch"' EXIT
# shellcheck source=lib/managed-service.sh
source "$lib"

# Run a lib function in a subshell with its own HOME, platform and no inherited XDG paths.
# $1 = home, $2 = platform, rest = the command.
in_home() {
    local home="$1" platform="$2"
    shift 2
    ( export HOME="$home" MANAGED_SERVICE_PLATFORM="$platform"; unset XDG_CONFIG_HOME XDG_STATE_HOME; "$@" )
}

# ── no definition file ───────────────────────────────────────────────────────
home="$scratch/none"; mkdir -p "$home"
for platform in launchd systemd; do
    in_home "$home" "$platform" managed_service_installed
    eq "$platform: no definition file is not installed" "1" "$?"
done

# ── file names and identifiers ───────────────────────────────────────────────
eq "launchd: proxy definition path" "$home/Library/LaunchAgents/ai.temet.mike.proxy.plist" \
    "$(in_home "$home" launchd managed_service_file proxy)"
eq "launchd: forward definition path" "$home/Library/LaunchAgents/ai.temet.mike.forward.plist" \
    "$(in_home "$home" launchd managed_service_file forward)"
eq "systemd: proxy definition path" "$home/.config/systemd/user/mike.service" \
    "$(in_home "$home" systemd managed_service_file proxy)"
eq "systemd: forward definition path" "$home/.config/systemd/user/mike-forward.service" \
    "$(in_home "$home" systemd managed_service_file forward)"
eq "systemd: an absolute XDG_CONFIG_HOME is used" "/xdg/cfg/systemd/user/mike.service" \
    "$( ( export HOME="$home" MANAGED_SERVICE_PLATFORM=systemd XDG_CONFIG_HOME=/xdg/cfg; managed_service_file proxy ) )"
eq "systemd: a relative XDG_CONFIG_HOME is ignored, as mike ignores it" "$home/.config/systemd/user/mike.service" \
    "$( ( export HOME="$home" MANAGED_SERVICE_PLATFORM=systemd XDG_CONFIG_HOME=relative/dir; managed_service_file proxy ) )"
eq "launchd identifiers" "ai.temet.mike.proxy ai.temet.mike.forward" \
    "$(in_home "$home" launchd managed_service_identifier proxy) $(in_home "$home" launchd managed_service_identifier forward)"
eq "systemd identifiers" "mike.service mike-forward.service" \
    "$(in_home "$home" systemd managed_service_identifier proxy) $(in_home "$home" systemd managed_service_identifier forward)"
eq "the platform override wins" "systemd" "$(MANAGED_SERVICE_PLATFORM=systemd managed_service_platform)"

# ── a launchd plist without the marker ───────────────────────────────────────
home="$scratch/foreign-plist"
mkdir -p "$home/Library/LaunchAgents"
cat >"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>Label</key><string>ai.temet.mike.proxy</string></dict></plist>
EOF
in_home "$home" launchd managed_service_installed
eq "launchd: a plist without the marker is not installed" "1" "$?"

# ── a marked launchd plist in the shape launchd.rs renders ───────────────────
home="$scratch/launchd"
mkdir -p "$home/Library/LaunchAgents"
cat >"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by mike service install. Run `mike service install` to regenerate this file and `mike service uninstall` to remove it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.temet.mike.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/tmp/fake/bin/mike</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/tmp/fake/state/mike</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/fake/state/mike/logs/proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fake/state/mike/logs/proxy.log</string>
</dict>
</plist>
EOF
in_home "$home" launchd managed_service_installed
eq "launchd: a marked plist is installed" "0" "$?"
eq "launchd: the program is the first ProgramArguments string" "/tmp/fake/bin/mike" \
    "$(in_home "$home" launchd managed_service_program)"
eq "launchd: the log is StandardOutPath" "/tmp/fake/state/mike/logs/proxy.log" \
    "$(in_home "$home" launchd managed_service_log)"
# The sed/awk reader is what runs where plutil is missing, so check it on its own.
eq "launchd: the fallback reader finds the program without plutil" "/tmp/fake/bin/mike" \
    "$(_managed_service_plist_string ProgramArguments <"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist")"
eq "launchd: the fallback reader finds the log without plutil" "/tmp/fake/state/mike/logs/proxy.log" \
    "$(_managed_service_plist_string StandardOutPath <"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist")"
# A program path with characters launchd.rs escapes comes back unescaped.
printf '%s\n' '<key>ProgramArguments</key>' '<array>' '    <string>/tmp/a &amp; b/mike</string>' '</array>' >"$scratch/esc.plist"
eq "launchd: the fallback reader undoes XML escapes" "/tmp/a & b/mike" \
    "$(_managed_service_plist_string ProgramArguments <"$scratch/esc.plist")"
# The marker counts only near the top of the file, as in files::is_ours.
home="$scratch/late-marker"
mkdir -p "$home/Library/LaunchAgents"
{ for _ in $(seq 1 20); do echo "<!-- filler -->"; done; echo "<!-- Managed by mike service install -->"; } \
    >"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist"
in_home "$home" launchd managed_service_installed
eq "a marker beyond the first twelve lines does not count" "1" "$?"
# Without StandardOutPath the log falls back to the state folder.
home="$scratch/launchd-nolog"
mkdir -p "$home/Library/LaunchAgents"
printf '%s\n' '<!-- Managed by mike service install. -->' '<key>ProgramArguments</key>' '<array>' '<string>/tmp/fake/bin/mike</string>' '</array>' \
    >"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist"
eq "launchd: a missing StandardOutPath falls back to the default log" "$home/.local/state/mike/logs/proxy.log" \
    "$(in_home "$home" launchd managed_service_log)"

# ── a systemd unit without, then with, the marker ────────────────────────────
home="$scratch/systemd"
mkdir -p "$home/.config/systemd/user"
printf '%s\n' '[Service]' 'ExecStart=/tmp/fake/bin/mike serve' >"$home/.config/systemd/user/mike.service"
in_home "$home" systemd managed_service_installed
eq "systemd: a unit without the marker is not installed" "1" "$?"
cat >"$home/.config/systemd/user/mike.service" <<'EOF'
# Managed by mike service install. Run `mike service install` to regenerate this file and `mike service uninstall` to remove it.
[Unit]
Description=mike proxy

[Service]
Type=simple
ExecStart=/tmp/fake/bin/mike serve
WorkingDirectory=/tmp/fake/state/mike
Environment="PATH=/usr/bin:/bin"
Restart=on-failure
RestartSec=3
StandardOutput=append:/tmp/fake/state/mike/logs/proxy.log
StandardError=append:/tmp/fake/state/mike/logs/proxy.log

[Install]
WantedBy=default.target
EOF
in_home "$home" systemd managed_service_installed
eq "systemd: a marked unit is installed" "0" "$?"
eq "systemd: the program is the first word of ExecStart" "/tmp/fake/bin/mike" \
    "$(in_home "$home" systemd managed_service_program)"
eq "systemd: the log is the file the unit appends to" "/tmp/fake/state/mike/logs/proxy.log" \
    "$(in_home "$home" systemd managed_service_log)"
sed 's|^ExecStart=.*|ExecStart="/tmp/my dir/mike" serve|' "$home/.config/systemd/user/mike.service" >"$scratch/q.service"
mv "$scratch/q.service" "$home/.config/systemd/user/mike.service"
eq "systemd: a quoted program path with a space is read whole" "/tmp/my dir/mike" \
    "$(in_home "$home" systemd managed_service_program)"
sed '/^StandardOutput=/d;/^StandardError=/d' "$home/.config/systemd/user/mike.service" >"$scratch/q.service"
mv "$scratch/q.service" "$home/.config/systemd/user/mike.service"
eq "systemd: a unit with no log file points at journalctl" "journalctl --user -u mike.service" \
    "$(in_home "$home" systemd managed_service_log)"

# ── the boot generation ──────────────────────────────────────────────────────
gen="0357c195-fcdb-4b1b-83a0-269af2fce3cb"
eq "boot generation from a compact body" "$gen" \
    "$(printf '%s' '{"instance":{"instance_id":"65d5","boot_generation":"'"$gen"'"},"status":"ok"}' | parse_boot_generation)"
eq "boot generation from a pretty-printed body" "$gen" \
    "$(printf '{\n  "instance": {\n    "instance_id": "65d5",\n    "boot_generation" : "%s"\n  },\n  "status": "ok"\n}\n' "$gen" | parse_boot_generation)"
eq "a body without a boot generation gives nothing" "" \
    "$(printf '%s' '{"instance":{"instance_id":"65d5"},"status":"ok"}' | parse_boot_generation)"
eq "an empty body gives nothing" "" "$(printf '' | parse_boot_generation)"

# ── waiting for a new process, with a stand-in curl ──────────────────────────
# The stand-in answers with the generation named in $scratch/answer, or fails when that file is absent.
stub="$scratch/stub"; mkdir -p "$stub"
cat >"$stub/curl" <<EOF
#!/usr/bin/env bash
[[ -f "$scratch/answer" ]] || exit 22
printf '{"instance":{"boot_generation":"%s"},"status":"ok"}' "\$(cat "$scratch/answer")"
EOF
chmod +x "$stub/curl"
wait_case() {   # $1 = answer ("" = none), $2 = old generation; prints the exit status
    if [[ -n "$1" ]]; then printf '%s' "$1" >"$scratch/answer"; else rm -f "$scratch/answer"; fi
    ( export PATH="$stub:$PATH" WAIT_MAX_SECONDS=1; wait_new_generation 127.0.0.1:1 "$2" "test proxy" >/dev/null 2>&1; echo $? )
}
eq "a new generation answering counts as a new process" "0" "$(wait_case new-gen old-gen)"
eq "the old generation still answering is not a new process" "1" "$(wait_case old-gen old-gen)"
eq "nothing answering is not a new process" "1" "$(wait_case "" old-gen)"
eq "with no previous generation, any answer counts" "0" "$(wait_case any-gen "")"

# ── the scripts parse, and detection comes before .env ───────────────────────
for script in scripts/deploy-proxy.sh scripts/start-proxy.sh scripts/lib/managed-service.sh scripts/test-managed-service-deploy; do
    if bash -n "$root/$script" 2>/dev/null; then ok "bash -n $script"; else bad "bash -n $script"; fi
done
order="$(awk '
    /^[[:space:]]*#/ { next }
    /managed_service_installed/ && !d { d = NR }
    /^[[:space:]]*mike_source_env_preserving_exported[[:space:]]/ && !e { e = NR }
    END { print (d && e && d < e) ? "ok" : "detect " d " env " e }
' "$root/scripts/deploy-proxy.sh")"
eq "deploy-proxy.sh looks for the installed service before it sources .env" "ok" "$order"
# The service cutover restarts the service and waits for a new boot generation. It must free no
# real port, kill no pid, start no process of its own and leave the sidecar alone.
body="$(awk '/^cutover_via_service\(\) \{/ { in_fn = 1 } in_fn { print } in_fn && /^\}/ { exit }' "$lib" \
    | grep -v '^[[:space:]]*#')"
if [[ -z "$body" ]]; then
    bad "the library has a cutover_via_service function"
else
    eq "the service cutover restarts the proxy service and waits for a new generation" "2" \
        "$(printf '%s\n' "$body" | grep -c 'restart_service_and_wait')"
    forbidden="$(printf '%s\n' "$body" | grep -E 'free_port|kill |nohup|ensure_proxy_forward|stop-proxy|systemctl|launchctl' || true)"
    eq "the service cutover frees no port, kills nothing and starts nothing itself" "" "$forbidden"
fi

# ── the cutover and rollback, with the service and the health endpoint stubbed ──────────────
# $1 = generation after the first restart, $2 = after the second, "old" = nothing new answered.
cutover_case() {
    local d="$scratch/cut.$1.$2"
    mkdir -p "$d/bin"
    printf 'previous' >"$d/bin/mike"; printf 'previous' >"$d/prev"; chmod +x "$d/bin/mike" "$d/prev"
    printf 'staged' >"$d/staged"; chmod +x "$d/staged"
    echo 0 >"$d/restarts"
    (
        SERVICE_BIN="$d/bin/mike" STAGED_BIN="$d/staged" PREV_BIN="$d/prev" DEPLOYED_BIN="$d/deployed"
        PID_FILE="$d/pid" DEPLOY_DIR="$d" PROJECT_ROOT="$d" SMOKE_LOG="$d/smoke" SERVICE_ID=test.service
        INSPECT_ADDR=127.0.0.1:1 MIKE_ADDR=127.0.0.1:2 SERVICE_WAIT_SECONDS=1 CUTOVER_DONE=false
        after_first="$1" after_second="$2"
        verify_live_build_sha() { :; }; refresh_mike_cli() { :; }; warn_if_web_ui_is_stale() { :; }
        managed_service_log() { echo "$d/no-log"; }
        sync_service_sidecar() { echo "sidecar synced"; }
        managed_service_restart() { echo $(( $(cat "$d/restarts") + 1 )) >"$d/restarts"; }
        health_boot_generation() {
            case "$(cat "$d/restarts")" in 0) echo old ;; 1) echo "$after_first" ;; *) echo "$after_second" ;; esac
        }
        cutover_via_service
    ) >"$d/out" 2>&1
    echo "$?" >"$d/rc"
    printf '%s' "$d"
}
d="$(cutover_case new unused)"
eq "a new process answering is a successful cutover" "0" "$(cat "$d/rc")"
eq "after a cutover the service runs the staged binary" "staged" "$(cat "$d/bin/mike")"
eq "after a cutover the record holds the staged binary" "staged" "$(cat "$d/deployed" 2>/dev/null)"
eq "the sidecar is looked at only after the proxy is healthy" "1" "$(grep -c 'sidecar synced' "$d/out")"
d="$(cutover_case old rolled-back)"
eq "a build that never answers fails the deploy" "1" "$(cat "$d/rc")"
eq "a failed cutover puts the previous binary back" "previous" "$(cat "$d/bin/mike")"
eq "rollback is reported only when a new process answered" "1" "$(grep -c 'Rollback succeeded' "$d/out")"
eq "a failed cutover leaves the sidecar alone" "0" "$(grep -c 'sidecar synced' "$d/out")"
d="$(cutover_case old old)"
eq "a failed rollback fails the deploy" "1" "$(cat "$d/rc")"
eq "a failed rollback never claims success" "0" "$(grep -c 'Rollback succeeded' "$d/out")"
eq "a failed rollback says the proxy is down" "1" "$(grep -c 'ROLLBACK ALSO FAILED' "$d/out")"

# ── restart and stop drive launchd correctly, with a stub launchctl ─────────────────────────
launch_stub="$scratch/launch-stub"; mkdir -p "$launch_stub"
cat >"$launch_stub/launchctl" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$LAUNCH_LOG"
case "$1" in
    print) [[ -f "$LAUNCH_LOADED" ]] || exit 113; echo "pid = 4242" ;;
    bootout) rm -f "$LAUNCH_LOADED" ;;
    bootstrap) touch "$LAUNCH_LOADED" ;;
esac
EOF
chmod +x "$launch_stub/launchctl"
launch_case() {   # $1 = yes when loaded, $2 = the function to run; prints the verbs it called
    local log="$scratch/launch.log" loaded="$scratch/launch.loaded"
    rm -f "$log" "$loaded"; [[ "$1" == yes ]] && touch "$loaded"
    ( export PATH="$launch_stub:$PATH" LAUNCH_LOG="$log" LAUNCH_LOADED="$loaded" HOME="$scratch/home" MANAGED_SERVICE_PLATFORM=launchd
      "$2" proxy ) >/dev/null 2>&1
    awk '{ printf "%s ", $1 } $1 == "kickstart" { printf "%s ", $2 }' "$log" 2>/dev/null
}
eq "restart kills and restarts a loaded service" "print kickstart -k " "$(launch_case yes managed_service_restart)"
eq "restart loads a service that stop unloaded" "print bootstrap " "$(launch_case no managed_service_restart)"
eq "stop unloads a loaded service so launchd does not bring it back" "print bootout " "$(launch_case yes managed_service_stop)"
eq "stop leaves an unloaded service alone" "print " "$(launch_case no managed_service_stop)"

# ── the guard for scripts that bind mike's ports ────────────────────────────────────────────
guard_case() {   # $1 = yes when the service runs; prints the exit status
    local home="$scratch/guard-home" loaded="$scratch/guard.loaded"
    rm -f "$loaded"; [[ "$1" == yes ]] && touch "$loaded"
    mkdir -p "$home/Library/LaunchAgents"
    printf '<!-- %s -->\n' "$MANAGED_SERVICE_MARKER" >"$home/Library/LaunchAgents/ai.temet.mike.proxy.plist"
    ( export PATH="$launch_stub:$PATH" LAUNCH_LOG=/dev/null LAUNCH_LOADED="$loaded" HOME="$home" MANAGED_SERVICE_PLATFORM=launchd
      refuse_while_service_runs "test" >/dev/null 2>&1 ) && echo 0 || echo 1
}
eq "a port-binding script stops while the service runs" "1" "$(guard_case yes)"
eq "a port-binding script runs once the service is stopped" "0" "$(guard_case no)"
for script in stop-proxy.sh start-debug.sh debug-stack-deps.sh start-and-monitor.sh restart-frontend.sh; do
    if bash -n "$root/scripts/$script" 2>/dev/null; then ok "bash -n scripts/$script"; else bad "bash -n scripts/$script"; fi
done

# ── the sidecar restarts only when its own code changed ─────────────────────────────────────
repo="$scratch/repo"; mkdir -p "$repo/crates/proxy-forward"
git -C "$repo" init -q; git -C "$repo" config user.email t@t; git -C "$repo" config user.name t
echo one >"$repo/crates/proxy-forward/a"; echo one >"$repo/other"
git -C "$repo" add .; git -C "$repo" commit -qm one; first="$(git -C "$repo" rev-parse HEAD)"
echo two >"$repo/other"; git -C "$repo" commit -qam two
sidecar_case() {   # $1 = recorded commit; prints how often the sidecar restarted
    ( PROJECT_ROOT="$repo" DEPLOY_DIR="$repo" PREV_BIN=/nonexistent
      printf '%s\n' "$1" >"$repo/service-forward.commit"
      managed_service_pid() { echo 7; }; _wait_for_sidecar() { return 0; }
      managed_service_restart() { echo restarted; }
      sync_service_sidecar ) 2>/dev/null | grep -c restarted
}
eq "the sidecar stays up when only other code changed" "0" "$(sidecar_case "$first")"
echo two >"$repo/crates/proxy-forward/a"; git -C "$repo" commit -qam three
eq "the sidecar restarts when its code changed" "1" "$(sidecar_case "$first")"
eq "the restart is recorded so the next deploy leaves it alone" "$(git -C "$repo" rev-parse HEAD)" "$(cat "$repo/service-forward.commit")"

echo "managed service deploy: $pass passed, $fail failed, $notrun not run"
(( fail == 0 ))
