#!/usr/bin/env bash
# Explicit local maintenance only. Never downloads, uploads, purges, or starts Mike.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 -I -c 'import runpy, sys; from pathlib import Path; p = Path(sys.argv.pop(1)); sys.path.insert(0, str(p.parent)); runpy.run_path(str(p), run_name="__main__")' "${SCRIPT_DIR}/release/recovery.py" "$@"
