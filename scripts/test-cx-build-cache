#!/usr/bin/env bash
# test-cx-build-cache — checks the MIKE_BUILD_CACHE=mbx opt-in of scripts/cx.
#
# It asks cx for the command line it would run (CX_PRINT_COMMAND=1) or the build
# directory it would use (CX_PRINT_TARGET_DIR=1) and never runs a build. Without
# mbx installed, or with MIKE_BUILD_CACHE=cargo, the line is cargo's. With mbx
# installed, check, clippy, test, nextest and build go through it into
# target/mbx-<session> by default; build with MIKE_BUILD_IDENTITY=git stays on cargo.
# Heavy builds carry the nice/ionice prefix. MIKE_BUILD_CACHE=mbx forces mbx for the
# subcommands it caches. Plain cargo never builds in an mbx directory.
#
# USAGE
#   scripts/test-cx-build-cache        # one line per case, then a verdict
#
# EXIT CODE
#   0 when every case passes. The last line is CX-BUILD-CACHE: PASS or FAIL.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cx="$script_dir/cx"
root="$(git -C "$script_dir" rev-parse --show-toplevel)"

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT
fake="$T/mbx"
printf '#!/bin/sh\nexit 0\n' > "$fake"
chmod +x "$fake"

fail=0
chk() {
  if [[ "$1" == pass ]]; then printf '  PASS  %s\n' "$2"
  else printf '  FAIL  %s\n' "$2"; fail=1; fi
}

raw() {
  env -u MIKE_BUILD_CACHE -u MBX_BIN -u MBX_CACHE_DIR -u CARGO_TARGET_DIR -u RUSTC_WRAPPER \
    -u CARGO_BUILD_RUSTC_WRAPPER -u CX_SCCACHE -u MIKE_BUILD_IDENTITY CX_PRINT_COMMAND=1 "$@"
}
# The command line without the low-priority prefix every heavy build carries (checked below).
plain() {
  raw "$@" | awk 'BEGIN { p = 1 }
    p && ($0 == "nice" || $0 == "-n" || $0 == "19" || $0 == "ionice" || $0 == "-c" || $0 == "3") { next }
    { p = 0; print }'
  return "${PIPESTATUS[0]}"
}

out="$(plain MBX_BIN="$T/none" "$cx" check -p mike --lib 2>&1)"
first="$(printf '%s\n' "$out" | head -1)"
tail3="$(printf '%s\n' "$out" | tail -4 | tr '\n' ' ')"
[[ "$first" == cargo && "$tail3" == "check -p mike --lib " ]] \
  && chk pass "unset, no mbx: the command is cargo with the arguments untouched" \
  || chk fail "unset, no mbx: the command is cargo with the arguments untouched ($first / $tail3)"

out="$(plain MBX_BIN="$T/none" CX_SCCACHE=1 "$cx" check 2>&1)"
if command -v sccache >/dev/null 2>&1; then
  grep -q 'build.rustc-wrapper' <<<"$out" \
    && chk pass "unset: CX_SCCACHE=1 still injects sccache as before" \
    || chk fail "unset: CX_SCCACHE=1 still injects sccache as before"
else
  chk pass "unset: CX_SCCACHE=1 case skipped, sccache is not installed"
fi

out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" CARGO_TARGET_DIR="$root/target/mbx-a" "$cx" check -p mike --lib 2>&1)"
first="$(printf '%s\n' "$out" | head -1)"
[[ "$first" == "$fake" ]] \
  && chk pass "set: the command is MBX_BIN" \
  || chk fail "set: the command is MBX_BIN ($first)"
[[ "$(printf '%s\n' "$out" | tail -n +2 | tr '\n' ' ')" == "check -p mike --lib " ]] \
  && chk pass "set: the cargo subcommand follows mbx with nothing added" \
  || chk fail "set: the cargo subcommand follows mbx with nothing added"
grep -qE 'sccache|rustc-wrapper|^cargo$' <<<"$out" \
  && chk fail "set: sccache and cargo are off" \
  || chk pass "set: sccache and cargo are off"

out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" CX_SCCACHE=1 RUSTC_WRAPPER=sccache CARGO_TARGET_DIR=target/mbx-a "$cx" check 2>&1)"
grep -qE 'sccache|rustc-wrapper' <<<"$out" \
  && chk fail "set: CX_SCCACHE=1 and RUSTC_WRAPPER do not turn sccache on" \
  || chk pass "set: CX_SCCACHE=1 and RUSTC_WRAPPER do not turn sccache on"

for d in "" target target/ "$root/target" target/fleet-check "$root/target/fleet-check/"; do
  if [[ -z "$d" ]]; then
    out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" "$cx" check 2>&1)"
  else
    out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" CARGO_TARGET_DIR="$d" "$cx" check 2>&1)"
  fi
  rc=$?
  [[ $rc -ne 0 && "$out" != "$fake"* ]] \
    && chk pass "set: build directory '${d:-<unnamed>}' is refused" \
    || chk fail "set: build directory '${d:-<unnamed>}' is refused (rc $rc)"
done

out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$T/none" CARGO_TARGET_DIR=target/mbx-a "$cx" check 2>&1)"
rc=$?
[[ $rc -ne 0 && "$out" == *"found no mbx"* ]] \
  && chk pass "set: a missing mbx is a clear error" \
  || chk fail "set: a missing mbx is a clear error (rc $rc)"

out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" CARGO_TARGET_DIR=target/mbx-a bash -c "
  CX_PRINT_COMMAND=1 '$cx' check >/dev/null; echo done" 2>&1)"
[[ "$out" == done ]] && chk pass "set: a relative build directory is accepted" \
  || chk fail "set: a relative build directory is accepted ($out)"

out="$(env -u MBX_LEARNED_INCREMENTAL -u MBX_CACHE_DIR bash -c "
  source '$root/scripts/lib/preflight-toolchain.sh'
  MBX_BIN='$fake' prepare_mbx_build_cache '$root' target/mbx-a && echo \"li=\$MBX_LEARNED_INCREMENTAL bc=\$MIKE_BUILD_CACHE\"" 2>&1)"
[[ "$out" == "li=0 bc=mbx" ]] && chk pass "set: learned incremental reuse is off and build.rs sees mbx, so crate mike is stored and keyed stably" \
  || chk fail "set: learned incremental reuse is off ($out)"

# The default when mbx is installed.
first_of() { printf '%s\n' "$1" | head -1; }
for sub in check clippy test build; do
  out="$(plain MBX_BIN="$fake" "$cx" "$sub" 2>&1)"
  [[ "$(first_of "$out")" == "$fake" ]] \
    && chk pass "unset, mbx installed: $sub goes through mbx" \
    || chk fail "unset, mbx installed: $sub goes through mbx ($(first_of "$out"))"
done
for sub in run; do
  out="$(plain MBX_BIN="$fake" "$cx" "$sub" 2>&1)"
  [[ "$(first_of "$out")" == cargo ]] \
    && chk pass "unset, mbx installed: $sub stays on cargo" \
    || chk fail "unset, mbx installed: $sub stays on cargo ($(first_of "$out"))"
done
out="$(plain MBX_BIN="$fake" MIKE_BUILD_IDENTITY=git "$cx" build --release 2>&1)"
[[ "$(first_of "$out")" == cargo ]] \
  && chk pass "unset, mbx installed: build with MIKE_BUILD_IDENTITY=git stays on cargo (make install, release)" \
  || chk fail "unset, mbx installed: build with MIKE_BUILD_IDENTITY=git stays on cargo ($(first_of "$out"))"
if command -v cargo-nextest >/dev/null 2>&1; then
  shim="$T/data/mbx/bin/cargo"
  mkdir -p "$(dirname "$shim")" && cp "$fake" "$shim"
  out="$(plain MBX_BIN="$fake" XDG_DATA_HOME="$T/data" "$cx" nextest run -p mike 2>&1)"
  [[ "$(printf '%s\n' "$out" | tr '\n' ' ')" == "env CARGO=$shim $(command -v cargo-nextest) nextest run -p mike " ]] \
    && chk pass "unset, mbx installed: nextest runs with CARGO=mbx's cargo shim, never mbx itself" \
    || chk fail "unset, mbx installed: nextest runs with CARGO=mbx's cargo shim ($(printf '%s\n' "$out" | tr '\n' ' '))"
  out="$(plain MBX_BIN="$fake" XDG_DATA_HOME="$T/no-shim" "$cx" nextest run -p mike 2>&1)"
  [[ "$out" == *"cargo shim is missing"* ]] \
    && chk pass "unset, mbx installed, no shim: nextest refuses instead of making mbx call itself" \
    || chk fail "unset, mbx installed, no shim: nextest refuses ($(printf '%s\n' "$out" | tr '\n' ' '))"
else
  chk pass "unset, mbx installed: nextest case skipped, cargo-nextest is not installed"
fi

# Heavy builds run at the lowest priority; fmt and the like do not.
out="$(raw MBX_BIN="$fake" "$cx" check 2>&1)"
[[ "$(first_of "$out")" == nice ]] \
  && chk pass "a heavy build (check) runs under nice -n 19" \
  || chk fail "a heavy build (check) runs under nice -n 19 ($(first_of "$out"))"
out="$(raw MBX_BIN="$fake" "$cx" fmt --check 2>&1)"
[[ "$(first_of "$out")" == cargo ]] \
  && chk pass "fmt is not a heavy build: no priority prefix" \
  || chk fail "fmt is not a heavy build: no priority prefix ($(first_of "$out"))"
out="$(plain MBX_BIN="$fake" "$cx" +1.95.0 check 2>&1)"
[[ "$(first_of "$out")" == "$fake" ]] \
  && chk pass "unset, mbx installed: a +toolchain prefix does not hide the subcommand" \
  || chk fail "unset, mbx installed: a +toolchain prefix does not hide the subcommand"

d="$(plain MBX_BIN="$fake" env -u MIKE_SESSION_ID -u CLAUDE_CODE_SESSION_ID bash -c "CX_PRINT_TARGET_DIR=1 '$cx' check" 2>&1 | tail -1)"
[[ "$d" == "$root/target/mbx-default" ]] \
  && chk pass "unset, mbx installed: no session id builds in target/mbx-default" \
  || chk fail "unset, mbx installed: no session id builds in target/mbx-default ($d)"
d="$(plain MBX_BIN="$fake" MIKE_SESSION_ID='ab/c:1234567890xyz' bash -c "CX_PRINT_TARGET_DIR=1 '$cx' check" 2>&1 | tail -1)"
[[ "$d" == "$root/target/mbx-abc123456789" ]] \
  && chk pass "unset, mbx installed: the session id names the directory, cleaned and cut to 12" \
  || chk fail "unset, mbx installed: the session id names the directory ($d)"
d="$(plain MBX_BIN="$fake" CARGO_TARGET_DIR="$root/target" MIKE_SESSION_ID=s1 bash -c "CX_PRINT_TARGET_DIR=1 '$cx' check" 2>&1 | tail -1)"
[[ "$d" == "$root/target/mbx-s1" ]] \
  && chk pass "unset, mbx installed: the Makefile's CARGO_TARGET_DIR=<checkout>/target still gets a session directory" \
  || chk fail "unset, mbx installed: the Makefile's target still gets a session directory ($d)"
out="$(plain MBX_BIN="$fake" CARGO_TARGET_DIR=target/fleet-check "$cx" check 2>&1)"
[[ "$(first_of "$out")" == cargo ]] \
  && chk pass "unset, mbx installed: another named build directory keeps cargo" \
  || chk fail "unset, mbx installed: another named build directory keeps cargo ($(first_of "$out"))"
d="$(plain MBX_BIN="$fake" CARGO_TARGET_DIR=target/mbx-a bash -c "CX_PRINT_TARGET_DIR=1 '$cx' check" 2>&1 | tail -1)"
[[ "$d" == "$root/target/mbx-a" ]] \
  && chk pass "unset, mbx installed: a named mbx-* directory is used as named" \
  || chk fail "unset, mbx installed: a named mbx-* directory is used as named ($d)"

# Plain cargo never builds in an mbx directory.
for case in "MBX_BIN=$fake:run" "MBX_BIN=$T/none:check" "MBX_BIN=$fake MIKE_BUILD_CACHE=cargo:check"; do
  vars="${case%%:*}"; sub="${case##*:}"
  # shellcheck disable=SC2086
  out="$(plain $vars CARGO_TARGET_DIR=target/mbx-a "$cx" "$sub" 2>&1)"
  rc=$?
  [[ $rc -ne 0 && "$out" == *"mbx build directory"* ]] \
    && chk pass "plain cargo is refused in target/mbx-a ($vars $sub)" \
    || chk fail "plain cargo is refused in target/mbx-a ($vars $sub, rc $rc)"
done
out="$(plain MIKE_BUILD_CACHE=mbx MBX_BIN="$fake" CARGO_TARGET_DIR=target/mbx-a "$cx" run 2>&1)"
rc=$?
[[ $rc -ne 0 && "$out" == *"caches only"* ]] \
  && chk pass "set: a subcommand mbx does not cache is refused" \
  || chk fail "set: a subcommand mbx does not cache is refused (rc $rc)"
out="$(plain MIKE_BUILD_CACHE=cargo MBX_BIN="$fake" "$cx" check 2>&1)"
[[ "$(first_of "$out")" == cargo ]] \
  && chk pass "MIKE_BUILD_CACHE=cargo: check stays on cargo with mbx installed" \
  || chk fail "MIKE_BUILD_CACHE=cargo: check stays on cargo with mbx installed"
out="$(plain MIKE_BUILD_CACHE=bogus "$cx" check 2>&1)"
rc=$?
[[ $rc -ne 0 && "$out" == *"must be mbx, cargo or unset"* ]] \
  && chk pass "an unknown MIKE_BUILD_CACHE is an error" \
  || chk fail "an unknown MIKE_BUILD_CACHE is an error (rc $rc)"

if [[ $fail -eq 0 ]]; then echo "CX-BUILD-CACHE: PASS"; exit 0; fi
echo "CX-BUILD-CACHE: FAIL"
exit 1
