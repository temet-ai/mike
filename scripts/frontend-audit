#!/usr/bin/env bash
# Read-only, fail-closed advisory gate for every frontend dependency class.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
  echo 'FRONTEND-AUDIT: NOT RUN (python3 unavailable)' >&2
  exit 2
fi
exec python3 "$SCRIPT_DIR/lib/frontend_audit.py" "$@"
