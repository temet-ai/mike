#!/usr/bin/env bash
# morning-report — starts the morning session after the nightly run (ExecStopPost of
# mike-dev-nightly-tests.service). The session checks the nightly tests, Wright, the four
# machines and overnight sessions, fixes what is stuck, and within 30 minutes writes a short
# report in its pane, which Dawid reads in the Claude app over Remote Control.
# Brief: scripts/morning-report.md.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The systemd unit has none of the checkout's .env, which carries MIKE_LAUNCH_CLAUDE_ARGS
# (--dangerously-skip-permissions): without it the session stops on permission prompts.
set -a
[[ -f "$root/.env" ]] && . "$root/.env"
set +a
exec mike spawn open "$root" \
  --session-name morning-report \
  --goal "Morning report: on screen within 30 minutes, stuck things fixed" \
  --prompt-file "$root/scripts/morning-report.md"
