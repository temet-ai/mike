#!/usr/bin/env node
// story-shot — find a Storybook story by word and save a picture of it.
//
// Storybook renders the app's real components, so a picture of a story is a picture of
// what a page gets when it imports that component. This asks the running Storybook for
// its story list, so no browser tool is needed to look at one.
//
// Usage: scripts/story-shot <word> [word ...]      list the stories whose title, name or
//                                                  file matches every word
//        scripts/story-shot --shot <word> [...]    also save a picture of each match
//        scripts/story-shot --shot --id <story-id> save a picture of one story by id
//        options: --out <dir>   where pictures go (default: a folder under the temp dir)
//                 --limit <n>   most pictures to take in one run (default 12)
//                 --theme <t>   Storybook theme to render in
//                 --width <n>   viewport width (default 1280)
//                 --height <n>  viewport height (default 900); raise it for a page that
//                               scrolls inside itself, so the picture shows all of it
//
// Needs Storybook running — the stack keeps it up as `mike-stack-storybook` (`systemctl --user start mike-stack-storybook`; without systemd: `cd frontend && pnpm run storybook`)
// Exit 0 = found. Exit 1 = nothing matched. Exit 2 = Storybook is not running.

import { createRequire } from 'node:module';
import { mkdirSync } from 'node:fs';
import { tmpdir } from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const base = process.env.STORYBOOK_URL ?? 'http://localhost:6006';

const args = process.argv.slice(2);
const take = (flag) => {
	const at = args.indexOf(flag);
	if (at === -1) return null;
	const [, value] = args.splice(at, 2);
	return value ?? null;
};
const shot = args.includes('--shot');
if (shot) args.splice(args.indexOf('--shot'), 1);
const id = take('--id');
const outDir = take('--out') ?? path.join(tmpdir(), 'story-shot');
const limit = Number(take('--limit') ?? 12);
const theme = take('--theme');
const width = Number(take('--width') ?? 1280);
const height = Number(take('--height') ?? 900);
const words = args.map((word) => word.toLowerCase());

if (!id && words.length === 0) {
	console.error('Usage: scripts/story-shot [--shot] <word> [word ...]');
	process.exit(1);
}

let index;
try {
	const response = await fetch(`${base}/index.json`);
	index = await response.json();
} catch {
	console.error(`NOT RUNNING: no Storybook at ${base}.`);
	console.error('Start it with: systemctl --user start mike-stack-storybook (without systemd: cd frontend && pnpm run storybook)');
	process.exit(2);
}

const stories = Object.values(index.entries).filter((entry) => entry.type === 'story');
const matches = id
	? stories.filter((entry) => entry.id === id)
	: stories.filter((entry) => {
			const text = `${entry.title} ${entry.name} ${entry.importPath}`.toLowerCase();
			return words.every((word) => text.includes(word));
		});

if (matches.length === 0) {
	console.error(`No story matches ${id ?? words.join(' ')}.`);
	process.exit(1);
}

const byTitle = new Map();
for (const entry of matches) {
	if (!byTitle.has(entry.title)) byTitle.set(entry.title, []);
	byTitle.get(entry.title).push(entry);
}
for (const [title, entries] of byTitle) {
	console.log(title);
	console.log(`  file: frontend/${entries[0].importPath.replace(/^\.\//, '')}`);
	for (const entry of entries) console.log(`  ${entry.id}  (${entry.name})`);
}
console.log(`\n${matches.length} stories under ${byTitle.size} titles.`);

if (!shot) process.exit(0);

const require = createRequire(path.join(repoRoot, 'frontend', 'package.json'));
let chromium;
try {
	({ chromium } = require('playwright'));
} catch {
	console.error('SKIP: playwright not resolvable from frontend/ — run pnpm install there first.');
	process.exit(2);
}

mkdirSync(outDir, { recursive: true });
const chosen = matches.slice(0, limit);
if (chosen.length < matches.length) {
	console.log(`Taking the first ${limit} pictures. Narrow the words or raise --limit for more.`);
}
const browser = await chromium.launch();
try {
	const page = await browser.newPage({ viewport: { width, height } });
	await page.emulateMedia({ reducedMotion: 'reduce' });
	let failed = 0;
	for (const entry of chosen) {
		const globals = theme ? `&globals=theme:${theme}` : '';
		const file = path.join(outDir, `${entry.id}.png`);
		try {
			await page.goto(`${base}/iframe.html?id=${entry.id}&viewMode=story${globals}`, {
				waitUntil: 'load',
				timeout: 60000
			});
			await page.waitForSelector('#storybook-root > *', { timeout: 30000 });
			await page.waitForLoadState('networkidle', { timeout: 4000 }).catch(() => null);
			await page.evaluate(() => document.fonts.ready);
			await page.waitForTimeout(600);
			const box = await page.locator('#storybook-root').boundingBox();
			if (box && box.height > 20 && box.width > 20) {
				const size = page.viewportSize();
				await page.screenshot({
					path: file,
					fullPage: true,
					clip: {
						x: 0,
						y: 0,
						width: size.width,
						height: Math.ceil(box.y + box.height + 16)
					}
				});
			} else {
				await page.screenshot({ path: file, fullPage: true });
			}
			console.log(`picture: ${file}`);
		} catch (error) {
			failed += 1;
			console.error(`NO PICTURE: ${entry.id} — ${String(error.message).split('\n')[0]}`);
		}
	}
	if (failed > 0) process.exitCode = 1;
} finally {
	await browser.close();
}
