{
	"name": "claude-proxy-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite dev",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "../scripts/sb-test",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "../scripts/sb-test --unit --skip-typecheck",
		"test:watch": "vitest --project unit",
		"test:unit": "../scripts/sb-test --unit --skip-typecheck",
		"test:unit:watch": "vitest --project unit",
		"test:integration": "../scripts/sb-test --integration --skip-typecheck",
		"test:integration:watch": "vitest --project integration",
		"test:all": "../scripts/sb-test --unit --integration --skip-typecheck",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"storybook:test": "../scripts/sb-test --storybook --skip-typecheck",
		"storybook:test:themes": "node ../scripts/storybook-test-all-themes.mjs",
		"storybook:snapshot:update": "../scripts/sb-test --storybook --skip-typecheck --update",
		"storybook:coverage": "node ../scripts/storybook-coverage.mjs",
		"storybook:freeze": "node ../scripts/storybook-freeze.mjs",
		"test:overlap": "node ../scripts/frontend-test-overlap.mjs",
		"lint:tokens": "node ../scripts/lint-tokens.mjs",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.62.1",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-mcp": "10.6.6",
		"@storybook/addon-svelte-csf": "5.1.2",
		"@storybook/addon-themes": "10.6.6",
		"@storybook/addon-vitest": "10.6.6",
		"@storybook/sveltekit": "10.6.6",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/d3-force": "3.0.10",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.4.0",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"@vitest/coverage-v8": "4.1.12",
		"culori": "^4.0.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.11.0",
		"jsdom": "30.0.1",
		"playwright": "1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "10.6.6",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.3.6",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/syne": "^5.3.0",
		"@internationalized/date": "3.12.3",
		"@lucide/svelte": "1.34.0",
		"@xyflow/svelte": "^1.6.5",
		"augmented-ui": "^2.0.0",
		"bits-ui": "2.19.0",
		"clsx": "2.1.1",
		"d3-force": "3.0.0",
		"dompurify": "^3.4.16",
		"idb": "^8.0.3",
		"markdown-it": "^15.0.3",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1"
	}
}
