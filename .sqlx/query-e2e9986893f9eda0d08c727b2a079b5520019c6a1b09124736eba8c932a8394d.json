  "query": "SELECT l.id,\n       l.subject_kind,\n       l.subject_id,\n       l.operator_turn_id,\n       l.session_id,\n       l.session_uuid,\n       l.axis,\n       l.label,\n       l.action,\n       l.tier,\n       l.method,\n       l.split,\n       l.tags,\n       l.severity,\n       l.confidence,\n       l.evidence,\n       l.note,\n       l.source,\n       l.provenance,\n       l.inclusion_prob,\n       l.verdict_snapshot,\n       l.verdict_bundle_id,\n       l.import_batch_id,\n       l.supersedes_id,\n       l.created_at\n  FROM eval.labels l\n WHERE l.subject_kind = 'turn' AND l.subject_id = $1 AND l.tier = 'gold'\n   AND l.action = 'assert' AND l.provenance ->> 'eval_run_id' IS NOT NULL\n ORDER BY l.id DESC\n",
