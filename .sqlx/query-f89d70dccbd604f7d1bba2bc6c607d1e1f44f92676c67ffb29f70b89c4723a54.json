  "query": "SELECT e.id AS \"id!\",\n       e.paths[1] AS \"path!\",\n       e.before_sha,\n       e.after_sha\n  FROM workspace.change_events e\n WHERE e.checkout = $1\n   AND e.id > $2\n   AND e.kind IN ('edit', 'shell_change')\n   AND cardinality(e.paths) = 1\n ORDER BY e.id\n LIMIT $3\n",
