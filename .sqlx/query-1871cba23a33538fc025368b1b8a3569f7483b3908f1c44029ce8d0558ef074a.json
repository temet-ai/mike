  "query": "SELECT r.session_id AS session_db_id,\n                        s.session_uuid,\n                        COALESCE(r.completed_at, r.created_at) AS \"trigger_at!\",\n                        r.human_prompt,\n                        r.last_user_message\n                   FROM requests.requests r\n                   JOIN sessions.sessions s ON s.id = r.session_id\n                  WHERE r.id = $1",
