  "query": "SELECT id, created_at, candidate_run_id, baseline_run_id, noise_run_id,\n                                  holdout_batch, verdict, floors, report, override_reason,\n                                  count(*) OVER () AS \"total!\"\n                             FROM eval.gates\n                            WHERE holdout_batch = $1\n                            ORDER BY created_at DESC, id DESC LIMIT $2 OFFSET $3",
