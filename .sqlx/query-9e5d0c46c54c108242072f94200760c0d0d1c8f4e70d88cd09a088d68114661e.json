  "db_name": "PostgreSQL",
  "query": "SELECT role AS \"key!\",\n       COALESCE(SUM(call_count), 0)::bigint AS \"call_count!\",\n       COALESCE(SUM(cost_usd), 0.0)::float8 AS \"cost_usd!\",\n       COALESCE(SUM(prompt_tokens), 0)::bigint AS \"prompt_tokens!\",\n       COALESCE(SUM(completion_tokens), 0)::bigint AS \"completion_tokens!\",\n       COALESCE(SUM(reasoning_tokens), 0)::bigint AS \"reasoning_tokens!\",\n       COALESCE(SUM(call_count) FILTER (WHERE model LIKE 'codex/%' OR model LIKE 'claude/%'), 0)::bigint AS \"subscription_call_count!\"\n  FROM llm.daily_spend\n WHERE day >= $1 AND day <= $2\n GROUP BY role\n ORDER BY role\n",
