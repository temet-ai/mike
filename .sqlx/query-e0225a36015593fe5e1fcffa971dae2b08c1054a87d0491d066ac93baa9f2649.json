{
  "db_name": "PostgreSQL",
  "query": "SELECT f.id AS \"id!\", f.scan_id AS \"scan_id!\", f.change_event_id AS \"change_event_id!\",\n       s.session_uuid AS \"session_id?\", f.checkout AS \"checkout!\", f.path AS \"path!\",\n       f.rule_id AS \"rule_id!\", f.severity AS \"severity!\", f.message AS \"message!\",\n       f.line AS \"line!\", f.col AS \"col!\", f.matched AS \"matched!\", f.fix,\n       f.found_at AS \"found_at!\", f.delivered_request_id, f.delivered_at,\n       f.outcome AS \"outcome!\", f.outcome_at\n  FROM workspace.code_findings f\n  JOIN workspace.change_events e ON e.id = f.change_event_id\n  LEFT JOIN sessions.sessions s ON s.id = e.session_id\n WHERE f.found_at >= $1\n   AND ($2::uuid IS NULL OR s.session_uuid = $2)\n ORDER BY f.id DESC\n LIMIT $3\n",
