{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.project_id, e.checkout, e.at, e.kind, e.session_id, e.run_id, e.task,\n       e.paths, e.subject, e.detail, e.before_sha, e.after_sha\n  FROM workspace.change_events e\n  -- grader-allow: LATERAL stops at the first matching prefix for each event; it is not a per-row scalar lookup\n  CROSS JOIN LATERAL (\n        SELECT 1 AS hit\n          FROM unnest(e.paths) AS ep(path)\n          JOIN unnest($2::text[]) AS wanted(prefix) ON starts_with(ep.path, wanted.prefix)\n         LIMIT 1\n       ) m\n WHERE e.checkout = $1\n   AND e.id > $3\n   AND ($4::bigint IS NULL OR e.session_id IS DISTINCT FROM $4)\n   AND (cardinality($5::text[]) = 0 OR e.kind = ANY($5))\n ORDER BY e.id\n LIMIT $6\n",
