  "query": "SELECT l.id AS \"lesson_id!\",\n                        l.text AS \"lesson_text!\",\n                        lk.code AS \"kind!\",\n                        l.created_at AS \"created_at!\"\n                   FROM memory.lessons l\n                   JOIN memory.lesson_kinds lk ON lk.id = l.kind_id\n                  WHERE l.session_id = $1\n                  ORDER BY l.id",
