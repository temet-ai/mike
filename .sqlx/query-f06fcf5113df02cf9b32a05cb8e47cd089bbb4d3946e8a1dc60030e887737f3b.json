  "query": "SELECT sm.request_id, sm.ord, m.body, sm.cache_control\n           FROM requests.sent_messages sm\n           JOIN messages.messages m ON m.id = sm.message_id\n          WHERE sm.request_id = ANY($1)\n          ORDER BY sm.request_id, sm.ord",
