  "query": "SELECT l.id, k.code AS \"kind!\", l.text, t.user_prompt\n                     FROM memory.lessons l\n                     JOIN memory.lesson_kinds k ON k.id = l.kind_id\n                     LEFT JOIN memory.operator_turns t ON t.id = l.source_turn_id\n                    WHERE l.id = ANY($1)\n                    ORDER BY l.id",
