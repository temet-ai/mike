{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT job_name AS \"job_name!\",\n               max(finished_at) FILTER (WHERE result_kind = 'succeeded') AS last_success,\n               max(finished_at) AS \"last_run!\",\n               (array_agg(result_kind ORDER BY finished_at DESC))[1] AS last_result\n          FROM jobs.runs\n         GROUP BY job_name\n        ",
