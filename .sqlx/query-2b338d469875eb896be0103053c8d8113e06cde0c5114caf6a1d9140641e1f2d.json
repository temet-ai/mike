{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (m.id) m.body, r.id AS request_id, r.created_at, r.claude_code_agent_id AS agent_id\n  FROM requests.requests r\n  JOIN requests.messages rm ON rm.request_id = r.id\n  JOIN messages.messages m ON m.id = rm.message_id\n WHERE r.session_id = $1\n   AND m.body::text LIKE '%task-notification>%'\n ORDER BY m.id, r.id\n",
