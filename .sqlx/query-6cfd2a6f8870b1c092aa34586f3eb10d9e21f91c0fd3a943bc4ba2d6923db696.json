  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.name, a.definition_path, a.description,\n                          s.code AS \"source!\", a.created_at, a.updated_at\n                     FROM agents.agents a\n                     JOIN agents.sources s ON s.id = a.source_id\n                    WHERE a.name = $1\n                    ORDER BY a.updated_at DESC\n                    LIMIT 1",
