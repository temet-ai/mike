  "query": "SELECT t.id, t.end_request_id\n                     FROM memory.operator_turns t\n                     JOIN sessions.sessions s ON s.id = t.session_id\n                    WHERE s.session_uuid = $1 AND t.closed_at IS NULL\n                    ORDER BY t.id DESC\n                    LIMIT 1",
