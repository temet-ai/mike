  "query": "SELECT\n             p.id AS project_id,\n             p.project_uuid,\n             p.project_path,\n             p.first_seen,\n             p.last_seen,\n             p.pinned,\n             p.ttl_override,\n             p.pin_created_at,\n             p.ttl_override_set_at,\n             p.custom_name\n         FROM projects.projects p\n         WHERE p.project_path <> '(no project)' AND p.merged_into_id IS NULL\n         ORDER BY p.last_seen DESC",
