{
  "db_name": "PostgreSQL",
  "query": "SELECT sp.request_id, sp.session_id, sp.created_at, sp.content_sha256,\n                          sp.altered, r.model,\n                          COUNT(*) OVER ()::bigint AS \"total_count!\"\n                   FROM system_prompts.session_prompts sp\n                   LEFT JOIN requests.requests r ON r.id = sp.request_id\n                   LEFT JOIN projects.projects p ON p.id = r.project_id\n                   WHERE sp.lane = $1\n                     AND sp.subagent_persona IS NOT DISTINCT FROM $2\n                     AND ($5::text IS NULL OR r.model = $5)\n                     AND ($6::text IS NULL OR p.project_path = $6)\n                   ORDER BY sp.created_at DESC\n                   LIMIT $3 OFFSET $4",
