  "query": "SELECT e.id, e.project_id, e.checkout, e.at, e.kind, e.session_id, e.run_id, e.task,\n       e.paths, e.subject, e.detail, e.before_sha, e.after_sha\n  FROM workspace.change_events e\n WHERE e.checkout = $1\n   AND (cardinality($2::text[]) = 0 OR e.kind = ANY($2))\n ORDER BY e.id DESC\n LIMIT $3\n",
