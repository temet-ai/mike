{
  "db_name": "PostgreSQL",
  "query": "SELECT s.session_uuid,\n       tu.tool_name,\n       tu.input\n  FROM sessions.sessions s\n  JOIN tools.uses tu ON tu.session_id = s.id\n WHERE s.session_uuid = ANY($1::uuid[])\n   AND tu.tool_name = ANY($2::text[])\n   AND tu.created_at >= $3\n ORDER BY tu.created_at DESC, tu.id DESC\n LIMIT $4\n",
