  "query": "INSERT INTO tools.definitions (definition_sha256, tool_name, body, byte_size)\n             SELECT u.sha, u.name, u.body, u.byte_size\n             FROM UNNEST($1::text[], $2::text[], $3::bytea[], $4::int[])\n                  AS u(sha, name, body, byte_size)\n             RETURNING id AS \"id!\", definition_sha256 AS \"definition_sha256!\"",
