  "query": "SELECT rm.ord, rm.message_id, m.message_sha256 AS \"message_sha256!\"\n           FROM requests.messages rm\n           JOIN messages.messages m ON m.id = rm.message_id\n          WHERE rm.request_id = $1\n          ORDER BY rm.ord ASC",
