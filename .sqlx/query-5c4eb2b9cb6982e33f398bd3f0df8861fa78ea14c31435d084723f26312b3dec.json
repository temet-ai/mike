  "query": "SELECT s.id,\n                  s.session_uuid,\n                  s.first_seen,\n                  s.last_seen,\n                  s.project_resolution,\n                  p.id AS project_id,\n                  p.project_path,\n                  COALESCE(p.custom_name, p.display_name) AS \"project_name!\"\n             FROM sessions.sessions s\n             JOIN projects.projects p ON p.id = s.project_id\n            WHERE s.session_uuid = $1",
