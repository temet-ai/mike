// Inside the server process, one picture per question a reader usually has.

views {

  global style plannedWork

  view server of mike.server {
    title 'Inside the mike server'
    description '''
      Every part of the server process and how the parts depend on each other. The
      database and the outside services are left out here; the views of each part
      show them.
    '''
    include *
    exclude
      mike.db,
      openrouter,
      claudeCli,
      codexCli,
      infinity,
      terminal,
      mike.cli,
      mike.assistant
    autoLayout TopBottom
  }

  view requestPath {
    title 'The path of a request'
    description '''
      What a request passes on its way to Anthropic and what its reply passes on
      the way back. Everything here is on the path the client waits on.
    '''
    include
      claudeCode,
      anthropic,
      mike.forward,
      mike.server.proxyBind,
      mike.server.engine,
      mike.server.pipeline,
      mike.server.capture,
      mike.server.response.*,
      mike.server.remoteControl,
      mike.server.state.*,
      mike.server.housekeeping.memoryCap,
      mike.db
    exclude mike.server.state.reminders
    autoLayout TopBottom
  }

  view pipeline of mike.server.pipeline {
    title 'The request pipeline'
    description '''
      The eighteen stages of STAGE_ORDER and the composer, in the order they run. Grey stages are off
      by default; the gate that switches each one on is in its details.
    '''
    include *
    style element.tag = #default-off {
      color muted
    }
    autoLayout TopBottom
  }

  view inspection {
    title 'From capture to the screen'
    description '''
      How a captured request reaches the web UI and other sessions: rows are read
      from Postgres, and a notification on every row change is pushed to each open
      browser over one WebSocket.
    '''
    include
      operator,
      claudeCode,
      mike.spa,
      mike.mcp,
      mike.assistant,
      mike.cli,
      mike.server.inspectBind,
      mike.server.spaBind,
      mike.server.embeddedSpa,
      mike.server.api.*,
      mike.server.dbListener,
      mike.server.state.events,
      mike.server.state.overlays,
      mike.server.state.requestStore,
      mike.server.capture,
      mike.db
    autoLayout TopBottom
  }

  view judging of mike.server.judging {
    title 'Judging'
    description '''
      How a closed turn gets its facts and its verdict, and where the numbers that
      say whether the judge can be trusted are kept. Grey parts are off by default;
      a red line sends captured content to a third-party model.
    '''
    include *
    include
      mike.server.state.events,
      mike.server.capture,
      mike.server.llm,
      openrouter,
      claudeCli,
      codexCli,
      mike.db.memory,
      mike.db.eval,
      mike.db.sessionJudges,
      mike.db.promptKinds,
      mike.db.llm
    exclude mike.db
    style element.tag = #default-off {
      color muted
    }
    autoLayout TopBottom
  }

  view lessons of mike.server.knowledge {
    title 'Lessons and recall'
    description '''
      Where a project\'s lessons come from, how they are kept current, and how they
      get back into a session\'s requests.
    '''
    include *
    include
      mike.server.response,
      mike.server.steering.quiescence,
      mike.server.llm,
      mike.server.embeddings,
      mike.server.pipeline.lessons,
      mike.server.pipeline.recallInjector,
      mike.server.pipeline.agentLessons,
      mike.server.state.overlays,
      openrouter,
      claudeCli,
      codexCli,
      infinity,
      mike.db.memory,
      mike.db.eval
    exclude mike.db
    style element.tag = #default-off {
      color muted
    }
    autoLayout TopBottom
  }

  view steering of mike.server.steering {
    title 'Steering'
    description '''
      What watches a session as it works, and the two ways a nudge reaches it: pushed
      into its open stream, or queued for its next request.
    '''
    include *
    include
      claudeCode,
      mike.server.state.events,
      mike.server.state.reminders,
      mike.server.pipeline.steererDrain,
      mike.server.remoteControl,
      mike.server.knowledge.lessonProposer,
      mike.server.llm,
      openrouter,
      claudeCli,
      codexCli,
      mike.db.steering,
      mike.db.eval,
      mike.db.memory
    exclude mike.db, anthropic
    style element.tag = #default-off {
      color muted
    }
    autoLayout TopBottom
  }

  view coordination {
    title 'Sessions working together'
    description '''
      How sessions find each other, send mail, and get launched: the roster, the
      mailbox, the three ways a message reaches a session, and the launcher a
      fleet is built on.
    '''
    include
      operator,
      claudeCode,
      terminal,
      mike.mcp,
      mike.cli,
      mike.server.inspectBind,
      mike.server.api.rest,
      mike.server.launch,
      mike.server.fleet,
      mike.server.remoteControl,
      mike.server.state.reminders,
      mike.server.pipeline,
      mike.server.coordination.*,
      mike.server.changeRecord.*,
      mike.db.mailbox,
      mike.db.workspace,
      mike.db.work,
      mike.db.launch,
      mike.db.remoteControl
    autoLayout TopBottom
  }

  view data {
    title 'What is stored'
    description '''
      One box per Postgres schema, grouped by what it holds. The views of each part
      of the server show who reads and writes which.
    '''
    group 'Captured traffic' {
      include
        mike.db.requests,
        mike.db.responses,
        mike.db.messages,
        mike.db.tools,
        mike.db.agents,
        mike.db.systemPrompts,
        mike.db.remoteControl
    }
    group 'Who it belongs to' {
      include
        mike.db.projects,
        mike.db.sessions
    }
    group 'What the operator authored' {
      include
        mike.db.rules,
        mike.db.overrides,
        mike.db.config
    }
    group 'What mike learned' {
      include
        mike.db.memory,
        mike.db.promptKinds,
        mike.db.sessionJudges,
        mike.db.eval,
        mike.db.steering,
        mike.db.llm
    }
    group 'Sessions working together' {
      include
        mike.db.mailbox,
        mike.db.workspace,
        mike.db.work,
        mike.db.launch
    }
    group 'Operations' {
      include mike.db.sync
    }
    autoLayout TopBottom
  }

  view captureWrites {
    title 'What one captured request writes'
    description 'The schemas the capture path writes to as a request arrives and its reply ends.'
    include
      mike.server.engine,
      mike.server.capture,
      mike.server.remoteControl,
      mike.server.capture -> mike.db.*,
      mike.server.engine -> mike.db.*,
      mike.server.remoteControl -> mike.db.*
    autoLayout TopBottom
  }

  view leavesTheMachine {
    title 'What leaves this machine'
    description '''
      Every connection that carries content off the machine, and who is behind
      it. Forwarding to Anthropic is what mike is for; everything that reaches
      OpenRouter is off until the operator switches it on.
    '''
    include * -> * where kind is egress
    include -> mike.server.llm
    include mike.server.embeddings, infinity
    include -> mike.server.embeddings
    style element.tag = #default-off {
      color muted
    }
    autoLayout LeftRight
  }
}
