// Step-by-step flows. Each one is a sequence of real interactions between elements of the
// model, so a renamed or removed element breaks the flow at validation, not in a review.

views {

  global style plannedWork

  dynamic view flowRequest {
    title 'One request, end to end'
    description '''
      A streamed request with nothing cutting the reply: accepted, passed through
      the stages, written as a pending row, forwarded, streamed back, and
      snapshotted when the reply ends.
    '''
    variant sequence

    claudeCode -> mike.server.proxyBind 'POST /v1/messages'
    mike.server.proxyBind -> mike.server.engine 'accept: keep the original bytes'
    mike.server.engine -> mike.server.pipeline 'run the stages in order'
    mike.server.engine <- mike.server.pipeline 'the body, changed or not'
    mike.server.engine -> mike.server.capture 'write the pending row' {
      notes '''
        Phase one of the two-phase write. The `INSERT ... RETURNING id` is where
        the request id comes from; every later event carries it.
      '''
    }
    mike.server.capture -> mike.db.requests 'INSERT pending row'
    mike.server.engine -> anthropic 'forward the request'
    mike.server.engine <- anthropic 'reply stream begins'
    mike.server.engine -> mike.server.response.tee 'hand over the stream'
    claudeCode <- mike.server.response.tee 'each chunk, as it arrives'
    mike.server.response.tee -> mike.server.response.parser 'a copy of each chunk'
    mike.server.response.parser -> mike.server.state.events 'text, tool calls, usage, completion'
    mike.server.state.events -> mike.server.capture 'update the live capture'
    mike.server.capture -> mike.db.requests 'snapshot when the reply ends' {
      notes '''
        Phase two. The same transaction stores the reply blocks and tool calls and
        opens, extends or closes the operator turn.
      '''
    }
  }

  dynamic view flowLiveUpdate {
    title 'A row change reaches the browser'
    description 'Why the web UI updates without polling: Postgres announces each changed row and the server pushes it to every open browser.'
    variant sequence

    mike.server.capture -> mike.db.requests 'writes a row'
    mike.db.requests -> mike.server.dbListener 'NOTIFY proxy.row_changed'
    mike.server.dbListener -> mike.server.state.events 'RowChanged: table, id, session'
    mike.server.state.events -> mike.server.api.ws 'broadcast'
    mike.server.api.ws -> mike.spa 'frame on the open WebSocket'
    mike.spa -> mike.server.spaBind 'refetch the changed row'
    mike.server.spaBind -> mike.server.api.rest 'GET /api/...'
    mike.server.api.rest -> mike.db.requests 'read'
    mike.spa <- mike.server.api.rest 'the row, in full'
  }

  dynamic view flowCut {
    title 'A reply is cut and continued'
    description '''
      What happens when the gated forwarder is armed and the model writes a listed
      phrase. The client sees one message: the start of the first answer, then the
      second. Both requests are captured.
    '''
    variant sequence

    claudeCode -> mike.server.engine 'request'
    mike.server.engine -> anthropic 'forward'
    mike.server.engine -> mike.server.response.gate 'hand over the reply stream'
    claudeCode <- mike.server.response.gate 'frames as they arrive, a few characters of text held back'
    mike.server.response.gate -> mike.server.response.parser 'a copy of every chunk'
    mike.server.response.gate -> mike.server.capture 'a listed phrase completed: record a second request' {
      notes '''
        No frame carrying any part of the phrase was sent. The forwarder closes the
        text block the client has open, and marks the first request as intercepted.
      '''
    }
    mike.server.response.gate -> anthropic 'original body + reply so far + correction prompt'
    mike.server.response.gate <- anthropic 'second answer'
    claudeCode <- mike.server.response.gate 'second answer, joined onto the same message'
    mike.server.response.gate -> mike.server.response.parser 'rest of the first answer, read to its end for capture'
  }

  dynamic view flowMail {
    title 'Mail from one session to another'
    description '''
      One session mails another through the MCP bridge. How the mail arrives
      depends on what the receiving session has open, and decides whether it will
      act on it.
    '''
    variant sequence

    claudeCode -> mike.mcp 'sender calls send_session_message'
    mike.mcp -> mike.server.inspectBind 'POST'
    mike.server.inspectBind -> mike.server.api.rest 'route'
    mike.server.api.rest -> mike.db.mailbox 'store the message'

    alt {
      when 'the receiver\'s mike-mcp is listening on its channel' {
        mike.mcp -> claudeCode 'channel notification' {
          notes 'Claude Code presents this as untrusted outside data. Good for information; a session will not act on instructions in it.'
        }
      }
      when 'the receiver has an open Remote Control stream' {
        mike.server.api.rest -> mike.server.remoteControl 'push'
        mike.server.remoteControl -> claudeCode 'a user turn in the open stream' {
          notes 'Claude Code presents this as a teammate\'s request, and the session acts on it within its own permissions.'
        }
        mike.server.remoteControl -> mike.db.remoteControl 'record the push and its acknowledgement'
      }
      else 'neither' {
        mike.server.api.rest -> mike.server.state.reminders 'queue for the next request'
        mike.server.pipeline.steererDrain -> mike.server.state.reminders 'claim it when the receiver next sends a request'
        mike.server.pipeline.steererDrain -> mike.db.mailbox 'mark it delivered' {
          notes 'The text rides on that one request only. Claude Code does not keep it in the session\'s history.'
        }
      }
    }
  }

  dynamic view flowLaunch {
    title 'Launching a session'
    description '''
      A session asks mike to start another. The call returns as soon as the ledger
      row exists; opening the terminal, joining the roster and linking the channel
      happen afterwards and are read from the ledger.
    '''
    variant sequence

    claudeCode -> mike.mcp 'spawn_session with name, role, instructions and goal'
    mike.mcp -> mike.server.inspectBind 'POST /api/launches'
    mike.server.inspectBind -> mike.server.api.rest 'route'
    mike.server.api.rest -> mike.server.launch 'launch'
    mike.server.launch -> mike.db.launch 'row: pending, with the full argv and brief'
    mike.mcp <- mike.server.api.rest 'launch id and session id, at once'
    mike.server.launch -> terminal 'open a surface, start claude with the session id'
    terminal -> claudeCode 'the new session starts'
    claudeCode -> mike.server.proxyBind 'its first request'
    mike.server.proxyBind -> mike.server.engine 'accept'
    mike.server.engine -> mike.db.workspace 'on the roster, with the identity given at launch'
    mike.server.coordination.channelLinkSweep -> mike.db.remoteControl 'link the session to its channel'
    opt 'a long brief, with launch_brief on' {
      mike.server.launch -> mike.server.remoteControl 'push the brief'
      mike.server.remoteControl -> claudeCode 'the brief, as a turn the session acts on'
    }
  }

  dynamic view flowImprovement {
    title 'From a correction to a lesson'
    description '''
      How the operator correcting a session once becomes something every later
      session in the project is told. Each model call here is off until switched on.
    '''
    variant sequence

    mike.server.capture -> mike.server.state.events 'an operator turn closed'
    mike.server.state.events -> mike.server.judging.dossierBuilder 'turn closed'
    mike.server.judging.dossierBuilder -> mike.db.memory 'the turn\'s facts, from captured data alone'
    mike.server.state.events -> mike.server.judging.turnJudge 'turn closed'
    mike.server.judging.turnJudge -> mike.server.llm 'how did the operator react?'
    mike.server.llm -> openrouter 'structured verdict call'
    mike.server.judging.turnJudge -> mike.db.memory 'verdict: corrected'
    mike.server.steering.quiescence -> mike.server.knowledge.lessonProposer 'tick'
    mike.server.knowledge.lessonProposer -> mike.db.memory 'corrected verdicts not yet examined'
    mike.server.knowledge.lessonProposer -> mike.server.llm 'is this correction a rule?'
    mike.server.knowledge.lessonProposer -> mike.server.embeddings 'does a lesson already say it?'
    mike.server.knowledge.lessonProposer -> mike.db.memory 'a candidate lesson and its evidence' {
      notes '''
        A candidate becomes active once enough corrections back it. Otherwise it
        waits for the operator to approve or reject it in the web UI.
      '''
    }
    mike.server.pipeline.lessons -> mike.server.state.overlays 'read the project\'s active lessons'
    mike.server.engine -> anthropic 'a later session\'s request carries the lesson'
    mike.server.judging.evalMetrics -> mike.db.eval 'corrected share before and after the lesson'
  }
}
