// Where each process runs on the development machine. scripts/systemd holds the unit
// templates and scripts/capture-db and scripts/test-db the two Docker definitions.

deployment {

  host omit 'omit' {
    technology 'Arch Linux'
    description 'The one machine everything runs on. Every listener binds to loopback.'

    supervisor systemd 'systemd user units' {
      description 'Restart on failure. Deploys hand a new binary to the unit; nothing is started by hand.'

      unit proxyUnit 'mike-stack-proxy' {
        description 'Runs the deployed mike binary. Ports 9988 and 9989.'
        instanceOf mike.server
      }

      unit forwardUnit 'mike-stack-forward' {
        description 'Port 9987.'
        instanceOf mike.forward
      }

      unit spaUnit 'mike-stack-spa' {
        description 'vite dev on port 9990, serving the web UI from source.'
        instanceOf mike.spa
      }

      unit assistantUnit 'mike-stack-assistant' {
        description 'Port 9985.'
        instanceOf mike.assistant
      }

      unit archUnit 'mike-stack-arch' {
        description 'Port 9986. Serves these diagrams from docs/architecture, redrawn on save. Not part of mike itself.'
      }

      unit storybookUnit 'mike-stack-storybook' {
        description 'Port 6006. Storybook dev server: the Foundations stories that are the style guide, and every component story. Not part of mike itself.'
      }
    }

    supervisor docker 'Docker' {

      unit capturePg 'armitage-pg' {
        technology 'PostgreSQL 19 + pgvector 0.8.7 (scripts/capture-db/Dockerfile.pg19)'
        description 'Port 5440. Data on the NVMe disk under ~/.local/share/mike-capture-db-19.'
        instanceOf mike.db
      }

      unit testPg 'mike-test-pg' {
        technology 'PostgreSQL 19 + pgvector 0.8.7 (scripts/capture-db/Dockerfile.pg19)'
        description 'Port 6667. A throwaway database for the test suite, with durability switched off. Never the capture data.'
      }
    }

    supervisor localClis 'Local command-line tools' {
      description 'Started on demand by the proxy as child processes. Each uses the login already on the machine.'

      unit claudeCliUnit 'claude' {
        description 'Claude Code in print mode, one process per worker call.'
        instanceOf claudeCli
      }

      unit codexCliUnit 'codex' {
        description 'Codex exec, one process per worker call.'
        instanceOf codexCli
      }
    }

    supervisor terminals 'Terminal panes' {
      technology 'herdr'
      description 'One pane per Claude Code session. Each session starts its own mike-mcp.'

      instanceOf claudeCode
      instanceOf mike.mcp
      instanceOf mike.cli
    }

    unit embedder 'Infinity' {
      description 'Port 7997. Shared with other projects on this machine.'
      instanceOf infinity
    }
  }

  host internet 'Internet' {
    instanceOf anthropic
    instanceOf openrouter
  }
}
