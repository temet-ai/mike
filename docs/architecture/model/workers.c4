// The background work the server does off the request path, grouped by what it is for.
// crates/mike/src/serve/workers.rs starts each one; docs/STARTUP_FLOW.md has the table of
// gates and defaults these tags and metadata are taken from.
//
// A worker tagged #sends-content-out sends captured session content to a third-party model
// when it is switched on, which is why every one of them defaults off.

model {

  extend mike.server {

    knowledge = component 'Lessons and recall' {
      description '''
        What mike remembers for a project: lessons the model or the operator
        recorded, and embeddings of past turns so similar ones can be found again.
      '''

      harvester = worker 'Lesson harvester' {
        #default-on
        description 'Reads memory-update tags out of a finished reply and stores each as a lesson. Local only.'
        metadata {
          gate 'harvester toggle'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/memory_harvester 'crates/mike/src/memory_harvester'
      }

      lessonWorker = worker 'Lesson consolidation' {
        #default-on
        description 'Promotes, merges and expires lessons as they age from raw to daily to long-term, and each night archives the lessons that confirmed relations replaced.'
        metadata {
          gate 'lesson_worker toggle'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/lesson_worker 'crates/mike/src/lesson_worker'
      }

      learningPromote = worker 'Skill promotion' {
        #default-on
        description '''
          Once an hour at half past, from 20:30 to 03:30 UTC, runs
          scripts/learning-promote from the checkout the proxy was started in, with a
          fifteen-minute limit, so accepted lessons become project memories and skills
          in the project checkouts on this machine. Each proxy promotes for its own
          machine; nothing is leased. Exit code 1 (a hand-edited generated file kept
          as a conflict) is an alarm, not a failure. Consecutive failures back off,
          and the result shows on GET /api/scheduled-jobs and the scheduled_jobs row
          of /api/capabilities. A proxy started in a directory with no scripts folder
          runs no scheduled job, takes no job lease and reports each job as
          unavailable. Every scheduled job records its finished runs in
          jobs.runs and restores its status, period slot and backoff from there on
          start; POST /api/scheduled-jobs/{name}/run (SPA only) asks the job\'s own
          worker to run it once. No LLM call.
        '''
        metadata {
          gate 'learning_promote.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      learningAudit = worker 'Weekly learning audit' {
        #default-on
        description '''
          Once on Monday, between 01:00 and 06:59 UTC, runs scripts/learning-audit
          --weekly --sync from the checkout the proxy was started in, with a
          thirty-minute limit, so the preceding week is audited and the report is
          published through project knowledge ingestion. Shares its scheduler with
          the skill promotion. One machine per database runs it, by a lease in
          llm.worker_leases. No LLM call.
        '''
        metadata {
          gate 'learning_audit.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      lessonProposer = worker 'Lesson proposer' {
        #default-off #sends-content-out
        description '''
          Takes turns the judge marked as corrected, asks a model whether the
          correction is a rule worth keeping, and for each stored lesson close to
          it decides whether to store, skip, update or merge, recording the
          decision as a lesson relation, and in the same call which home the
          lesson belongs in: rule, skill, agent definition, memory or nowhere.
          On the same tick it rewrites lessons that are too long or read as
          status reports into rules, places lessons written without a home,
          names the work each untopiced lesson concerns, merges skill topics
          with the same purpose, and drafts a skill from a topic\'s skill-placed
          lessons by the skill-creator method for the promoter to ship once it
          passes evaluation.
        '''
        metadata {
          gate 'judge_lessons toggle; runs on the quiescence tick'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/lesson_proposer 'crates/mike/src/lesson_proposer'
        link https://github.com/temet-ai/mike/blob/main/docs/IMPROVEMENT_LOOP.md 'docs/IMPROVEMENT_LOOP.md'
      }

      embedWorker = worker 'Turn embedding' {
        description 'Splits each closed turn into chunks and stores an embedding of each. Also closes turns left open by idle sessions. The project-knowledge embedding sweep runs on one machine per database, by a lease in llm.worker_leases.'
        metadata {
          gate 'embedding.enabled setting'
          default 'loop runs; embedding off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/embed_worker 'crates/mike/src/embed_worker'
      }

      knowledgeScan = worker 'Memory and skill indexing' {
        #default-on
        description '''
          Every two minutes, for each checkout registered on this machine, reads
          the Claude Code memory files kept for that project and the project\'s
          own skills, and records them as project knowledge so that search and
          the lesson proposer can find them. Reads local files only; nothing
          leaves the machine.
        '''
        metadata {
          gate 'none; runs wherever the proxy runs'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/knowledge_scan 'crates/mike/src/knowledge_scan'
        link https://github.com/temet-ai/mike/blob/main/docs/PROJECT_KNOWLEDGE.md 'docs/PROJECT_KNOWLEDGE.md'
      }

      semanticWorker = worker 'Semantic context' {
        #default-on
        description '''
          Builds the items that let a correction be matched to earlier ones like it,
          and watches for drift in the embedder. Refuses any embedder that is not on
          this machine unless the operator allows it.
        '''
        metadata {
          gate 'semantic_context toggle'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/semantic 'crates/mike/src/semantic'
      }
    }

    judging = component 'Judging' {
      description 'Decides, turn by turn and session by session, how the work went, and keeps the numbers that show whether that judgement can be trusted.'

      dossierBuilder = worker 'Turn facts' {
        #default-off
        description '''
          Works out the facts of each closed turn from captured data alone: who
          opened it, how it ended, what it checked, what the operator said next.
          No model is called.
        '''
        metadata {
          gate 'dossier_builder toggle'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/dossier 'crates/mike/src/dossier'
      }

      turnJudge = worker 'Turn judge' {
        #default-off #sends-content-out
        description 'Asks a model how the operator reacted to each turn: accepted, corrected, or something else.'
        metadata {
          gate 'judge_worker toggle'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/judge_worker 'crates/mike/src/judge_worker'
      }

      sessionJudge = worker 'Session judge' {
        #default-off #sends-content-out
        description 'Asks a model for one outcome and quality score per finished session.'
        metadata {
          gate 'session_judge toggle'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/judge_worker 'crates/mike/src/judge_worker'
      }

      evalMetrics = worker 'Rates and alarms' {
        #default-on
        description 'Rolls labels and verdicts up into daily rates and raises an alarm when one moves. SQL only.'
        metadata {
          gate 'eval.rollup.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/eval_metrics 'crates/mike/src/eval_metrics'
      }
    }

    steering = component 'Steering' {
      description 'Watches sessions as they work and, when switched on, tells one it has drifted, claimed too much, or is waiting on nothing.'

      steerers = worker 'Steerer fleet' {
        #default-off #sends-content-out
        description '''
          Each steerer runs a cheap check first and calls a model only if it passes.
          A verdict needs enough confidence and two of three samples to agree before
          a nudge is sent. Includes the refocus steerer, the verifier and the turn
          guard.
        '''
        metadata {
          gate 'steerer toggle; each steerer has its own'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/steerer 'crates/mike/src/steerer'
      }

      quiescence = worker 'Quiet-session watch' {
        #default-off
        description 'Notices a session that has gone quiet, wakes one that is due, and labels the guard\'s earlier answers from what the operator said next.'
        metadata {
          gate 'steerer toggle'
          default 'off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/quiescence_worker 'crates/mike/src/quiescence_worker'
      }

      crossSession = worker 'Calibration' {
        #default-on
        description '''
          Keeps the guard\'s thresholds, and the confidence thresholds of the
          verifier and monitor-over-sleep steerers, in step with how their past
          answers turned out across all sessions, counting each kind of label at
          the weight the operator sets, and records why a pass wrote nothing
          useful. Proposes a directive when the operator keeps repeating one
          instruction. SQL only.
        '''
        metadata {
          gate 'always runs; threshold changes and proposals have their own gates'
          default 'on; threshold changes and proposals off'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/cross_session 'crates/mike/src/cross_session'
      }
    }

    coordination = component 'Session coordination' {
      description 'Keeps the roster, the mail and the channel links between sessions true while sessions come and go.'

      mailboxReaper = worker 'Mail sweep' {
        #default-on
        description 'Clears mail that went stale before it was delivered.'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/mailbox_reaper.rs 'crates/mike/src/mailbox_reaper.rs'
      }

      workspaceReaper = worker 'Roster sweep' {
        #default-on
        description 'Removes a session from the roster when its lease runs out.'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/workspace_reaper.rs 'crates/mike/src/workspace_reaper.rs'
      }

      workRegistry = worker 'Work registry' {
        #default-on
        description 'Checks every minute which work items need attention, and mails the owner when set to deliver.'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/work_registry_worker.rs 'crates/mike/src/work_registry_worker.rs'
      }

      channelLinkSweep = worker 'Channel linking' {
        #default-on
        description 'Matches each session to its Remote Control channel from Claude Code session files on this machine, so a push can find it.'
        metadata {
          gate 'channel_link_sweep toggle'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/channel_link_sweep 'crates/mike/src/channel_link_sweep'
      }

      repushSweep = worker 'Push retry' {
        #default-on
        description 'Every ten seconds retries reminders still waiting for a session whose stream is open.'
      }

      retrospective = worker 'Fleet retrospective' {
        #sends-content-out
        description '''
          Runs with persistence outside smoke runs, polling completed fleets every
          twenty seconds. Jobs are only queued when retrospective.enabled is on.
          On the owning host, starts a separate Claude Code run through the session
          launcher, with findings-only tools unless bounded write authority is
          recorded. Launches have a retry budget and circuit breaker; the source
          checkout stays until the retrospective process is known to have exited.
          The completed fleet is not reopened.
        '''
        metadata {
          gate 'consumer: persistence present and not smoke; job creation: retrospective.enabled'
          default 'consumer on with persistence; job creation off'
          model 'haiku unless configured in the fleet definition'
        }
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/launch/fleet/retrospective_worker.rs 'crates/mike/src/launch/fleet/retrospective_worker.rs'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/launch/fleet/retrospective_launch.rs 'crates/mike/src/launch/fleet/retrospective_launch.rs'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/launch/fleet/retrospective.rs 'crates/mike/src/launch/fleet/retrospective.rs'
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/launch/fleet/display.rs 'crates/mike/src/launch/fleet/display.rs'
      }
    }

    changeRecord = component 'Change record' {
      #default-off
      description '''
        One record of what happened in each checkout a session works in: file changes with
        the session that made them and the content before, commits, pushes, checks,
        verdicts, notes, mail and briefs, each with its paths. Lets a session ask what
        changed since it last looked, where things stand and whose a file is, without git.
      '''
      metadata {
        gate 'change_record toggle; change_record_tail adds lines to answers'
        default 'off'
      }
      link https://github.com/temet-ai/mike/tree/main/crates/mike/src/change_record 'crates/mike/src/change_record'
      link https://github.com/temet-ai/mike/blob/main/docs/CHANGE_RECORD.md 'docs/CHANGE_RECORD.md'

      watcher = worker 'Checkout watcher' {
        #default-off
        description '''
          One per checkout a session has worked in lately. Turns file notifications, new
          commits and moved remote refs into events, and names the session that made each
          change a few seconds later. A slow git status comparison catches what
          notifications missed.
        '''
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/change_record/watch 'crates/mike/src/change_record/watch'
      }

      writers = component 'Event writers' {
        #default-off
        description '''
          Write an event, with the paths it concerns, after a note, a mail, a check or a
          gate verdict has been stored, never in its way.
        '''
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/change_record/writers 'crates/mike/src/change_record/writers'
      }

      answers = component 'Answers' {
        #default-off
        description '''
          What changed since a session last looked, where things stand, whose a file is
          and what the session itself has changed, and the few lines added to the answers
          of fleet_commit, fleet_check, write_session_note and send_session_message and to
          the start of a turn.
        '''
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/change_record/answers 'crates/mike/src/change_record/answers'
      }
    }

    housekeeping = component 'Housekeeping' {
      description 'Keeps the process inside its memory and the database inside its retention.'

      retention = worker 'Retention sweep' {
        #default-on
        description 'Deletes sessions older than their time-to-live, 365 days unless changed.'
        metadata {
          gate 'retention_sweep toggle'
          default 'on'
        }
        link https://github.com/temet-ai/mike/blob/main/crates/mike/src/retention_worker.rs 'crates/mike/src/retention_worker.rs'
      }

      cargoSweep = worker 'Build folder sweep' {
        #default-on
        description '''
          Every six hours runs scripts/cargo-sweep-all, which removes superseded
          Rust builds and idle build folders on this machine. Per machine, nothing
          is leased. Shares the scheduler of the skill promotion.
        '''
        metadata {
          gate 'cargo_sweep.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      compressorLoop = worker 'Compressor loop' {
        #default-on
        description '''
          Once a day, between 04:30 and 06:59 UTC, runs scripts/compressor-loop --apply,
          which scores the file-read compressor\'s forward and control arms and adjusts
          its settings through the inspect API. One machine per database runs it, by a
          lease in llm.worker_leases. Shares the scheduler of the skill promotion.
        '''
        metadata {
          gate 'compressor_loop.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      lessonsCommit = worker 'Lesson file commit' {
        #default-on
        description '''
          Once a day, between 01:30 and 03:59 UTC, runs scripts/lessons-commit from the
          checkout the proxy was started in, which commits the lesson files the
          knowledge collector wrote under .claude/lessons. Per machine, nothing is
          leased. Shares the scheduler of the skill promotion.
        '''
        metadata {
          gate 'lessons_commit.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      usageAudit = worker 'Weekly usage audit' {
        #default-on
        description '''
          Once on Sunday, between 06:00 and 10:59 UTC, runs scripts/usage-audit.sh,
          which writes the weekly usage report and exits 1 when an alarm trips; the
          scheduler records that as a finished run and shows the alarm lines. One
          machine per database runs it, by a lease in llm.worker_leases. Shares the
          scheduler of the skill promotion. No LLM call.
        '''
        metadata {
          gate 'usage_audit.enabled setting'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/scheduled_jobs 'crates/mike/src/scheduled_jobs'
      }

      resync = worker 'Fallback resync' {
        #default-on
        description 'Replays rows captured against the local fallback database into the main one once it is reachable.'
        metadata {
          gate 'db_resync toggle and both database URLs'
          default 'on'
        }
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/resync 'crates/mike/src/resync'
        link https://github.com/temet-ai/mike/blob/main/docs/LOCAL_DB_FALLBACK.md 'docs/LOCAL_DB_FALLBACK.md'
      }

      dbCost = worker 'Database cost check' {
        #default-on
        description '''
          Every five minutes reads mike\'s own pg_stat_statements counters, keeps the
          last hour of snapshots in memory and diffs them: statements whose mean time
          passes their tier budget (hot 5 ms, read 50 ms, periodic 500 ms, tier from
          the call rate), the costliest statements by DB-seconds per hour, and
          statements per proxied request. A breach turns /api/health and the db_cost
          row of /api/capabilities degraded; GET /api/db-cost holds the full report.
          Thresholds are the [db_cost] section of config.toml. Reports unavailable
          when the extension is not installed.
        '''
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/db_cost 'crates/mike/src/db_cost'
      }

      memoryCap = worker 'Memory cap' {
        #default-on
        description 'Watches the process\'s memory and, past the ceiling, drops live captures in priority order. Forwarding carries on uncaptured.'
        link https://github.com/temet-ai/mike/tree/main/crates/mike/src/memory_cap 'crates/mike/src/memory_cap'
      }
    }
  }

  // --- lessons and recall -----------------------------------------------------------------

  mike.server.response -> mike.server.knowledge.harvester 'hands the finished reply text to'
  mike.server.knowledge.harvester -[sql]-> mike.db.memory 'stores harvested lessons'
  mike.server.knowledge.lessonWorker -[sql]-> mike.db.memory 'promotes, merges and expires lessons'
  mike.server.knowledge.lessonWorker -> mike.server.embeddings 'embeds lessons'
  mike.server.knowledge.lessonProposer -[sql]-> mike.db.memory 'reads corrected verdicts, writes candidate lessons'
  mike.server.knowledge.lessonProposer -> mike.server.llm 'asks whether a correction is a rule'
  mike.server.knowledge.lessonProposer -> mike.server.embeddings 'checks for a lesson that already says it'
  mike.server.knowledge.embedWorker -[sql]-> mike.db.memory 'claims closed turns, stores their chunks'
  mike.server.knowledge.embedWorker -> mike.server.embeddings 'embeds a batch of chunks'
  mike.server.knowledge.semanticWorker -[sql]-> mike.db.memory 'stores semantic items and similarity floors'
  mike.server.knowledge.semanticWorker -[sql]-> mike.db.eval 'records embedding drift'
  mike.server.knowledge.semanticWorker -> mike.server.embeddings 'embeds, on this machine only by default'

  // --- judging ---------------------------------------------------------------------------------

  mike.server.state.events -[event]-> mike.server.judging.dossierBuilder 'a turn closed'
  mike.server.state.events -[event]-> mike.server.judging.turnJudge 'a turn closed'
  mike.server.judging.dossierBuilder -[sql]-> mike.db.memory 'turn facts and dossier entries'
  mike.server.judging.dossierBuilder -[sql]-> mike.db.promptKinds 'classifies prompts not yet classified'
  mike.server.judging.turnJudge -> mike.server.judging.dossierBuilder 'builds the facts for the turns it claims'
  mike.server.judging.turnJudge -> mike.server.llm 'asks for a verdict on the turn'
  mike.server.judging.turnJudge -[sql]-> mike.db.memory 'turn verdicts'
  mike.server.judging.turnJudge -[sql]-> mike.db.eval 'judge runs'
  mike.server.judging.sessionJudge -> mike.server.llm 'asks for a verdict on the session'
  mike.server.judging.sessionJudge -[sql]-> mike.db.sessionJudges 'session verdicts'
  mike.server.judging.evalMetrics -[sql]-> mike.db.eval 'daily rates and alarms'

  // --- steering --------------------------------------------------------------------------------

  mike.server.state.events -[event]-> mike.server.steering.steerers 'a reply finished, a turn closed'
  mike.server.steering.steerers -> mike.server.llm 'asks for a verdict after the cheap check passes'
  mike.server.steering.steerers -[sql]-> mike.db.steering 'evaluations and nudges sent'
  mike.server.steering.steerers -> mike.server.remoteControl 'pushes a nudge to a session with an open stream'
  mike.server.steering.steerers -> mike.server.state.reminders 'queues a nudge for the next request otherwise'
  mike.server.steering.quiescence -> mike.server.steering.steerers 'reports a session that went quiet'
  mike.server.steering.quiescence -> mike.server.knowledge.lessonProposer 'runs on each tick'
  mike.server.steering.quiescence -> mike.server.remoteControl 'pushes a wake that has come due'
  mike.server.steering.quiescence -[sql]-> mike.db.steering 'labels earlier guard answers'
  mike.server.steering.crossSession -[sql]-> mike.db.eval 'reads the newest calibration'
  mike.server.steering.crossSession -[sql]-> mike.db.steering 'thresholds in force, labelled fires, pass runs'
  mike.server.steering.crossSession -[sql]-> mike.db.memory 'directive proposals'

  // --- session coordination ------------------------------------------------------------------

  mike.server.coordination.mailboxReaper -[sql]-> mike.db.mailbox 'clears stale mail'
  mike.server.coordination.workspaceReaper -[sql]-> mike.db.workspace 'expires lapsed registrations'
  mike.server.coordination.workRegistry -[sql]-> mike.db.work 'reconciles work items'
  mike.server.coordination.workRegistry -[sql]-> mike.db.mailbox 'mails the owner of an item needing attention'
  mike.server.coordination.channelLinkSweep -[sql]-> mike.db.remoteControl 'links sessions to channels'
  mike.server.coordination.repushSweep -> mike.server.state.reminders 'takes reminders still waiting'
  mike.server.coordination.repushSweep -> mike.server.remoteControl 'pushes them again'
  mike.server.coordination.retrospective -[sql]-> mike.db.launch 'claims saved jobs, records independent runs and observes launches'
  mike.server.coordination.retrospective -> mike.server.launch 'starts an opted-in retrospective in its own session'

  // --- change record ---------------------------------------------------------------------------

  mike.server.changeRecord.watcher -[sql]-> mike.db.workspace 'records file changes, commits and pushes, and names who made them'
  mike.server.changeRecord.writers -[sql]-> mike.db.workspace 'records notes, mail, checks and briefs with their paths'
  mike.server.api.rest -> mike.server.changeRecord.writers 'a stored note or mail is handed over afterwards'
  mike.server.fleet -> mike.server.changeRecord.writers 'a finished check or gate verdict is handed over'
  mike.server.fleet -> mike.server.changeRecord.watcher 'takes the fleet\'s tree changes from it when on'
  mike.server.api.rest -> mike.server.changeRecord.answers 'serves what_changed'
  mike.server.fleet -> mike.server.changeRecord.answers 'adds the lines to fleet_commit and fleet_check'
  mike.server.changeRecord.answers -[sql]-> mike.db.workspace 'reads the record and moves a session\'s place'

  // --- housekeeping ----------------------------------------------------------------------------

  mike.server.housekeeping.retention -[sql]-> mike.db.sessions 'deletes expired sessions'
  mike.server.housekeeping.retention -[sql]-> mike.db.mailbox 'deletes orphaned mail'
  mike.server.housekeeping.resync -[sql]-> mike.db.sync 'tracks what has been replayed'
  mike.server.housekeeping.resync -[sql]-> mike.db 'replays rows from the fallback database'
  mike.server.housekeeping.dbCost -[sql]-> mike.db 'reads its own pg_stat_statements counters'
  mike.server.housekeeping.dbCost -[sql]-> mike.db.requests 'counts proxied requests in the window'
  mike.server.housekeeping.memoryCap -> mike.server.state.requestStore 'drops live captures when memory is short'
  mike.server.engine -> mike.server.housekeeping.memoryCap 'asks whether this request may be captured'
}
