// The capture database, one element per Postgres schema. docs/SCHEMA.md is the reference
// for tables and columns; this file says what each schema is for and, through the
// relationships in the other files, which part of mike reads or writes it.
//
// All SQL lives in crates/mike/src/store/persistence. Migrations are in its migrations/
// folder and only `mike serve` applies them.

model {

  extend mike.db {

    // --- captured traffic -----------------------------------------------------------------

    requests = schema 'requests' {
      description '''
        One row per captured request, written before the request is forwarded and
        completed when the reply ends. Also the per-request diagnostics, deltas, sent
        patches and a record of every reply mike cut and continued.
      '''
    }

    responses = schema 'responses' {
      description 'Reply metadata and the reply content, one row per text, thinking or tool-use block.'
    }

    messages = schema 'messages' {
      description '''
        Each distinct conversation message stored once, keyed by its hash, so a
        conversation tail repeated in every request is not stored again each time.
      '''
    }

    tools = schema 'tools' {
      description 'Tool definitions, every tool call and every tool result, matched by a foreign key.'
    }

    agents = schema 'agents' {
      description 'The registry of named agents, every Agent-tool dispatch, and each running agent instance.'
    }

    systemPrompts = schema 'system_prompts' {
      description 'Each distinct system prompt stored once by its hash, and which session used which.'
    }

    remoteControl = schema 'remote_control' {
      description '''
        Captured Remote Control channel calls, the user turns mike pushed into a
        session over that channel, and the acknowledgements that came back.
      '''
    }

    // --- who the traffic belongs to ---------------------------------------------------------

    projects = schema 'projects' {
      description 'One row per working directory. Deleting a project removes its sessions.'
    }

    sessions = schema 'sessions' {
      description 'One row per Mike session identity, preserving existing Claude UUIDs, with its goal and its time-to-live.'
    }

    runtime = schema 'runtime' {
      description '''
        Durable provider namespaces and thread bindings to Mike sessions, with separate
        native-parent and fork ancestry. Original runtime event bytes and versioned
        source metadata stay separate from captured model requests. Trusted Codex receipt
        context and generation-isolated projections retain replay provenance and item state.
      '''
      link https://github.com/temet-ai/mike/blob/main/crates/mike/src/store/persistence/migrations/20261013130000_runtime_identity_events.sql 'crates/mike/src/store/persistence/migrations/20261013130000_runtime_identity_events.sql'
      link https://github.com/temet-ai/mike/blob/main/crates/mike/src/store/persistence/runtime/codex/mod.rs 'crates/mike/src/store/persistence/runtime/codex/mod.rs'
    }

    // --- what the operator authored ---------------------------------------------------------

    rules = schema 'rules' {
      description '''
        Filter rules, lazy sections and injected reminders, authored at runtime.
        There is no file copy: this table is the only place a rule lives.
      '''
    }

    overrides = schema 'overrides' {
      description 'Prompt compositions: operator-authored replacements for the main system prompt, with their history.'
    }

    config = schema 'config' {
      description 'Everything on the settings page: feature toggles and tunable settings. The runtime source of truth.'
    }

    // --- what mike learned ---------------------------------------------------------------------

    memory = schema 'memory' {
      description '''
        Operator turns and their embedded chunks, lessons, turn verdicts, turn facts,
        dossier entries, directive proposals, skill drafts authored from a topic\'s lessons,
        harvest runs counting the memory update tags found in replies, and the semantic
        items built from them.
      '''
    }

    promptKinds = schema 'prompt_kinds' {
      description 'The classification of each turn\'s opening prompt: a real operator message, a machine event, or a probe.'
    }

    sessionJudges = schema 'session_judges' {
      description 'Per-session outcome and quality verdicts from the session judge.'
    }

    eval = schema 'eval' {
      description '''
        Labels, judge runs, daily rate rollups, alarms and embedding drift: the
        evidence for whether a judge, a lesson or a nudge is doing any good.
      '''
    }

    steering = schema 'steering' {
      description 'Steerer definitions, which sessions each one watches, every evaluation and every nudge sent.'
    }

    llm = schema 'llm' {
      description 'Every call mike made to a model on its own account, with its cost, the machine that made it, and the daily spend. Also the lease that gives each model-calling worker role to one machine per database.'
    }

    // --- sessions working together ------------------------------------------------------------

    mailbox = schema 'mailbox' {
      description 'Messages between sessions, their threads, and whether each was delivered, claimed and read.'
    }

    workspace = schema 'workspace' {
      description '''
        The roster of sessions registered on a project, their liveness leases, the
        coordination ledger and each session\'s notebook.
      '''
    }

    work = schema 'work' {
      description 'Work threads: what a session is working on, its acceptance criteria, its log and its state.'
    }

    launch = schema 'launch' {
      description '''
        One row per attempt to launch a session, with its full argv and brief, plus
        warm templates, runs, fleets and terminal-backend checks.
      '''
    }

    // --- operations ----------------------------------------------------------------------------

    sync = schema 'sync' {
      description 'Bookkeeping for replaying rows captured against the local fallback database into this one.'
    }

    jobs = schema 'jobs' {
      description '''
        One row per finished run of a scheduled job (scripts the proxy runs on a
        cadence), with its trigger, result, output tail and backoff state, so a
        restart keeps each job\'s history, slot and backoff.
      '''
      link https://github.com/temet-ai/mike/blob/main/crates/mike/src/store/persistence/migrations/20261031120000_scheduled_job_runs.sql 'crates/mike/src/store/persistence/migrations/20261031120000_scheduled_job_runs.sql'
      link https://github.com/temet-ai/mike/blob/main/crates/mike/src/store/persistence/scheduled_job_runs.rs 'crates/mike/src/store/persistence/scheduled_job_runs.rs'
    }
  }
}
